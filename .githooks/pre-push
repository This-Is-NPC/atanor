#!/usr/bin/env bash
# Push gate, installed by `mise run hooks:install`: only the fast checks
# (warnings as errors and formatting, scripts/check-fast). The full gate runs in
# CI on the pull request. Tags and deletions carry no new tree and pass. Bypass:
# `git push --no-verify`.
set -uo pipefail

root="$(git rev-parse --show-toplevel)" || exit 1
cd "$root" || exit 1

zero="0000000000000000000000000000000000000000"
while read -r _local_ref local_sha remote_ref _remote_sha; do
  [ "$local_sha" = "$zero" ] && continue
  case "$remote_ref" in refs/tags/*) continue ;; esac
  # Any pushed branch gets one run, on the working tree.
  exec scripts/check-fast </dev/null
done
