#!/usr/bin/env python3
"""Replace the one node of the container cluster by another under continuous load and print what it cost.

  cluster-swap-run [--trigger sigterm|api] [--b node-N] [--rooms N] [--workers W] [--rate RPS] [--warmup S]
                   [--overlap S] [--settle S] [--timeout S] [--drain-wait S] [--keep-a] [--out DIR]

The cluster must be up with ONE node, and the scoreboard deployed:

  ATANOR_CLUSTER_NODES=1 mise run cluster:up && mise run cluster:deploy-example

A is that node. The runner starts the load (scripts/scoreboard-check write over --rooms rooms, --workers
concurrent requests, at most --rate requests per second; --workers is limited to 12), waits --warmup
seconds, starts B (the service --b, default the next free node-N) in the discovery group "b"
(ATANOR_CLUSTER_GROUP=b) so that A and B form no cluster, though they share the store and its cells, waits until B serves, lets both serve for --overlap seconds, drains A, waits until
A has exited, keeps the load for --settle more seconds, stops it by PID and runs `scoreboard-check verify`.

The trigger:
  sigterm   `docker stop` of A with the container's grace period (ATANOR_CLUSTER_STOP_GRACE, default 90 s)
  api       POST /drain on A's admin port (from inside A's container), which waits for the answer

--drain-wait is how long to wait for A to exit after the trigger (default 120 s). Unless --keep-a, A's
container is removed at the end (by id). Results go to --out (default /tmp/atanor-swap-TRIGGER-TIME) and,
as one JSON line, to stdout last. Exit status is 1 when an acknowledged write was lost or duplicated, a
refused write was stored, any answer was not a 503 with Retry-After (or a refused connection), or A did
not exit with status 0. A B that exits or turns unhealthy before it serves ends the run at once with B's exit
status (1 when it was 0) and its last log lines on stderr.
"""
import argparse
import atexit
import json
import os
import re
import signal
import subprocess
import sys
import time
import urllib.request

HERE = os.path.dirname(os.path.abspath(__file__))
ROOT = os.path.dirname(HERE)
LABEL = "label=com.docker.compose.project=atanor-cluster"
children = []


def say(message):
    print(f"[{time.time() - started:7.1f}s] {message}", flush=True)


def run(*command, **kwargs):
    done = subprocess.run(command, text=True, capture_output=True, **kwargs)
    if done.returncode:
        tail = "\n".join(done.stdout.splitlines()[-20:] + done.stderr.splitlines()[-20:])
        raise SystemExit(f"{' '.join(command)} exited {done.returncode}:\n{tail}")
    return done.stdout


COMPOSE = ["docker", "compose", "-p", "atanor-cluster", "-f", os.path.join(ROOT, "cluster", "compose.yml")]
if os.environ.get("ATANOR_CLUSTER_TMPFS") == "1":
    COMPOSE += ["-f", os.path.join(ROOT, "cluster", "compose.tmpfs.yml")]


def node_ids():
    return run("docker", "ps", "-aq", "--filter", LABEL, "--filter", "name=^/?atanor-cluster-node-[0-9]+$").split()


def inspect(container, template):
    return run("docker", "inspect", "-f", template, container).strip()


def published(port):
    return run(*COMPOSE, "port", "lb", str(port)).strip()


def token():
    return open(f"{ROOT}/cluster/secrets/admin_token").read().strip()


def exec_admin(container, method, path):
    """The admin API of one node, from inside its container (the node ports are not published)."""
    out = run("docker", "exec", container, "sh", "-c",
              f'curl -s -m 200 -X {method} -H "authorization: Bearer $(cat /run/secrets/admin_token)" http://127.0.0.1:4001{path}')
    return json.loads(out)


def balancer_up():
    with urllib.request.urlopen(f"http://{published(8404)}/stats;csv", timeout=5) as response:
        lines = response.read().decode().splitlines()
    return sum(1 for l in lines if l.startswith("atanor_http,node") and l.split(",")[17] == "UP")


def wait_for(what, check, timeout):
    deadline = time.time() + timeout
    while time.time() < deadline:
        try:
            if check():
                return
        except Exception:
            pass
        time.sleep(0.2)
    raise SystemExit(f"timeout waiting for {what}")


def logs_tail(container, lines=20):
    done = subprocess.run(["docker", "logs", "--tail", str(lines), container], text=True, capture_output=True)
    return (done.stdout + done.stderr).strip()


def wait_for_b(b, name, timeout):
    """Wait until B is healthy and in rotation. A B that exited or is unhealthy ends the run at once, with its exit code and last log lines."""
    deadline = time.time() + timeout
    while time.time() < deadline:
        status, code, health = (inspect(b, "{{.State.Status}} {{.State.ExitCode}} {{if .State.Health}}{{.State.Health.Status}}{{end}}").split() + [""])[:3]
        if status in ("exited", "dead") or health == "unhealthy":
            print(f"{name} is {'unhealthy' if status not in ('exited', 'dead') else f'{status} with status {code}'}; last log lines:\n{logs_tail(b)}", file=sys.stderr)
            sys.exit(int(code) or 1)
        try:
            if health == "healthy" and balancer_up() == 2:
                return
        except Exception:
            pass
        time.sleep(0.2)
    raise SystemExit("timeout waiting for B ready and in rotation")


def lb_servers(path):
    """{request id: (server, termination state)} from the balancer's request log (`option httplog`). A request
    that got no answer has no `x-atanor-server`, so this is how a timeout is tied to a node."""
    found = {}
    pattern = re.compile(r"atanor_http/(\S+) \S+ \d+ \S+ \S+ \S+ (\w{4}) .*[?&]id=([^& \"]+)")
    for line in open(path, errors="replace"):
        match = pattern.search(line)
        if match:
            found[match.group(3)] = (match.group(1), match.group(2))
    return found


def spawn(command, log):
    process = subprocess.Popen(command, stdout=open(log, "w"), stderr=subprocess.STDOUT)
    children.append(process)
    return process


def stop_children():
    for process in children:
        if process.poll() is None:
            process.terminate()
    for process in children:
        try:
            process.wait(30)
        except subprocess.TimeoutExpired:
            process.kill()


def main():
    global started
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("--trigger", choices=["sigterm", "api"], default="sigterm")
    parser.add_argument("--b", help="the service of B (default: the lowest node-N that is not A)")
    parser.add_argument("--rooms", type=int, default=12)
    parser.add_argument("--workers", type=int, default=8, help="concurrent requests of the load generator (at most 12)")
    parser.add_argument("--rate", type=float, default=60, help="requests per second in total")
    parser.add_argument("--warmup", type=float, default=25, help="seconds of load with A alone before B starts")
    parser.add_argument("--overlap", type=float, default=5, help="seconds A and B both serve before the drain")
    parser.add_argument("--settle", type=float, default=30, help="seconds of load after A has exited")
    parser.add_argument("--timeout", type=float, default=10, help="client timeout of a request")
    parser.add_argument("--drain-wait", type=float, default=120, help="seconds to wait for A to exit after the trigger")
    parser.add_argument("--keep-a", action="store_true", help="do not remove A's container at the end")
    parser.add_argument("--out")
    args = parser.parse_args()
    if not 1 <= args.workers <= 12:
        parser.error("--workers must be 1 to 12")
    out = args.out or time.strftime(f"/tmp/atanor-swap-{args.trigger}-%H%M%S")
    os.makedirs(out, exist_ok=True)
    started = time.time()
    atexit.register(stop_children)
    signal.signal(signal.SIGTERM, lambda *_: sys.exit(143))

    ids = node_ids()
    if len(ids) != 1 or inspect(ids[0], "{{.State.Running}}") != "true":
        raise SystemExit("start the cluster with one node: ATANOR_CLUSTER_NODES=1 mise run cluster:up")
    a = ids[0]
    a_name = inspect(a, "{{.Name}}").lstrip("/")
    if "ATANOR_GROUP=" not in inspect(a, "{{range .Config.Env}}{{println .}}{{end}}").splitlines():
        raise SystemExit(f"{a_name} is in a discovery group: start the cluster without ATANOR_CLUSTER_GROUP")
    b_service = args.b or next(f"node-{n}" for n in range(1, 11) if f"atanor-cluster-node-{n}" != a_name)
    grace = int(float(inspect(a, "{{.Config.StopTimeout}}") or 10))

    url = "http://scoreboard.localhost:" + published(4000).split(":")[1]
    rooms = [f"s{int(started) % 100000}-{i}" for i in range(args.rooms)]
    log = f"{out}/load.log"
    open(log, "w").close()
    t0 = time.time()
    say(f"A is {a_name} ({a[:12]}), B will be {b_service}; load: {len(rooms)} rooms, {args.workers} workers, {args.rate}/s; logs in {out}")
    spawn([os.path.join(HERE, "scoreboard-check"), "write", "--url", url, "--rooms", ",".join(rooms), "--duration", "1800",
           "--workers", str(args.workers), "--rate", str(args.rate), "--timeout", str(args.timeout), "--log", log], f"{out}/write.out")
    time.sleep(args.warmup)

    events = {}
    say(f"starting {b_service} in another discovery group")
    events["b_start_at"] = time.time()
    env = {**os.environ, "ATANOR_CLUSTER_GROUP": "b"}
    run(*COMPOSE, "up", "-d", "--no-deps", b_service, env=env)
    b = run("docker", "ps", "-aq", "--filter", LABEL, "--filter", f"name=^/?atanor-cluster-{b_service}$").split()[0]
    if "ATANOR_GROUP=b" not in inspect(b, "{{range .Config.Env}}{{println .}}{{end}}").splitlines():
        raise SystemExit(f"{b_service} is not in group b: it would form a cluster with A")
    wait_for_b(b, b_service, 180)
    events["b_serving_at"] = time.time()
    say(f"B ({b[:12]}) is in rotation {events['b_serving_at'] - events['b_start_at']:.1f}s after the start; "
        f"nodes seen by A: {len(exec_admin(a, 'GET', '/health')['nodes'])}, by B: {len(exec_admin(b, 'GET', '/health')['nodes'])}")
    time.sleep(args.overlap)

    drain = None
    events["drain_at"] = time.time()
    say(f"draining A by {args.trigger}")
    if args.trigger == "sigterm":
        subprocess.run(["docker", "stop", "--timeout", str(grace), a], check=True, capture_output=True)
    else:
        drain = exec_admin(a, "POST", "/drain")
        say(f"POST /drain answered: {json.dumps(drain)}")
    wait_for("A to exit", lambda: inspect(a, "{{.State.Running}}") == "false", args.drain_wait)
    events["a_exit_at"] = time.time()
    exit_code = int(inspect(a, "{{.State.ExitCode}}"))
    say(f"A exited with status {exit_code} {events['a_exit_at'] - events['drain_at']:.1f}s after the drain began")
    time.sleep(args.settle)
    events["end_at"] = time.time()
    stop_children()
    say("load stopped")
    for name, container in (("a", a), ("b", b)):
        with open(f"{out}/docker-{name}.log", "w") as file:
            subprocess.run(["docker", "logs", "--since", str(int(started)), container], stdout=file, stderr=subprocess.STDOUT)
    lb = run(*COMPOSE, "ps", "-q", "lb").strip()
    with open(f"{out}/docker-lb.log", "w") as file:
        subprocess.run(["docker", "logs", "--since", str(int(started)), lb], stdout=file, stderr=subprocess.STDOUT)
    if not args.keep_a:
        run("docker", "rm", "-f", a)

    d, x, e = events["drain_at"], events["a_exit_at"], events["end_at"]
    command = [os.path.join(HERE, "scoreboard-check"), "verify", "--url", url, "--log", log, "--json", f"{out}/result.json",
               "--phase", f"before={t0 + 12}:{events['b_start_at']}", "--phase", f"overlap={events['b_start_at']}:{d}",
               "--phase", f"swap={d}:{x}", "--phase", f"after={x + 5}:{e}"]
    say("verifying")
    check = subprocess.run(command, text=True, capture_output=True)
    print(check.stdout, end="")
    print(check.stderr, end="", file=sys.stderr)
    result = json.load(open(f"{out}/result.json"))
    entries = [json.loads(line) for line in open(log) if line.strip()]
    errors = {}
    for entry in entries:
        if entry["kind"] != "acked":
            key = f"{entry['status']} {entry['reason']}" + ("" if entry["status"] != 503 or entry.get("retry_after") else " without Retry-After")
            errors[key] = errors.get(key, 0) + 1
    ends = [x_["t"] + x_["ms"] / 1000 for x_ in entries if x_["status"] == 503]
    other = {k: n for k, n in errors.items() if not (k.startswith("503 ") and "without" not in k) and k != "0 connection_refused"}
    served = lb_servers(f"{out}/docker-lb.log")
    silent = [{"id": x_["id"], "room": x_["room"], "at_s": round(x_["t"] - events["drain_at"], 1),
               "server": served.get(x_["id"], ("", ""))[0], "balancer_state": served.get(x_["id"], ("", ""))[1]}
              for x_ in entries if x_["status"] == 0 and x_["kind"] == "unknown"]
    by_server = {}
    for item in silent:
        by_server[item["server"] or "none"] = by_server.get(item["server"] or "none", 0) + 1
    if silent:
        print(f"no answer by balancer server (the log in docker-lb.log): {by_server}; rooms {sorted({i['room'] for i in silent})}")
    result.update(no_answer_by_server=by_server, no_answer_requests=silent, trigger=args.trigger, a=a_name, b=b_service, a_exit_code=exit_code, drain_response=drain, errors=errors,
                  last_503_s=round(max(ends) - d, 1) if ends else None, a_exit_s=round(x - d, 1),
                  b_rotation_s=round(events["b_serving_at"] - events["b_start_at"], 1), workers=args.workers, rate=args.rate,
                  epoch=events, out=out)
    json.dump(result, open(f"{out}/result.json", "w"), indent=1)
    summary = {k: result[k] for k in ("trigger", "sent", "acked", "refused", "unknown", "lost", "duplicated", "unknown_stored",
                                      "refused_stored", "errors", "a_exit_code", "a_exit_s", "last_503_s", "phases", "drain_response")}
    print(json.dumps(summary))
    if other:
        print(f"FAIL: answers other than 503 with Retry-After: {other}", file=sys.stderr)
    sys.exit(1 if check.returncode or other or exit_code != 0 else 0)


started = time.time()
if __name__ == "__main__":
    main()
