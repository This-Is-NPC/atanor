#!/usr/bin/env python3
"""Run one load measure as a ramp of steps against the lab of its scenario. Called by `mise run load` (scripts/load); every setting comes
from the round config.

  load-run MEASURE --config FILE [--scenario S] [--skip-done | --no-skip-done] [--deadline EPOCH]

MEASURE is one of
  http-native  requests per second to the native worker, reads and writes in cells      (stop: p99, 5xx, refused, errors)
  http-wasm    the same to the plain WASM worker, the twin of the native one (examples/load-plain)  (stop: p99, 5xx, refused, errors)
  http-wasm-jobs  the same to the scoreboard, a WASM app that runs a ranking job per write   (stop: p99, 5xx, refused, errors)
  ws           open idle WebSocket connections with sparse messages                      (stop: memory, fds, refused)
  cells        cells kept hot at the same time                                           (stop: memory, p99, refused)
  swap         replace the node by another under load at the last approved http-wasm-jobs rate (stop: loss, duplication, errors)
  scale        the http-native and the cells ramps on 1, 2 and 3 nodes behind the load balancer (the ceiling of each, the gain over 1 node,
               the requests and awake cells per node), then a join: the 2nd and 3rd node start under a fixed rate and the time until the
               load spreads is measured (every ramp rule above applies; docs/how-to-run-the-load-tests.md)

A step runs the generator (scripts/load-gen, one process per ~600 req/s) for the plan's duration_s, samples the node's cgroup, the host and
the store every generator.sample_s seconds, and writes one JSON file, atomically. Before every step the harness waits for a quiet host
(judging.host_load). Order of the verdicts of a step (the rules are the [judging] keys of the config, with the measure's overrides): host load
too high, or its busy cores over judging.host_busy (INVALID, the round stops), a criterion broken (the step fails), swap in a measured
container or generator or host swap growing over its limit (INVALID), the store's tmpfs (or disk) over judging.store_fill (INVALID: a full
store answers S3 500s, which measure the lab; it wins over a criterion), a stall (generator lag, node CPU throttling, or on a failing step slow
node-to-store requests in the node log: INVALID, `stall:`; the step is repeated judging.stall_repeats times, and when the repeat stalls too the round
stops, except a store that stalls in both attempts: the step then fails, `store:`, with the criteria that made it fail), delivery under
judging.delivery (INVALID, the round stops: the generator or the host, not the node). A node that stopped is judged first and still records
the store's tmpfs share. The host swap used is only recorded. A container that may swap refuses the run before the first step.
After the first failing step the ramp refines between the last good value and the failing one (`refine` bisections, each on a fresh node and
store), then repeats the best good step once to confirm it, also fresh.

Exit status: 1 when a step ended INVALID (the lab, not the node: there is no verdict) and, for swap, which is a single
check and not a ramp, also when it failed; 0 when the measure recorded a verdict, a failed step or a stopped node included.
"""
import argparse
import copy
import http.client
import json
import math
import os
import re
import statistics
import subprocess
import sys
import threading
import time
import urllib.request

HERE = os.path.dirname(os.path.abspath(__file__))
ROOT = os.path.dirname(HERE)
sys.path.insert(0, HERE)
sys.dont_write_bytecode = True  # no scripts/__pycache__
import load_config  # noqa: E402  (the tables, the plans and the layout of the round config live there)
from load_config import RAMPS, SCALE_LOADS, UNITS, steps_of  # noqa: E402,F401

SCHEMA = "atanor-load-step-1"
BUCKET = 10
SIDE_TIMEOUT_S = 30  # a side measurement of a node at its limits may hang
CLK = os.sysconf("SC_CLK_TCK")
CORES = os.cpu_count()
OK_STATUSES = {"200", "201", "message answered", "503 retry-after", "reconnected"}
LOG_CAP_BYTES = 5 * 1048576
TICK_S, STALL_S = 0.1, 1.0  # the stall ticker: its period and the overshoot that is recorded


DEFAULT_HTTP_MAX_CONNECTIONS = 16_384  # the node's http.max_connections when node.http_max_connections is 0 (lib/atanor/config.ex)


def http_max_connections():
    """The cap on HTTP connections the nodes of the lab were configured with (main sets it from the config, for the lab's scripts too)."""
    return int(os.environ.get("ATANOR_LOAD_HTTP_MAX_CONNECTIONS") or DEFAULT_HTTP_MAX_CONNECTIONS)


def say(message):
    print(f"[{time.strftime('%H:%M:%S')}] {message}", flush=True)


def write_json(path, document):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    temporary = f"{path}.tmp"
    with open(temporary, "w") as file:
        json.dump(document, file, indent=1)
    os.replace(temporary, path)


# ---- the layout of the results of a config round: OUT/SCENARIO/MEASURE[/VARIANT]/step-VALUE[-REPETITION].json ----

class RoundStop(Exception):
    """round.timeout_s passed: the round stops, and what is done stays for --skip-done."""


def check_deadline(args):
    deadline = getattr(args, "deadline", None)
    if deadline and time.time() > deadline:
        raise RoundStop("round.timeout_s passed")


def number_text(value):
    return str(int(value)) if float(value).is_integer() else str(value)


def result_file(args, scenario, measure, name):
    """Where a measure keeps its `summary` or `baseline`: OUT/SCENARIO/MEASURE/NAME.json."""
    return os.path.join(args.out, scenario, measure, f"{name}.json")


def reuse(args, path):
    """The record of the step file at `path` when the step is done and need not run again (--skip-done): same `config_hash` and not INVALID.
    None when there is none or it must run again; a file of another config stops the round (the orchestrator checks that before any container)."""
    if not (getattr(args, "skip_done", False) and os.path.exists(path)):
        return None
    try:
        with open(path) as file:
            old = json.load(file)
    except (OSError, ValueError):
        return None
    if old.get("config_hash") != args.config_hash:
        sys.exit(f"{path} was made by another config (config_hash differs): use another output.dir, or --no-skip-done to run it again and overwrite it")
    return None if old.get("status") == "invalid" or old.get("valid") is False else old


# ---- reading the machine -------------------------------------------------------------------------------

def read(path):
    with open(path) as file:
        return file.read()


def cgroup_dir(pid):
    for line in read(f"/proc/{pid}/cgroup").splitlines():
        if line.startswith("0::"):
            return "/sys/fs/cgroup" + line[3:]
    raise RuntimeError(f"no cgroup v2 for pid {pid}")


def keyed(text):
    return {k: int(v) for k, v in (line.split() for line in text.splitlines() if len(line.split()) == 2 and line.split()[1].isdigit())}


def cgroup_sample(directory):
    """memory.current, shmem, peak, limit (bytes or None) and cpu usage (seconds) of one cgroup; {} when it is gone."""
    try:
        stat = keyed(read(f"{directory}/memory.stat"))
        limit = read(f"{directory}/memory.max").strip()
        quota = read(f"{directory}/cpu.max").split()[0]
        return {"memory_current": int(read(f"{directory}/memory.current")), "shmem": stat.get("shmem", 0), "inactive_file": stat.get("inactive_file", 0),
                "peak": int(read(f"{directory}/memory.peak")), "limit": None if limit == "max" else int(limit),
                "cpu_s": keyed(read(f"{directory}/cpu.stat"))["usage_usec"] / 1e6, "throttled_s": keyed(read(f"{directory}/cpu.stat")).get("throttled_usec", 0) / 1e6,
                "cpu_limit": None if quota == "max" else int(quota) / int(read(f"{directory}/cpu.max").split()[1]),
                "swap_current": swap_current(directory)}
    except (OSError, KeyError, ValueError):
        return {}


def swap_current(directory):
    """memory.swap.current of a cgroup in bytes; None when unreadable (not judged)."""
    try:
        return int(read(f"{directory}/memory.swap.current"))
    except (OSError, ValueError):
        return None


def vm_swap_mb(pid):
    """VmSwap in MB of a process and of its descendants; 0 for one that is gone."""
    total = 0.0
    try:
        for line in read(f"/proc/{pid}/status").splitlines():
            if line.startswith("VmSwap:"):
                total += int(line.split()[1]) / 1024
        for task in os.listdir(f"/proc/{pid}/task"):
            for child in read(f"/proc/{pid}/task/{task}/children").split():
                total += vm_swap_mb(int(child))
    except (OSError, ValueError):
        pass
    return total


def process_cpu(pid):
    try:
        fields = read(f"/proc/{pid}/stat").rsplit(")", 1)[1].split()
        return (int(fields[11]) + int(fields[12])) / CLK
    except (OSError, IndexError):
        return None


def host_sample():
    total = [int(x) for x in read("/proc/stat").splitlines()[0].split()[1:9]]
    meminfo = keyed(read("/proc/meminfo").replace(" kB", "").replace(":", ""))
    return {"cpu_total": sum(total), "cpu_idle": total[3] + total[4], "available_gb": meminfo["MemAvailable"] / 1048576,
            "loadavg1": float(read("/proc/loadavg").split()[0]),
            "swap_used_mb": (meminfo["SwapTotal"] - meminfo["SwapFree"]) / 1024}


def store_disk(store):
    """(bytes used, bytes available) of the filesystem under the store's /data, or None (also when the store cannot be reached)."""
    try:
        out = subprocess.run(["docker", "exec", store, "df", "-Pk", "/data"], capture_output=True, text=True, timeout=SIDE_TIMEOUT_S)
        fields = out.stdout.strip().split("\n")[-1].split()
        return (int(fields[2]) * 1024, int(fields[3]) * 1024) if out.returncode == 0 else None
    except (OSError, subprocess.SubprocessError, ValueError, IndexError):
        return None


def fds(node):
    """(open file descriptors, limit) of the node's BEAM, or None (also when the node cannot be reached)."""
    script = 'p=$(pidof beam.smp) || exit 1; ls /proc/$p/fd | wc -l; grep "open files" /proc/$p/limits'
    try:
        out = subprocess.run(["docker", "exec", node, "sh", "-c", script], capture_output=True, text=True, timeout=SIDE_TIMEOUT_S)
        lines = out.stdout.split("\n")
        if out.returncode or len(lines) < 2:
            return None
        return int(lines[0]), int(lines[1].split()[3])
    except (OSError, subprocess.SubprocessError, ValueError, IndexError):
        return None


def s3_counters(store_ip):
    """(trips, bytes, errors) the store has served, from its Prometheus endpoint (errors: requests answered 5xx); None when it does not answer."""
    try:
        text = urllib.request.urlopen(f"http://{store_ip}:9327/metrics", timeout=3).read().decode()
        trips = traffic = errors = 0.0
        for line in text.splitlines():
            if line.startswith("SeaweedFS_s3_request_total") and 'code="5' in line:
                errors += float(line.rsplit(" ", 1)[1])
            if line.startswith("SeaweedFS_s3_request_seconds_count"):
                trips += float(line.rsplit(" ", 1)[1])
            elif line.startswith(("SeaweedFS_s3_bucket_traffic_received_bytes_total", "SeaweedFS_s3_bucket_traffic_sent_bytes_total")):
                traffic += float(line.rsplit(" ", 1)[1])
    except (OSError, http.client.HTTPException, ValueError):
        return None
    return trips, traffic, errors


def admin_get(info, path, timeout):
    """(the JSON the node's admin API answers at `path`, None) or (None, the error): the node may be dead or saturated."""
    try:
        request = urllib.request.Request(info["admin"] + path, headers={"authorization": "Bearer " + read(f"{ROOT}/cluster/secrets/admin_token").strip()})
        return json.load(urllib.request.urlopen(request, timeout=timeout)), None
    except (OSError, http.client.HTTPException, ValueError) as error:
        detail = "" if isinstance(error, FileNotFoundError) else getattr(error, "reason", None) or getattr(error, "code", None) or error
        return None, f"{type(error).__name__}: {detail}"[:200]  # not str(error) for a missing token file: it names the path


def admin_json(info, path, timeout):
    """The JSON the node's admin API answers at `path`; None on any failure."""
    return admin_get(info, path, timeout)[0]


def cells_awake(info):
    document = admin_json(info, "/cells", 5)
    return document.get("total") if isinstance(document, dict) else None


def haproxy_stats(url):
    """The balancer's CSV stats as {(proxy, server): {column: value}}; None when it does not answer."""
    try:
        lines = urllib.request.urlopen(url, timeout=3).read().decode().splitlines()
    except (OSError, http.client.HTTPException, ValueError):
        return None
    if not lines or not lines[0].startswith("# "):
        return None
    names = lines[0][2:].split(",")
    return {(f[0], f[1]): dict(zip(names, f)) for f in (line.split(",") for line in lines[1:]) if len(f) > 1}


def requests_by_node(stats):
    """{"node-N": requests the balancer sent to that node (stot)}; None without stats."""
    found = {}
    for (proxy, server), row in (stats or {}).items():
        match = re.fullmatch(r"node(\d+)", server)
        if proxy == "atanor_http" and match and row.get("stot", "").isdigit():
            found[f"node-{match.group(1)}"] = int(row["stot"])
    return found or None


def backend_counters(stats):
    """The counters of the http backend that show trouble during a join; None without stats."""
    row = (stats or {}).get(("atanor_http", "BACKEND"))
    if not row:
        return None
    return {k: int(row[k]) for k in ("stot", "hrsp_5xx", "econ", "eresp", "wretr", "wredis") if row.get(k, "").isdigit()}


def cells_by_node(info):
    """{"node-N": cells awake on that node} from the admin API's /cells; None when it does not answer or a node has no count."""
    document = admin_json(info, "/cells", 5)
    nodes = document.get("nodes") if isinstance(document, dict) else None
    found = {}
    for name, report in (nodes.items() if isinstance(nodes, dict) else []):
        match = re.search(r"node-\d+", str(name))
        count = report.get("count") if isinstance(report, dict) else None
        if match and isinstance(count, int):
            found[match.group(0)] = count
    return found or None


def spread_sample(info):
    """What the balancer and the admin API say now about the spread of the load over the nodes (None for what they do not say)."""
    stats = haproxy_stats(info["stats"])
    return {"requests": requests_by_node(stats), "backend": backend_counters(stats), "cells": cells_by_node(info)}


def load_env(*args):
    return subprocess.run([f"{HERE}/load-env", *args], check=True, capture_output=True, text=True).stdout.strip()


def side_env(*args):
    """load_env for a side measurement: its output, or None when it fails (a limit of the node is a result, not a crash)."""
    try:
        return subprocess.run([f"{HERE}/load-env", *args], check=True, capture_output=True, text=True, timeout=SIDE_TIMEOUT_S).stdout.strip()
    except (OSError, subprocess.SubprocessError):
        return None


def store_rtt():
    """Round trip from the node to the store in ms; None when it cannot be measured."""
    try:
        return float(side_env("rtt"))
    except (TypeError, ValueError):
        return None


def node_state(node):
    """What `docker inspect` says about the node container; {"gone": True} when it no longer exists, None when unknown."""
    try:
        out = subprocess.run(["docker", "inspect", node], capture_output=True, text=True, timeout=SIDE_TIMEOUT_S)
        if out.returncode and "No such" in out.stderr:
            return {"gone": True}
        document = json.loads(out.stdout)[0]
        state = document["State"]
        return {"id": document["Id"], "running": state["Running"], "oom_killed": state["OOMKilled"], "exit_code": state["ExitCode"],
                "started_at": state["StartedAt"], "restarts": document.get("RestartCount", 0), "inspect": document}
    except (OSError, subprocess.SubprocessError, ValueError, KeyError, IndexError, TypeError):
        return None


def node_death(before, after):
    """Why the node stopped during a step (it is a result of the step, not a crash of the runner), or None."""
    if not after:
        return None
    if after.get("gone"):
        return "node container gone"
    if after["oom_killed"]:
        return "node OOM-killed"
    if not after["running"]:
        return f"node exited {after['exit_code']}"
    if before and not before.get("gone") and (after["id"] != before["id"] or after["started_at"] != before["started_at"] or after["restarts"] > before["restarts"]):
        return "node restarted"
    return None


SECRET_WORDS = ("token", "key", "secret", "credential")


def without_secrets(text):
    """`text` without the lines that name a token, key, secret or credential (any case)."""
    return "".join(line for line in text.splitlines(keepends=True) if not any(word in line.lower() for word in SECRET_WORDS))


def capped(data):
    """`data` (bytes) with at most the last LOG_CAP_BYTES of it, led by a note when it was cut."""
    note = f"[truncated: the last {LOG_CAP_BYTES} of {len(data)} bytes]\n".encode() if len(data) > LOG_CAP_BYTES else b""
    return note + data[-LOG_CAP_BYTES:]


def save_node_diagnostics(base, node, state, store=None):
    """The node's inspect state and its log from the container start (the last LOG_CAP_BYTES of it), next to the step file;
    with `store` (its container id and ip) also the store's log and its Prometheus metrics, without the lines that name a secret.
    The logs are gone after load:down and the store is replaced before the next step."""
    files = []
    try:
        state = state or {}
        shown = state.get("inspect", {}).get("State", state)
        with open(f"{base}.node-state.txt", "w") as file:
            json.dump({"state": shown, "restart_count": state.get("restarts")}, file, indent=1)
        files.append(os.path.basename(f"{base}.node-state.txt"))
        out = subprocess.run(["docker", "logs", node], capture_output=True, timeout=120)
        with open(f"{base}.node.log", "wb") as file:
            file.write(capped(out.stdout + out.stderr))
        files.append(os.path.basename(f"{base}.node.log"))
    except (OSError, subprocess.SubprocessError):
        pass
    return files + (save_store_diagnostics(base, store) if store else [])


def save_store_diagnostics(base, store):
    """The store's log (`NAME.store.log`, timestamped) and metrics (`NAME.store-metrics.txt`); each is skipped when it cannot be read."""
    files = []
    try:
        out = subprocess.run(["docker", "logs", "--timestamps", store["id"]], capture_output=True, timeout=120)
        with open(f"{base}.store.log", "wb") as file:
            file.write(capped(without_secrets((out.stdout + out.stderr).decode(errors="replace")).encode()))
        files.append(os.path.basename(f"{base}.store.log"))
    except (OSError, subprocess.SubprocessError):
        pass
    try:
        text = urllib.request.urlopen(f"http://{store['ip']}:9327/metrics", timeout=5).read().decode(errors="replace")
        with open(f"{base}.store-metrics.txt", "w") as file:
            file.write(without_secrets(text))
        files.append(os.path.basename(f"{base}.store-metrics.txt"))
    except (OSError, http.client.HTTPException):
        pass
    return files


def save_join_diagnostics(base, info):
    """What the join leaves for every node, ok or not, as `base.node-N.node-state.txt` and `base.node-N.node.log`, and the store's log and
    metrics as `base.store.log` and `base.store-metrics.txt` (the nodes and the store are replaced by the next measure); the file names."""
    files = []
    for node in info.get("nodes") or []:
        files += save_node_diagnostics(f"{base}.{node['name']}", node["id"], node_state(node["id"]))
    return files + save_store_diagnostics(base, info["store"])


# ---- sampling during a step ----------------------------------------------------------------------------

def generators_cpu(pids):
    """CPU seconds of the generator processes; None when one cannot be read."""
    readings = [process_cpu(p) for p in pids]
    return None if None in readings else sum(readings)


def node_ids(info):
    """The container ids of the nodes of the lab: all the running ones of a cluster, else the one node."""
    return [n["id"] for n in info.get("nodes") or [info["node"]]]


def lab_dirs(info):
    """The cgroup directories of the lab: `node`, the store, the balancer and, in a cluster, `extraN` for each node beyond `node`."""
    dirs = {name: cgroup_dir(info[name]["pid"]) for name in ("node", "store", "lb")}
    others = [n for n in info.get("nodes") or [] if n["id"] != info["node"]["id"]]
    dirs.update({f"extra{i}": cgroup_dir(n["pid"]) for i, n in enumerate(others, 1)})
    return dirs


class Sampler(threading.Thread):
    """Reads the node(s), the store, the host and the generators every `period` seconds until stopped."""

    def __init__(self, info, period, spread=False):
        super().__init__(daemon=True)
        self.info, self.period, self.spread, self.pids, self.stop_flag = info, period, spread, [], threading.Event()
        self.dirs = lab_dirs(info)
        self.samples, self.stalls = [], []

    def refresh(self):
        """Reads the nodes' cgroups again, after a node joined (`info` was updated)."""
        self.dirs = lab_dirs(self.info)

    def watch(self):
        """A ticker in the harness's own process: a sleep of TICK_S that overshoots by STALL_S or more means the whole VM (or the
        harness) stopped; it is recorded as (wall time, overshoot s). A node or store fault does not stop this thread."""
        while not self.stop_flag.is_set():
            began = time.monotonic()
            time.sleep(TICK_S)
            over = time.monotonic() - began - TICK_S
            if over >= STALL_S:
                self.stalls.append((time.time(), round(over, 2)))

    def take(self):
        sample = {"t": time.time(), "host": host_sample(), "gen_cpu_s": generators_cpu(self.pids), "self_cpu_s": process_cpu(os.getpid()),
                  "gen_swap_mb": sum(vm_swap_mb(p) for p in self.pids)}
        for name, directory in dict(self.dirs).items():
            sample[name] = cgroup_sample(directory)
        sample["fds"] = fds(self.info["node"]["id"])
        if self.spread:  # the scale measure: where the requests and the cells are
            sample["spread"] = spread_sample(self.info)
            sample["node_runtimes"], sample["node_keys"] = node_runtimes(self.info, 3), node_cgroup_keys(self.info)  # every node's own /runtime and throttling
        if self.info.get("store_backing") == "disk":
            sample["store_disk"] = store_disk(self.info["store"]["id"])
        counters = s3_counters(self.info["store"]["ip"])
        sample["s3_errors"] = int(counters[2]) if counters else None
        runtime = admin_json(self.info, "/runtime", 3)
        sample["runtime"] = runtime if isinstance(runtime, dict) else None
        return sample

    def run(self):
        while not self.stop_flag.is_set():
            try:
                self.samples.append(self.take())
            except Exception as error:  # a sample is lost, not the step
                say(f"sample failed: {error}")
            self.stop_flag.wait(self.period)

    def start(self):
        super().start()
        threading.Thread(target=self.watch, daemon=True).start()

    def finish(self):
        self.stop_flag.set()
        self.join()
        try:
            self.samples.append(self.take())
        except Exception as error:
            say(f"last sample failed: {error}")
        return self.samples


def swap_growth_mb(values):
    """(at the start of the step, the largest sampled, growth of the largest over the start), in MB."""
    return round(values[0], 1), round(max(values), 1), round(max(values) - values[0], 1)


def container_swap_max_mb(samples, name):
    """Largest memory.swap.current of a measured container in MB; None when never readable."""
    seen = [s[name]["swap_current"] for s in samples if s.get(name, {}).get("swap_current") is not None]
    return round(max(seen) / 1048576, 2) if seen else None


def judge_swap(usage, generator_max_mb, host_growth_max_mb):
    """Why a step is INVALID by swap, or None: a measured container swapped, the generators' VmSwap grew too much, host swap used grew too much during the step (its level is only recorded)."""
    swapped = {n: mb for n, mb in usage["swap_usage"]["containers_max_mb"].items() if mb}
    if swapped:
        return "measured container swapped: " + ", ".join(f"{n} {mb} MB" for n, mb in swapped.items())
    growth = usage["swap_usage"]["generator_growth_mb"]
    if growth > generator_max_mb:
        return f"load generator swap grew {growth} MB > {generator_max_mb:g} MB"
    host_growth = usage["host"]["swap_growth_mb"]
    if host_growth > host_growth_max_mb:
        return f"host swap grew {host_growth} MB > {host_growth_max_mb:g} MB"
    return None


def runtime_summary(samples):
    """What grew inside the node: the largest of each VM memory type, process count and cgroup counter, the oom kills at the end,
    and the top processes and ETS tables of the sample with the highest memory.current. None when no sample answered."""
    seen = [s for s in samples if isinstance(s.get("runtime"), dict)]
    if not seen:
        return None

    def largest(values):
        values = [v for v in values if isinstance(v, int)]
        return max(values) if values else None

    runtimes = [s["runtime"] for s in seen]
    cgroup = lambda r, key: ((r.get("cgroup") or {}).get("stat") or {}).get(key)
    peak = max(seen, key=lambda s: (s.get("node") or {}).get("memory_current") or 0)["runtime"]
    events = (runtimes[-1].get("cgroup") or {}).get("events") or {}
    return {"samples": len(seen), "versions": runtimes[-1].get("versions"),  # atanor and alambique of the node; None for an older node
            "memory_max_bytes": {k: largest((r.get("memory") or {}).get(k) for r in runtimes) for k in sorted({k for r in runtimes for k in r.get("memory") or {}})},
            "process_count_max": largest(r.get("process_count") for r in runtimes),
            "cgroup_max_bytes": {k: largest(cgroup(r, k) for r in runtimes) for k in ("anon", "shmem", "file", "sock")},
            "oom_kill": events.get("oom_kill"),
            "cgroup_memory_max_bytes": (runtimes[-1].get("cgroup") or {}).get("memory_max"),
            "at_peak": {k: peak.get(k) for k in ("top_memory", "top_message_queue", "ets", "wasm")}}


def breaker_open(runtime):
    """1 when a store breaker of the node was open or half-open in this /runtime sample, 0 when all were closed, None when unknown."""
    locations = runtime.get("store")
    return int(any(b.get("state") != "closed" for b in locations.values())) if isinstance(locations, dict) and locations else None


def stall_summary(samples, stalls):
    """Tells a stop of the whole VM from a node or store fault: the stalls of the harness's own ticker and the breaker-open samples,
    in seconds from the first sample (the `t` of `series`). `vm_pause_suspected`: a stall of the ticker came at most 10 s before the
    first breaker-open sample (or after it): the harness stopped too, so everything did. None without samples."""
    if not samples:
        return None
    start = samples[0]["t"]
    opened = [round(s["t"] - start, 1) for s in samples if breaker_open(s.get("runtime") or {}) == 1]
    found = [{"t": round(at - start, 1), "overshoot_s": over} for at, over in stalls]
    suspected = bool(opened) and any(opened[0] - 10 <= f["t"] <= opened[0] + 1 for f in found)
    return {"ticker_stalls": found, "breaker_open_at_s": opened, "vm_pause_suspected": suspected}


def series(samples):
    """One compact entry of integers per sample: what the node, its admission and the store held at that moment (None: unknown)."""
    def entry(s):
        runtime, node, store = s.get("runtime") or {}, s.get("node") or {}, s.get("store") or {}
        cgroup, admission, memory = runtime.get("cgroup") or {}, runtime.get("admission") or {}, runtime.get("memory") or {}
        refused = admission.get("refused") or {}
        refusing = admission.get("refusing")
        return {"t": round(s["t"] - samples[0]["t"], 1), "memory_current": node.get("memory_current"), "shmem": node.get("shmem"),
                "anon": (cgroup.get("stat") or {}).get("anon"), "inactive_file": (cgroup.get("stat") or {}).get("inactive_file"),
                "working_set": admission.get("working_set_bytes"), "refusing": None if refusing is None else int(refusing),
                "in_flight": admission.get("in_flight"), "refused_memory": refused.get("memory"), "refused_in_flight": refused.get("in_flight"),
                "refused_disk": refused.get("disk"), "beam_total": memory.get("total"), "beam_processes": memory.get("processes"),
                "beam_binary": memory.get("binary"), "process_count": runtime.get("process_count"),
                "oom_kill": (cgroup.get("events") or {}).get("oom_kill"),
                "store_memory_current": store.get("memory_current"), "store_shmem": store.get("shmem"), "store_limit": store.get("limit"),
                "store_s3_errors": s.get("s3_errors"), "store_breaker_open": breaker_open(runtime),
                "node_throttled_ms": None if node.get("throttled_s") is None else round(node["throttled_s"] * 1000),
                "disk_used": admission.get("disk_used_bytes"), "nodes": node_entries(s)}
    return [entry(s) for s in samples]


def node_cgroup_keys(info):
    """{node name: the key of its cgroup in a sample}: `node` for the first node, `extraN` for the others (as `lab_dirs` names them)."""
    keys, extra = {}, 0
    for n in info.get("nodes") or []:
        if n["id"] == info["node"]["id"]:
            keys[n["name"]] = "node"
        else:
            extra += 1
            keys[n["name"]] = f"extra{extra}"
    return keys


def node_entries(sample):
    """{node: {"throttled_ms", "in_flight"}} of every node of a cluster in this sample (None: unknown); None outside the scale measure."""
    reads = sample.get("node_runtimes")
    if reads is None:
        return None
    out = {}
    for name, key in sample["node_keys"].items():
        throttled = (sample.get(key) or {}).get("throttled_s")
        runtime = reads.get(name, (None, None))[0] or {}
        out[name] = {"throttled_ms": None if throttled is None else round(throttled * 1000), "in_flight": (runtime.get("admission") or {}).get("in_flight")}
    return out


def per_node_summary(samples):
    """Per node of a cluster over a step: the node's CPU throttling (`throttled_ms`: growth, and `throttled_jump_ms`: the largest between two samples),
    the most requests in flight (`in_flight_max`), the refusals it counted (`refused`) and the samples in which its /runtime did not answer
    (`runtime_failed`, with the last `runtime_error`) and the node's `versions` (atanor, alambique). None outside the scale measure."""
    seen = [s for s in samples if s.get("node_runtimes") is not None]
    if not seen:
        return None
    out = {}
    for name in seen[-1]["node_keys"]:
        key = seen[-1]["node_keys"][name]
        throttled = [t for t in ((s.get(key) or {}).get("throttled_s") for s in seen) if t is not None]
        reads = [s["node_runtimes"].get(name, (None, "no reading")) for s in seen]
        admissions = [r["admission"] for r, _ in reads if isinstance((r or {}).get("admission"), dict)]
        out[name] = {"versions": next((r["versions"] for r, _ in reversed(reads) if isinstance((r or {}).get("versions"), dict)), None),
                     "throttled_ms": round((throttled[-1] - throttled[0]) * 1000) if throttled else None,
                     "throttled_jump_ms": round(max((b - a for a, b in zip(throttled, throttled[1:])), default=0) * 1000) if throttled else None,
                     "in_flight_max": max((a.get("in_flight") or 0 for a in admissions), default=None), "refused": refused_delta(admissions),
                     "unavailable_by_reason": reasons_delta(admissions), "awake_limit_by": reasons_delta(admissions, "awake_limit_by"), "wakes": counter_growth([(r or {}).get("wakes") for r, _ in reads]),
                     "compaction": compaction_growth([r for r, _ in reads]),
                     "disk_budget_bytes": next((a["disk_budget_bytes"] for a in reversed(admissions) if isinstance(a.get("disk_budget_bytes"), int)), None),
                     "runtime_failed": sum(1 for r, _ in reads if r is None), "runtime_error": next((e for _, e in reversed(reads) if e), None)}
    return out


def refused_delta(admissions):
    """{cause: refusals counted between the first and the last of `admissions` (a node's runtime.admission, one per sample)}, for the causes
    the node reports: a cause it does not count is absent, not 0."""
    if not admissions:
        return {}
    first, last = admissions[0].get("refused") or {}, admissions[-1].get("refused") or {}
    return {k: v - (first.get(k) or 0) for k, v in last.items() if isinstance(v, int)}


def reasons_delta(admissions, key="unavailable_by_reason"):
    """{reason: growth between the first and the last of `admissions`} of `key`: `unavailable_by_reason` (the 503 `unavailable` answers by
    reason) or `awake_limit_by` (the wakes Alambique refused, by reason); None when no admission reports it (an older node)."""
    seen = [a[key] for a in admissions if isinstance(a.get(key), dict)]
    if not seen:
        return None
    return {k: v - (seen[0].get(k) or 0) for k, v in seen[-1].items() if isinstance(v, int)}


def counter_growth(values):
    """Last minus first of the integers in `values` (a counter of /runtime, one per sample); None when it was never reported."""
    seen = [v for v in values if isinstance(v, int)]
    return seen[-1] - seen[0] if seen else None


def wake_refusals(runtime):
    """The wakes Alambique refused so far (`admission.awake_limit_by`, every reason summed), cumulative; None when the node does not report it."""
    by_reason = ((runtime or {}).get("admission") or {}).get("awake_limit_by")
    ints = [v for v in by_reason.values() if isinstance(v, int)] if isinstance(by_reason, dict) else []
    return sum(ints) if ints else None


def cold_start(points):
    """Splits the wake refusals of one node into the cold start and the steady state. `points` are its readings in order, `(t, wakes, refused)`,
    both counters cumulative. The cold start lasts while the node keeps waking cells: it ends at the last reading before the first one where
    `wakes` did not grow (`ended` is false when it grew until the last reading). Returns `{end_t, ended, cold, steady}` (refusals counted
    up to `end_t`, and after it), or None with fewer than two readings of both counters."""
    seen = [p for p in points if isinstance(p[1], int) and isinstance(p[2], int)]
    if len(seen) < 2:
        return None
    stall = next((j for j in range(1, len(seen)) if seen[j][1] == seen[j - 1][1]), None)
    end = len(seen) - 1 if stall is None else stall - 1
    return {"end_t": seen[end][0], "ended": stall is not None, "cold": seen[end][2] - seen[0][2], "steady": seen[-1][2] - seen[end][2]}


def cold_start_summary(per_node, t0):
    """`{cold_start, steady, cold_start_end_s, cold_start_ended, nodes}` from `{node: cold_start(points)}` (the refusals summed; the end is the
    latest of the nodes, seconds from `t0`); None when no node reports both counters."""
    known = {n: c for n, c in per_node.items() if c}
    if not known:
        return None
    return {"cold_start": sum(c["cold"] for c in known.values()), "steady": sum(c["steady"] for c in known.values()),
            "cold_start_end_s": round(max(c["end_t"] for c in known.values()) - t0, 1), "cold_start_ended": all(c["ended"] for c in known.values()),
            "nodes": {n: {"cold_start": c["cold"], "steady": c["steady"], "cold_start_end_s": round(c["end_t"] - t0, 1)} for n, c in sorted(known.items())}}


def step_wake_refusals(samples):
    """The wake refusals of a step split into the cold start and the steady state (`cold_start`), per node and summed; None when no node reports
    `wakes` and `admission.awake_limit_by`. A step that starts with its cells awake (a warm-up) has no wakes in its first interval: all steady."""
    if not samples:
        return None
    cluster = [s for s in samples if s.get("node_runtimes") is not None]
    if cluster:
        runtimes = {n: [(s["t"], s["node_runtimes"].get(n, (None, None))[0]) for s in cluster] for n in cluster[-1]["node_keys"]}
    else:
        runtimes = {"node": [(s["t"], s.get("runtime")) for s in samples]}
    return cold_start_summary({n: cold_start([(t, (r or {}).get("wakes"), wake_refusals(r)) for t, r in reads]) for n, reads in runtimes.items()}, samples[0]["t"])


def compaction_growth(runtimes):
    """{outcome: growth of the hibernations by release compaction outcome (`hibernations.compaction` of /runtime)} plus `tail_max` (the longest WAL
    tail the node found, last reading); None when no reading reports it (an older node)."""
    seen = [h for r in runtimes if isinstance(h := (r or {}).get("hibernations"), dict) and isinstance(h.get("compaction"), dict)]
    if not seen:
        return None
    first, last = seen[0]["compaction"], seen[-1]["compaction"]
    return {**{k: v - (first.get(k) or 0) for k, v in last.items() if isinstance(v, int)}, "tail_max": seen[-1].get("tail_max")}


def budget_note(budgets):
    """A note when the nodes of a cluster do not report the same `disk_budget_bytes` ({node: bytes or None}); None when they agree or none is known:
    a node with another data dir limit hibernates cells at another point, so the nodes are not comparable."""
    known = {n: b for n, b in budgets.items() if isinstance(b, int)}
    if len(set(known.values())) <= 1:
        return None
    return "nodes differ in disk_budget_bytes: " + ", ".join(f"{n} {b}" for n, b in sorted(known.items()))


REFUSED_KEYS = ("memory", "in_flight", "disk", "wake_gate", "awake_limit", "busy", "disk_full", "queue_timeout", "worker_queue", "nested_calls", "unavailable")


def admission_summary(samples):
    """The thresholds the node judged against and the refusals counted during the step (last sample minus first, every cause the node reports;
    `refused_unreported` lists the known causes it does not); the disk use against its budget, which is all the node exposes of the disk
    reclaim; None without /runtime."""
    seen = [s["runtime"]["admission"] for s in samples if isinstance((s.get("runtime") or {}).get("admission"), dict)]
    if not seen:
        return None
    last = seen[-1]
    disk = [a["disk_used_bytes"] for a in seen if isinstance(a.get("disk_used_bytes"), int)]
    budget = last.get("disk_budget_bytes")
    delta = refused_delta(seen)
    return {"refused": delta, "unavailable_by_reason": reasons_delta(seen), "awake_limit_by": reasons_delta(seen, "awake_limit_by"), "refused_unreported": [k for k in REFUSED_KEYS if k not in delta], "refusing_seen": any(a.get("refusing") or a.get("disk_refusing") for a in seen),
            "in_flight_max": max((a.get("in_flight") or 0 for a in seen), default=None), "working_set_max_bytes": max((a.get("working_set_bytes") or 0 for a in seen), default=None),
            "disk_used_start_bytes": disk[0] if disk else None, "disk_used_max_bytes": max(disk) if disk else None,
            "disk_used_max_pct_of_budget": round(100 * max(disk) / budget, 1) if disk and budget else None,
            **{k: last.get(k) for k in ("limit_bytes", "refuse_at_bytes", "max_in_flight", "disk_budget_bytes")}}


def eviction_evidence(awake_start, awake_end, admission, samples=()):
    """What tells why cells went to sleep during a step. The node counts only the hibernations under memory pressure (`pressure.hibernated` in
    /runtime: `pressure_hibernated` is its growth over the step, None when the node does not report it); the awake budget's and the disk
    reclaim's are telemetry events only, so for them this is the evidence around them: the cells awake at the start and the end of the step,
    and the disk use against its budget (the reclaim starts at `disk.evict_fraction` of it, 0.7 by default)."""
    admission = admission or {}
    change = None if awake_start is None or awake_end is None else awake_end - awake_start
    seen = [p["hibernated"] for s in samples if isinstance(p := (s.get("runtime") or {}).get("pressure"), dict) and isinstance(p.get("hibernated"), int)]
    return {"counter_in_runtime": False, "cells_awake_start": awake_start, "cells_awake_end": awake_end, "cells_awake_change": change,
            "pressure_hibernated": seen[-1] - seen[0] if seen else None, "wakes": counter_growth([(s.get("runtime") or {}).get("wakes") for s in samples]),
            "wake_ms": counter_growth([((s.get("runtime") or {}).get("wake_ms") or {}).get("total") for s in samples]),
            "compaction": compaction_growth([s.get("runtime") for s in samples]),
            "disk_used_max_pct_of_budget": admission.get("disk_used_max_pct_of_budget"), "disk_budget_bytes": admission.get("disk_budget_bytes")}


def refusals_503(statuses, samples):
    """The 503 answers of a step against the refusals the nodes counted (every node of a cluster, summed): `answers_503`, `by_cause` (the
    growth of each counter), `attributed` (their sum) and `unattributed` (503 answers no counter grew for; the counters count calls, so they
    may exceed the answers). None without any /runtime reading; `by_cause` is then not known and nothing is attributed."""
    answers = statuses.get("503 retry-after", 0) + statuses.get("503 no retry-after", 0)
    per_node = [{n: s["node_runtimes"][n][0] for n in s["node_runtimes"]} for s in samples if s.get("node_runtimes") is not None]
    if per_node:
        deltas = [refused_delta([r["admission"] for r in (reads.get(n) for reads in per_node) if isinstance((r or {}).get("admission"), dict)]) for n in per_node[-1]]
    else:
        deltas = [refused_delta([s["runtime"]["admission"] for s in samples if isinstance((s.get("runtime") or {}).get("admission"), dict)])]
    by_cause = {}
    for delta in deltas:
        for cause, n in delta.items():
            by_cause[cause] = by_cause.get(cause, 0) + n
    if not by_cause:
        return None
    attributed = sum(by_cause.values())
    return {"answers_503": answers, "by_cause": by_cause, "attributed": attributed, "unattributed": max(answers - attributed, 0)}


def judge_store(store, max_pct, max_disk_pct=90):
    """The INVALID reason when the store's tmpfs (or, on disk, its filesystem) passed its share at any sample, else None."""
    pct = (store or {}).get("tmpfs_max_pct")
    if pct is not None and pct > max_pct:
        return f"store tmpfs {pct:g}% > {max_pct:g}%"
    disk = (store or {}).get("disk_max_pct")
    return f"store disk {disk:g}% > {max_disk_pct:g}%" if disk is not None and disk > max_disk_pct else None


def judge_stall(lag_p99_ms, entries, max_lag_ms, max_jump_ms):
    """Why a step is INVALID by a stall of the lab, or None: the generator's own lag p99 (its release lag) over `max_lag_ms`, or one growth of the node's
    CPU throttling between two samples of `series` over `max_jump_ms` and over 5 times the median growth (a saturated node throttles
    at every sample, a stall once). A stall fails a step by chance, so it measures the lab."""
    if lag_p99_ms is not None and lag_p99_ms > max_lag_ms:  # None: no generator data, unknown
        return f"stall: generator lag p99 {lag_p99_ms:g} ms > {max_lag_ms:g} ms"
    values = [e.get("node_throttled_ms") for e in entries]
    growth = [b - a for a, b in zip(values, values[1:]) if a is not None and b is not None]
    if growth:
        jump, typical = max(growth), statistics.median(growth)
        if jump > max_jump_ms and jump > 5 * typical:
            return f"stall: node CPU throttling grew {jump} ms between two samples > {max_jump_ms:g} ms and 5 x the median {typical:g} ms"
    return None


STORE_STALL_WINDOW_S = 5.0
SLOW_STORE_LINE = re.compile(r"^(\d\d):(\d\d):(\d\d(?:\.\d+)?) .*HTTP request \w+ \S+ took (\d+) ms")


def store_stall(log, min_ms, min_requests):
    """Evidence of a store stall in a node's log: the node-to-store requests that took `min_ms` or more ("HTTP request PUT store:8333 took N ms"),
    and the most of them within STORE_STALL_WINDOW_S seconds; `stalled` when that is `min_requests` or more. None without a slow request or when
    `min_ms` is 0 (off). The log's clock is the time of day, so a window across midnight is not joined."""
    if not min_ms:
        return None
    slow = []
    for line in log.splitlines():
        found = SLOW_STORE_LINE.match(line)
        if found and int(found[4]) >= min_ms:
            slow.append((int(found[1]) * 3600 + int(found[2]) * 60 + float(found[3]), int(found[4])))
    if not slow:
        return None
    times = [t for t, _ in slow]
    window = max(sum(1 for u in times if t <= u < t + STORE_STALL_WINDOW_S) for t in times)
    return {"slow_requests": len(slow), "max_ms": max(ms for _, ms in slow), "window_requests": window, "window_s": STORE_STALL_WINDOW_S,
            "threshold_ms": min_ms, "min_requests": min_requests, "stalled": window >= min_requests}


def node_log_since(node, since):
    """The log of a node container from `since` (epoch seconds); "" when it cannot be read."""
    try:
        out = subprocess.run(["docker", "logs", "--since", str(int(since)), node], capture_output=True, timeout=120)
        return (out.stdout + out.stderr).decode(errors="replace")
    except (OSError, subprocess.SubprocessError):
        return ""


def store_stalled(record):
    """Whether a step attempt was INVALID because the store stalled (`judge_store_stall`)."""
    return (record["stop_reason"] or "").startswith("stall: store stalled")


def judge_store_stall(evidence):
    """The INVALID reason when the store stalled (`store_stall` evidence), else None. A stall fails a step by chance: it measures the lab."""
    if evidence and evidence["stalled"]:
        return (f"stall: store stalled, {evidence['window_requests']} node-to-store requests took >= {evidence['threshold_ms']:g} ms within "
                f"{evidence['window_s']:g} s (slowest {evidence['max_ms']} ms)")
    return None


def store_summary(samples, tmpfs_bytes, backing="tmpfs"):
    """The store container's memory, its backing, its tmpfs (shmem) against the tmpfs size, its disk use when on disk, and the S3 5xx answered during the step."""
    mem = [s["store"] for s in samples if s.get("store")]
    errors = [s["s3_errors"] for s in samples if s.get("s3_errors") is not None]
    if not mem:
        return None
    mb = lambda n: round(n / 1048576, 1)
    shmem = max(m["shmem"] for m in mem)
    disks = [s["store_disk"] for s in samples if s.get("store_disk")]
    disk = {"disk_used_max_mb": mb(max(u for u, _ in disks)), "disk_free_min_mb": mb(min(a for _, a in disks)),
            "disk_max_pct": round(100 * max(u / (u + a) for u, a in disks), 1)} if disks else {}
    return {"backing": backing, **disk, "memory_max_mb": mb(max(m["memory_current"] for m in mem)), "limit_mb": mb(mem[-1]["limit"]) if mem[-1]["limit"] else None,
            "tmpfs_max_mb": mb(shmem), "tmpfs_size_mb": mb(tmpfs_bytes) if tmpfs_bytes else None,
            "tmpfs_max_pct": round(100 * shmem / tmpfs_bytes, 1) if tmpfs_bytes else None,
            "s3_errors": errors[-1] - errors[0] if errors else None}


def own_cpu_s(sample):
    """CPU seconds the lab used so far: node, store, balancer, generators and this harness; None when any reading is missing."""
    lab = ("node", "store", "lb") + tuple(k for k in sample if k.startswith("extra"))  # every node of a cluster is the lab's own
    parts = [sample[n].get("cpu_s") for n in lab] + [sample.get("gen_cpu_s"), sample.get("self_cpu_s")]
    return None if any(p is None for p in parts) else sum(parts)


def net_load(a, b):
    """(busy cores, foreign cores) between two samples. Foreign is the busy cores minus the lab's own: the node, store and balancer
    cgroups, the generators and this harness. None when no time or CPU passed, when the host idle counter went back, or when a lab
    reading is missing in either sample: a missing total would subtract all the CPU accumulated so far."""
    dt, total, idle = b["t"] - a["t"], b["host"]["cpu_total"] - a["host"]["cpu_total"], b["host"]["cpu_idle"] - a["host"]["cpu_idle"]
    first, last = own_cpu_s(a), own_cpu_s(b)
    if dt <= 0 or total <= 0 or idle < 0 or first is None or last is None:
        return None
    busy = CORES * (1 - idle / total)
    return busy, max(busy - (last - first) / dt, 0)


def is_quiet(intervals, limit, window):
    """True when the newest contiguous run of (start, end, foreign load) intervals below `limit` spans at least `window` seconds."""
    if not intervals or intervals[-1][2] >= limit:
        return False
    start = intervals[-1][0]
    for began, ended, load in reversed(intervals):
        if load >= limit or ended < start:  # a gap (an interval without a reading) ends the run
            break
        start = began
    return intervals[-1][1] - start >= window


def judge_host(mean, limit):
    """Why a step is INVALID by the foreign host load, or None."""
    return f"host contaminated: net load {mean:g} > {limit:g}" if mean is not None and mean > limit else None


def judge_busy(busy, share):
    """Why a step is INVALID because the host ran out of cores (the generator, the balancer, the store and the nodes all ran on it), or None.
    `busy`: mean busy cores of the step; the limit is `share` of this host's cores."""
    limit = share * CORES
    return f"host saturated: {busy:g} busy cores > {limit:g} ({share:.0%} of {CORES} cores)" if busy is not None and busy > limit else None


def cpu_caps(nodes, limits, cores):
    """(sum of the CPU limits of up to `nodes` nodes, the store and the balancer, a warning when it exceeds `cores`, else None).
    The limits are caps, not reservations: the run goes on and `judge_busy` guards each step. `limits`: from `load-env limits`."""
    wanted = nodes * limits["node_cpus"] + limits["store_cpus"] + limits["lb_cpus"]
    warning = None if wanted <= cores else (
        f"the CPU limits add up to {wanted:g} ({nodes} nodes x {limits['node_cpus']:g} + store {limits['store_cpus']:g} + balancer {limits['lb_cpus']:g}), "
        f"more than the host's {cores} cores; they are caps, so the run goes on, and a step that fills the host is INVALID (host saturated)")
    return wanted, warning


def busy_reason(load, args):
    """Why the wait for a quiet host gave up; load is None when no interval had every reading."""
    shown = "unknown" if load is None else f"{load:g}"
    return f"host busy: net load {shown} >= {args.host_load_max:g} for {args.quiet_max_wait:g} s, no quiet window of {args.quiet_window:g} s"


def quiet_sample(dirs):
    """The part of a sample that net_load reads, for the wait before a step."""
    sample = {"t": time.time(), "host": host_sample(), "gen_cpu_s": 0.0, "self_cpu_s": process_cpu(os.getpid())}
    for name in {"node", "store", "lb", *dirs}:  # no lab running: nothing of it to count out
        sample[name] = cgroup_sample(dirs[name]) if name in dirs else {"cpu_s": 0.0}
    return sample


def wait_quiet(args, info):
    """Waits until the foreign host load stays below --host-load-max for --quiet-window seconds. (True, load) when it did;
    (False, last load) after --quiet-max-wait seconds of not."""
    try:
        dirs = lab_dirs(info)
    except (OSError, RuntimeError, KeyError):
        dirs = {}
    intervals, previous, deadline, load, announced = [], quiet_sample(dirs), time.time() + args.quiet_max_wait, None, False
    while True:
        time.sleep(args.sample_s)
        current = quiet_sample(dirs)
        loads = net_load(previous, current)
        if loads:
            load = round(loads[1], 2)
            intervals.append((previous["t"], current["t"], load))
        previous = current
        if is_quiet(intervals, args.host_load_max, args.quiet_window):
            return True, load
        if time.time() >= deadline:
            return False, load
        if load is not None and load >= args.host_load_max and not announced:
            say(f"waiting for a quiet host: net load {load:g} >= {args.host_load_max:g} (up to {args.quiet_max_wait:g} s)")
            announced = True


def summarize(samples, gen_cpu_total, limit):
    """CPU, memory, fds and host load over the samples of one step. limit: the scenario's memory in bytes (the container's
    cgroup limit is that plus the tmpfs); the working set of the node's own gate (memory.current - inactive_file, tmpfs
    included) is measured against it."""
    first, last = samples[0], samples[-1]
    span = max(last["t"] - first["t"], 1e-9)

    def cores(name):
        a, b = first[name].get("cpu_s"), last[name].get("cpu_s")
        return None if a is None or b is None else (b - a) / span

    node, store, lb = cores("node"), cores("store"), cores("lb")
    names = ["node"] + sorted(k for k in first if k.startswith("extra"))  # the nodes of a cluster; the criteria hold for the fullest one
    fullest = max((max(s[n]["memory_current"] - s[n].get("inactive_file", 0) for s in samples if s.get(n)) for n in names if any(s.get(n) for s in samples)), default=None)
    nets =[n for n in (net_load(a, b) for a, b in zip(samples, samples[1:])) if n]
    mem = [s["node"] for s in samples if s["node"]]
    current = [m["memory_current"] for m in mem]
    service = [m["memory_current"] - m.get("inactive_file", 0) for m in mem]
    fd = [s["fds"] for s in samples if s["fds"]]
    mb = lambda n: round(n / 1048576, 1)
    return {
        "cpu": {"node_cores": round(node, 3) if node is not None else None, "store_cores": round(store or 0, 3), "lb_cores": round(lb or 0, 3),
                "generator_cores": round(gen_cpu_total / span, 3), "node_limit_cores": mem[-1]["cpu_limit"] if mem else None,
                "nodes_cores": [None if cores(n) is None else round(cores(n), 3) for n in names] if len(names) > 1 else None},
        "memory": {"service_mb": mb(service[-1]) if service else None, "service_max_mb": mb(max(service)) if service else None,
                   "tmpfs_mb": mb(mem[-1]["shmem"]) if mem else None,
                   "tmpfs_start_mb": mb(mem[0]["shmem"]) if mem else None, "tmpfs_max_mb": mb(max(m["shmem"] for m in mem)) if mem else None,
                   "tmpfs_growth_mb": mb(max(m["shmem"] for m in mem) - mem[0]["shmem"]) if mem else None, "current_mb": mb(current[-1]) if current else None,
                   "current_max_mb": mb(max(current)) if current else None,
                   "peak_mb": mb(mem[-1]["peak"]) if mem else None, "limit_mb": mb(limit) if limit else None,
                   "max_pct_of_limit": round(100 * max(fullest, max(service)) / limit, 1) if service and limit else None},
        "fds": {"count": fd[-1][0] if fd else None, "max": max((f[0] for f in fd), default=None), "limit": fd[-1][1] if fd else None},
        "host": {"busy_cores_mean": round(sum(b for b, _ in nets) / len(nets), 2) if nets else None,
                 "net_load_mean": round(sum(n for _, n in nets) / len(nets), 2) if nets else None,
                 "net_load_max": round(max((n for _, n in nets), default=0), 2), "net_load_skipped": len(samples) - 1 - len(nets),
                 "loadavg1": last["host"]["loadavg1"], "available_gb_min": round(min(s["host"]["available_gb"] for s in samples), 1),
                 **dict(zip(("swap_start_mb", "swap_max_mb", "swap_growth_mb"), swap_growth_mb([s["host"]["swap_used_mb"] for s in samples])))},
        "swap_usage": {**dict(zip(("generator_start_mb", "generator_max_mb", "generator_growth_mb"), swap_growth_mb([s["gen_swap_mb"] for s in samples]))),
                       "containers_max_mb": {n: container_swap_max_mb(samples, n) for n in ("node", "store", "lb")}},
    }


# ---- the spread of the load over the nodes -------------------------------------------------------------

def deviation(counts, names):
    """How far the shares of `names` are from an equal split: the largest |share x N - 1| (0.2: a node holds 20% more or less than 1/N).
    A node without a count holds 0. None when the nodes hold nothing."""
    total = sum(counts.get(n, 0) for n in names)
    return max(abs(counts.get(n, 0) / total * len(names) - 1) for n in names) if total and names else None


def shares(counts, names):
    """{node: share of the total}, None when `counts` is unknown or empty."""
    total = sum(counts.get(n, 0) for n in names) if counts else 0
    return {n: round(counts.get(n, 0) / total, 3) for n in names} if total else None


def distribution(samples, names):
    """Requests the balancer sent to each node during a step (last sample minus first) and the cells awake on each at the end,
    with their shares and how far they are from an equal split. None without a cluster or without any reading."""
    seen = [s["spread"] for s in samples if s.get("spread")]
    if not names or not seen:
        return None
    requests = [s["requests"] for s in seen if s["requests"]]
    cells = [s["cells"] for s in seen if s["cells"]]
    sent = {n: requests[-1].get(n, 0) - requests[0].get(n, 0) for n in names} if len(requests) > 1 else None
    awake = {n: cells[-1].get(n, 0) for n in names} if cells else None
    dev = lambda counts: None if not counts or deviation(counts, names) is None else round(deviation(counts, names), 3)
    return {"nodes": names, "requests": sent, "request_share": shares(sent, names), "request_deviation": dev(sent),
            "cells_awake": awake, "cells_share": shares(awake, names), "cells_deviation": dev(awake)}


def interval_points(series, names):
    """[(t, requests of each node in the interval starting at t)] from [(t, cumulative requests per node)]; an interval without
    both readings, or where a counter went back, is left out."""
    points = []
    for (a, x), (_, y) in zip(series, series[1:]):
        if x and y and all(y.get(n, 0) >= x.get(n, 0) for n in names):
            points.append((a, {n: y.get(n, 0) - x.get(n, 0) for n in names}))
    return points


def spread_time(points, names, tol, hold, min_total):
    """The t of the first of `hold` consecutive points, each with at least `min_total` in all and every node of `names` within
    `tol` (a fraction) of its equal share; None when that never held. Points: [(t, {node: count})]."""
    run, start = 0, None
    for t, counts in points:
        dev = deviation(counts, names) if sum(counts.get(n, 0) for n in names) >= min_total else None
        if dev is None or dev > tol:
            run = 0
            continue
        start = t if run == 0 else start
        run += 1
        if run >= hold:
            return start
    return None


def gain(ceilings):
    """{nodes: {ceiling, gain over 1 node, ideal, efficiency}} from {nodes: ceiling}; the ceiling of 1 node is the base. {} without it."""
    base = ceilings.get(1)
    if not base:
        return {}
    return {n: {"ceiling": c, "gain": round(c / base, 2), "ideal": n, "efficiency": round(c / base / n, 2)} for n, c in sorted(ceilings.items()) if c}


# ---- results of the generators -------------------------------------------------------------------------

def merge(documents):
    out = {"statuses": {}, "hist": {}, "max_ms": 0.0, "planned": 0, "sent": 0, "completed": 0, "cpu_s": 0.0, "lag_p99": 0.0, "release_lag_p99": None, "reasons_503": {}}
    for d in documents:
        for key, n in (d.get("reasons_503") or {}).items():
            out["reasons_503"][key] = out["reasons_503"].get(key, 0) + n
        for key in ("planned", "sent", "completed", "cpu_s"):
            out[key] += d.get(key, 0)
        for key, n in d["statuses"].items():
            out["statuses"][key] = out["statuses"].get(key, 0) + n
        for key, n in d["hist"].items():
            out["hist"][int(key)] = out["hist"].get(int(key), 0) + n
        out["max_ms"] = max(out["max_ms"], d["max_ms"])
        out["lag_p99"] = max(out["lag_p99"], d["lag_ms"].get("p99", 0))
        release = (d.get("release_lag_ms") or {}).get("p99")
        if release is not None:
            out["release_lag_p99"] = max(out["release_lag_p99"] or 0.0, release)
        for key in ("opened", "failed", "dropped", "held"):
            if key in d:
                out[key] = out.get(key, 0) + d[key]
        if d.get("opening"):  # cells: the opening's own share of the statuses and the histogram
            opening = out.setdefault("opening", {"planned": 0, "statuses": {}, "hist": {}, "max_ms": 0.0})
            opening["planned"] += d["opening"]["planned"]
            opening["max_ms"] = max(opening["max_ms"], d["opening"]["max_ms"])
            for key, n in d["opening"]["statuses"].items():
                opening["statuses"][key] = opening["statuses"].get(key, 0) + n
            for key, n in d["opening"]["hist"].items():
                opening["hist"][int(key)] = opening["hist"].get(int(key), 0) + n
    return out


def hold_of(merged):
    """The statuses, histogram and max of the requests after the opening: all of them minus the opening's (max_ms is None when the slowest was an opening request)."""
    opening = merged["opening"]
    sub = lambda whole, part: {k: n - part.get(k, 0) for k, n in whole.items() if n - part.get(k, 0) > 0}
    return {"statuses": sub(merged["statuses"], opening["statuses"]), "hist": sub(merged["hist"], opening["hist"]),
            "max_ms": merged["max_ms"] if merged["max_ms"] > opening["max_ms"] else None}


def latency_block(hist, max_ms):
    """p50, p95, p99 and max in ms of a histogram; without `max_ms` the max is the top of its slowest bucket."""
    top = max_ms if max_ms is not None or not hist else (max(hist) + 1) / BUCKET
    return {"p50": percentile(hist, 50, top), "p95": percentile(hist, 95, top), "p99": percentile(hist, 99, top), "max": percentile(hist, 100, top)}


def refused_of(statuses):
    """(answers, 503 refusals) in a statuses dict."""
    return sum(statuses.values()), statuses.get("503 retry-after", 0) + statuses.get("503 no retry-after", 0)


def percentile(hist, p, max_ms):
    total = sum(hist.values())
    if not total:
        return None
    if p >= 100:
        return round(max_ms, 1)
    seen, target = 0, total * p / 100
    for bucket in sorted(hist):
        seen += hist[bucket]
        if seen >= target:
            return round((bucket + 1) / BUCKET, 1)
    return round(max_ms, 1)


# ---- one step ------------------------------------------------------------------------------------------

class GeneratorTimeout(Exception):
    """A generator ran past round.step_timeout_s and was killed: the step is INVALID."""


def generator_pid(wrapper):
    """The pid of the generator that `timeout` (process `wrapper`) runs, so that its CPU and swap are counted as the generator's;
    the wrapper's own pid when the child does not show up."""
    for _ in range(20):
        try:
            children = read(f"/proc/{wrapper.pid}/task/{wrapper.pid}/children").split()
        except OSError:
            return wrapper.pid
        if children:
            return int(children[0])
        if wrapper.poll() is not None:
            break
        time.sleep(0.1)
    return wrapper.pid


class Round:
    def __init__(self, args, info, stem=None):
        self.args, self.info, self.index = args, info, 0
        self.scenario = info["scenario"]
        self.attempts = {}  # value -> how many steps of that value this round ran: a confirmation of a measured value is repetition 2
        self.stem = stem  # the scale measure: its step files and records are of "scale", whatever load the step runs
        self.awake_start = None  # the cells awake when the step began
        self.tag = f"s{int(time.time()) % 100000}"  # one name space per run: the cells of a smaller step stay hot in a larger one

    def target(self):
        """(host, port) the generators send to: the balancer for a cluster (scale), else the node itself."""
        if self.stem:
            host, _, port = self.info["http"].removeprefix("http://").rpartition(":")
            return host, port
        return self.info["node"]["ip"], "4000"

    def gen_commands(self, value):
        a = self.args
        host, port = self.target()
        common = ["--host", host, "--port", port, "--timeout", str(a.timeout), "--tag", self.tag]
        kind = {"http-native": "native", "http-wasm": "plain", "http-wasm-jobs": "wasm"}.get(a.measure, a.worker)
        if a.measure.startswith("http"):
            procs = max(1, math.ceil(value / a.rate_per_proc))
            conns = max(16, min(1024, math.ceil(value * a.conns_per_rate / procs)))
            return [[f"{HERE}/load-gen", "http", *common, "--kind", kind, "--rate", str(value / procs), "--duration", str(a.step_s),
                     "--cells", str(a.cells), "--write-ratio", str(a.write_ratio), "--conns", str(conns), "--seed", str(i + 1),
                     *([] if a.no_warmup else ["--warmup", "--open-rate", str(a.open_rate)])] for i in range(procs)]
        if a.measure == "cells":
            return [[f"{HERE}/load-gen", "cells", *common, "--kind", kind, "--cells", str(value), "--period", str(a.cell_period),
                     "--duration", str(a.step_s), "--open-rate", str(a.open_rate), "--conns", str(a.cells_conns)]]
        return [[f"{HERE}/load-gen", "ws", *common, "--kind", kind, "--connections", str(value), "--duration", str(a.step_s),
                 "--open-rate", str(a.open_rate), "--interval", str(a.ws_interval)]]

    def run_generators(self, value, sampler):
        """Runs the generator processes of a step and returns their documents. With `step_timeout` (the config round) each runs under
        `timeout`, which kills it that many seconds after the start (10 s later for good): the step is then INVALID, `timeout`."""
        limit = getattr(self.args, "step_timeout", None)
        commands, procs, outs = self.gen_commands(value), [], []
        os.makedirs(self.args.out, exist_ok=True)
        for i, command in enumerate(commands):
            out = os.path.join(self.args.out, f".gen-{os.getpid()}-{i}.json")
            outs.append(out)
            wrapped = ["timeout", "--kill-after=10s", f"{limit:g}s"] if limit else []
            procs.append(subprocess.Popen([*wrapped, *command, "--out", out], stdout=subprocess.DEVNULL, stderr=subprocess.PIPE, text=True))
        sampler.pids = [generator_pid(p) for p in procs] if limit else [p.pid for p in procs]
        deadline = time.time() + (limit + 15 if limit else self.args.step_s + self.args.gen_grace + value / max(self.args.open_rate, 1) * (self.args.measure in ("ws", "cells")))
        cpu = [0.0] * len(procs)
        try:
            while any(p.poll() is None for p in procs):
                if time.time() > deadline:
                    raise TimeoutError("the generator did not finish in time")
                for i, p in enumerate(procs):
                    cpu[i] = max(cpu[i], process_cpu(p.pid) or 0)
                time.sleep(0.5)
            documents = []
            for p, out in zip(procs, outs):
                if limit and p.returncode in (124, 137):  # timeout's status when it killed the command (137: after --kill-after)
                    raise GeneratorTimeout(f"timeout: a generator was killed after {limit:g} s (round.step_timeout_s)")
                if p.returncode:
                    raise RuntimeError(f"load-gen failed: {p.stderr.read()[-500:]}")
                with open(out) as file:
                    documents.append(json.load(file))
            return documents
        finally:
            for p in procs:  # only our own processes, by PID
                if p.poll() is None:
                    p.terminate()
                    p.wait(10)
            for out in outs:
                if os.path.exists(out):
                    os.remove(out)

    def reset(self):
        """A new node and a new store with empty data (load-env reset); the addresses and ids change, so the info is read again. Returns seconds."""
        began = time.time()
        say("resetting the node and the store")
        load_env("reset")
        self.info.clear()
        self.info.update(json.loads(load_env("info")))
        return round(time.time() - began, 1)

    def step(self, value, phase, fresh=False):
        a = self.args
        check_deadline(a)
        self.index += 1
        self.attempts[value] = self.attempts.get(value, 0) + 1
        path = self.base(value, phase) + ".json"
        done = reuse(a, path)
        if done:
            say(f"{a.measure} {value} {UNITS[a.measure]}: {done['status']}, done before (config_hash {done['config_hash'][:8]}) -> {os.path.relpath(path, a.out)}")
            return done
        record = self.run_once(value, phase, fresh)
        first, repeats = None, getattr(a, "stall_repeats", 1)
        for _ in range(repeats):
            if not (record["stop_reason"] or "").startswith("stall:"):  # a stall fails a step by chance: once more, then the INVALID path
                break
            first = first or record
            say(f"{a.measure} {value} {UNITS[a.measure]}: {record['stop_reason']}; repeating the step")
            record = self.run_once(value, phase, fresh)
            record["first_attempt"] = {k: first[k] for k in ("status", "stop_reason", "latency_ms", "generator", "series", "store_stall")}
            record["notes"].append(f"first attempt INVALID, repeated {'once' if repeats == 1 else f'up to {repeats} times'}: {first['stop_reason']}")
        if first and getattr(a, "store_fail_on_repeat", True) and store_stalled(first) and store_stalled(record):  # the store stalls at this load every time: its limit, so this step fails
            detail = record["stop_reason"].removeprefix("stall: store stalled, ")  # the criteria that made the step fail stay in the reason
            record = {**record, "valid": True, "status": "fail", "stop_reason": f"store: stalled at this step twice ({detail}); failed on: {'; '.join(record['criteria'])}"}
        write_json(path, record)
        say(f"{a.measure} {value} {UNITS[a.measure]}: {record['status']}" + (f" ({record['stop_reason']})" if record["stop_reason"] else "")
            + f"; planned {record['planned']}, achieved {record['achieved']}, p99 {record['latency_ms']['p99']} ms"
            + (f" (hold; opening p99 {record['opening']['latency_ms']['p99']} ms, refused {record['opening']['refused']})" if record["opening"] else "")
            + f" -> {os.path.basename(path)}")
        return record

    def run_once(self, value, phase, fresh):
        """One attempt of a step: the reset of a fresh node, the quiet wait and the run; the record, not yet written."""
        a = self.args
        reset_s = self.reset() if fresh else None
        quiet, load = wait_quiet(a, self.info)
        if quiet:
            record = self.attempt(value, phase)
        else:
            record = self.record(value, phase, None, None, None, "invalid", busy_reason(load, a),
                                 valid=False, host_override={"net_load_last": load})
        record["fresh_node"], record["reset_s"] = fresh, reset_s
        return record

    def case_dir(self):
        """OUT/SCENARIO/MEASURE[/VARIANT]: the scale measure's steps are of "scale", the node count and the load are the variant."""
        measure, _, variant = self.stem.partition("-") if self.stem else (self.args.measure, "", "")
        return os.path.join(self.args.out, self.scenario, *(p for p in (measure, variant) if p))

    def base(self, value, phase):
        """The step file without its extension; the diagnostics of the step are `base.node.log` and so on."""
        repetition = self.attempts[value]
        os.makedirs(self.case_dir(), exist_ok=True)
        return os.path.join(self.case_dir(), f"step-{number_text(value)}" + (f"-{repetition}" if repetition > 1 else ""))

    def node_stop(self, value, phase, before):
        """(reason, diagnostics files) when a node died, restarted or was OOM-killed since `before` ({id: state}); else (None, []).
        With several nodes the reason says which."""
        ids = node_ids(self.info)
        for node in ids:
            after = node_state(node)
            reason = node_death(before.get(node), after)
            if reason:
                label = next((n["name"] for n in self.info.get("nodes") or [] if n["id"] == node), node)
                return (f"{label}: {reason}" if len(ids) > 1 else reason), save_node_diagnostics(self.base(value, phase), node, after, self.info["store"])
        return None, []

    def attempt(self, value, phase):
        a, info = self.args, self.info
        available = host_sample()["available_gb"]
        if available < a.min_available_gb:
            return self.record(value, phase, None, None, None, "invalid", "host memory", valid=False,
                               host_override={"available_gb_min": round(available, 1)})
        node_before = {node: node_state(node) for node in node_ids(info)}
        if any(s and (s.get("gone") or not s["running"]) for s in node_before.values()):  # nothing to measure; the nodes do not restart
            return self.record(value, phase, None, None, None, "invalid", "node not running at step start", valid=False, dead="node not running at step start")
        sampler = Sampler(info, a.sample_s, spread=bool(self.stem))
        self.awake_start = cells_awake(info)
        s3_before = s3_counters(info["store"]["ip"])
        sampler.samples.append(sampler.take())
        sampler.start()
        began = time.time()
        try:
            documents = self.run_generators(value, sampler)
        except Exception as error:
            sampler.finish()
            dead, files = self.node_stop(value, phase, node_before)
            if dead:  # the node broke under the load: a stop of the node, not of the runner
                return self.record(value, phase, None, None, None, "fail", f"{dead} (generator: {error})", began=began, diagnostics=files, dead=dead)
            return self.record(value, phase, None, None, None, "invalid", str(error) if isinstance(error, GeneratorTimeout) else f"generator: {error}", valid=False)
        samples = sampler.finish()
        s3_after = s3_counters(info["store"]["ip"])
        dead, files = self.node_stop(value, phase, node_before)
        result = self.record(value, phase, merge(documents), samples, (s3_before, s3_after), None, None, began=began, gens=documents, sampler=sampler,
                           dead=dead, diagnostics=files)
        if result["status"] == "fail" and not files:  # a failed step keeps the node's whole log too
            result["diagnostics"] = save_node_diagnostics(self.base(value, phase), info["node"]["id"], node_state(info["node"]["id"]), info["store"])
        return result

    def record(self, value, phase, merged, samples, s3, status, reason, valid=True, host_override=None, began=None, gens=None, sampler=None,
               dead=None, diagnostics=()):
        a, info = self.args, self.info
        record = {"schema": SCHEMA, "scenario": self.scenario, "measure": "scale" if self.stem else a.measure, "load": a.measure if self.stem else None,
                  "nodes": len(node_ids(info)) if self.stem else None, "distribution": None, "unit": UNITS[a.measure], "phase": phase, "step": self.index,
                  "value": value, "duration_s": a.step_s, "store_latency_ms": info["store_latency_ms"], "store_backing": info.get("store_backing", "tmpfs"), "command": a.command,
                  "http_max_connections": http_max_connections(), "limits": {"cpus": None, "memory_mb": None}, "planned": None, "achieved": None, "achieved_ratio": None,
                  "latency_ms": {"p50": None, "p95": None, "p99": None, "max": None}, "statuses": {}, "status_503": {"with_retry_after": 0, "without_retry_after": 0},
                  "cpu": {}, "memory": {}, "fds": {}, "s3": {}, "host": host_override or {}, "swap_usage": {}, "runtime": None, "series": [], "stalls": None, "admission": None, "per_node": None, "statuses_503_by_reason": {}, "refusals": None, "wake_refusals": None, "evictions": None, "store_stall": None, "store": None, "cells_awake": None, "store_rtt_ms": None, "opening": None,
                  "valid": valid, "status": status, "stop_reason": reason, "criteria": [], "started_at": began, "node_stopped": bool(dead), "notes": [], "first_attempt": None, "diagnostics": list(diagnostics),
                  "config_hash": getattr(a, "config_hash", None)}
        if merged is None:
            return record
        usage = summarize(samples, sampler_cpu(gens), self.info["memory_limit_bytes"])
        errors = {k: n for k, n in merged["statuses"].items() if k not in OK_STATUSES}
        # cells: p99 and refusals are judged on the hold (every cell written once, at --open-rate, in the opening: a cold start each);
        # the opening's own figures are in `opening`.
        judged = hold_of(merged) if merged.get("opening") else merged
        opening = merged.get("opening")
        if opening:
            opening_answers, opening_refused = refused_of(opening["statuses"])
            record["opening"] = {"planned": opening["planned"], "answers": opening_answers, "refused": opening_refused,
                                 "refused_pct": round(opening_refused * 100 / opening_answers, 1) if opening_answers else None,
                                 "latency_ms": latency_block(opening["hist"], opening["max_ms"])}
        record.update(statuses=merged["statuses"], statuses_503_by_reason=merged["reasons_503"], cpu=usage["cpu"], memory=usage["memory"], fds=usage["fds"], host=usage["host"], swap_usage=usage["swap_usage"],
                      runtime=runtime_summary(samples), series=series(samples), stalls=stall_summary(samples, sampler.stalls if sampler else []), admission=admission_summary(samples),
                      store=store_summary(samples, info.get("store_tmpfs_bytes"), info.get("store_backing", "tmpfs")),
                      latency_ms=latency_block(judged["hist"], judged["max_ms"]),
                      status_503={"with_retry_after": merged["statuses"].get("503 retry-after", 0), "without_retry_after": merged["statuses"].get("503 no retry-after", 0)},
                      limits={"cpus": usage["cpu"]["node_limit_cores"], "memory_mb": usage["memory"]["limit_mb"]},
                      generator={"sent": merged["sent"], "completed": merged["completed"], "lag_p99_ms": round(merged["lag_p99"], 1),
                                 "release_lag_p99_ms": None if merged["release_lag_p99"] is None else round(merged["release_lag_p99"], 1), "cpu_cores": usage["cpu"]["generator_cores"]},
                      cells_awake=None if dead else cells_awake(self.info), store_rtt_ms=None if dead else store_rtt(),
                      distribution=distribution(samples, [n["name"] for n in info.get("nodes") or []]))
        record["per_node"] = per_node_summary(samples)
        note = budget_note({n: p["disk_budget_bytes"] for n, p in (record["per_node"] or {}).items()})
        if note:
            record["notes"].append(note)
        record["refusals"] = refusals_503(merged["statuses"], samples)
        record["wake_refusals"] = step_wake_refusals(samples)
        record["evictions"] = eviction_evidence(self.awake_start, record["cells_awake"], record["admission"], samples)
        refusals, answers_503 = record["refusals"], refused_of(merged["statuses"])[1]
        if refusals is None and answers_503:
            record["notes"].append(f"{answers_503} 503 answers not attributed: no /runtime reading")
        elif refusals and refusals["unattributed"]:
            record["notes"].append(f"{refusals['unattributed']} of {refusals['answers_503']} 503 answers not attributed: no refusal counter of the node grew for them")
        if record["store_rtt_ms"] is None:
            record["notes"].append("store rtt not measured" + (": the node stopped" if dead else ""))
        if record["cells_awake"] is None:
            record["notes"].append("cells awake not measured")
        before, after = s3
        if before and after:
            requests = max(merged["completed"], 1)
            record["s3"] = {"trips": int(after[0] - before[0]), "bytes": int(after[1] - before[1]),
                            "trips_per_request": round((after[0] - before[0]) / requests, 2), "bytes_per_request": round((after[1] - before[1]) / requests)}
        record["planned"] = merged["planned"]
        record["achieved"] = merged.get("opened", merged["completed"])
        record["achieved_ratio"] = round(record["achieved"] / merged["planned"], 3) if merged["planned"] else None
        answers, refused = refused_of(merged["statuses"])
        if a.measure != "ws":
            record["achieved_rate"] = round(merged["completed"] / a.step_s, 1)
            record["useful_rate"] = round((answers - refused) / a.step_s, 1)  # answers that were not refused
        answers, refused = refused_of(judged["statuses"])
        criteria = [dead] if dead else []
        if answers and refused * 100 / answers > a.max_refused_pct:  # a refusal is an answer, but the capacity it measures is not served
            criteria.append(f"refused {refused * 100 / answers:.1f}% > {a.max_refused_pct:g}%")
        p99 = record["latency_ms"]["p99"]
        if a.measure != "ws" and p99 is not None and p99 > a.p99_ms:
            criteria.append(f"p99 {p99} ms > {a.p99_ms:g} ms")
        bad = {k: n for k, n in errors.items() if k != "message answered"}
        if bad and a.measure != "ws" and getattr(a, "judge_errors", True):
            criteria.append("errors: " + ", ".join(f"{k} x{n}" for k, n in sorted(bad.items())))
        if a.measure == "ws" and (merged.get("failed") or merged.get("dropped")):
            criteria.append(f"connections failed {merged.get('failed', 0)}, dropped {merged.get('dropped', 0)}")
        pct = usage["memory"]["max_pct_of_limit"]
        if a.measure in ("ws", "cells") and pct is not None and pct >= a.memory_pct:
            criteria.append(f"working set {pct}% of the scenario limit >= {a.memory_pct:g}%")
        fd_max, fd_limit = usage["fds"]["max"], usage["fds"]["limit"]
        if a.measure == "ws" and fd_max and fd_limit and fd_max >= a.fd_pct / 100 * fd_limit:
            criteria.append(f"file descriptors {fd_max} of {fd_limit}")
        record["criteria"] = list(criteria)
        full = judge_store(record["store"], a.max_store_tmpfs_pct, a.max_store_disk_pct)
        if dead:  # before any invalid judgement: a node that stopped is the result
            if full:
                record["notes"].append(full)
            return {**record, "status": "fail", "stop_reason": "; ".join(criteria)}
        contaminated = judge_host(usage["host"]["net_load_mean"], a.host_load_max)
        if contaminated:
            return {**record, "valid": False, "status": "invalid", "stop_reason": contaminated}
        saturated = judge_busy(usage["host"]["busy_cores_mean"], a.max_busy_share)
        if saturated:
            return {**record, "valid": False, "status": "invalid", "stop_reason": saturated}
        swapped = judge_swap(usage, a.max_generator_swap_mb, a.max_host_swap_growth_mb)
        if swapped:
            return {**record, "valid": False, "status": "invalid", "stop_reason": swapped}
        if any("EMFILE" in k for k in merged["statuses"]):
            return {**record, "valid": False, "status": "invalid", "stop_reason": "the generator ran out of file descriptors"}
        if full:  # before the criteria: on a full store a failure of the node is caused by the lab
            return {**record, "valid": False, "status": "invalid", "stop_reason": full}
        gen = record["generator"]  # the generator's own delay; the lag that adds a slow node's wait for a connection is not a stall
        stalled = judge_stall(gen["lag_p99_ms"] if gen["release_lag_p99_ms"] is None else gen["release_lag_p99_ms"], record["series"], a.max_lag_ms, a.max_throttle_jump_ms)
        if stalled:  # before the criteria: a stall fails a step by chance
            return {**record, "valid": False, "status": "invalid", "stop_reason": stalled}
        if criteria and a.max_store_stall_ms:  # a step that would fail: was it the store? (the log is read only then)
            found = [e for e in (store_stall(node_log_since(node, began or 0), a.max_store_stall_ms, a.store_stall_requests) for node in node_ids(info)) if e]
            record["store_stall"] = max(found, key=lambda e: e["window_requests"], default=None)
            stalled = judge_store_stall(record["store_stall"])
            if stalled:
                return {**record, "valid": False, "status": "invalid", "stop_reason": stalled}
        if criteria:
            return {**record, "status": "fail", "stop_reason": "; ".join(criteria)}
        if record["achieved_ratio"] is not None and record["achieved_ratio"] < a.delivery:
            return {**record, "valid": False, "status": "invalid", "stop_reason": f"delivery {record['achieved_ratio']:.0%} of the plan < {a.delivery:.0%}"}
        return {**record, "status": "ok"}


def sampler_cpu(documents):
    return sum(d["cpu_s"] for d in documents)


def ramp_values(args):
    """The values of the ramp, before any refinement: --steps, else --start growing by --factor up to --max."""
    values = [int(x) for x in args.steps.split(",")] if args.steps else []
    if not values:
        v = args.start
        while v <= args.max:
            values.append(round(v))
            v *= args.factor
    return values


def ws_cap_problem(highest, cap, fd_limit):
    """Why a ws ramp up to `highest` connections would measure the node's connection cap or its descriptor limit, or None."""
    if highest >= cap:
        return (f"the highest step, {highest} connections, reaches the node's http.max_connections {cap}: set node.http_max_connections of the round config above it")
    if fd_limit and cap >= fd_limit:
        return f"the node's http.max_connections {cap} is not below its descriptor limit {fd_limit}: lower node.http_max_connections of the round config"
    return None


def ramp(round_, args):
    """The ramp, the refinement and the confirmation; returns the summary."""
    values = ramp_values(args)
    steps, good, failed, stopped, node_stopped = [], None, None, None, False
    for v in values:
        r = round_.step(v, "ramp")
        steps.append(r)
        if r["status"] == "ok":
            good = v
        elif r["status"] == "fail":
            failed = v
            node_stopped = r["node_stopped"]
            break
        else:
            stopped = r
            node_stopped = r["node_stopped"]
            break
    # A stopped node stays stopped (restart: "no"): the round ends, with no bisection and no confirmation.
    if failed is not None and good is not None and not stopped and not node_stopped:
        lo, hi = good, failed
        for _ in range(args.refine):
            mid = round((lo + hi) / 2)
            if mid in (lo, hi):
                break
            r = round_.step(mid, "refine", fresh=True)  # not on the node that just collapsed: that measures the collapse, not the rate
            steps.append(r)
            if r["status"] == "ok":
                lo = mid
            elif r["status"] == "fail":
                hi = mid
                if r["node_stopped"]:
                    failed, node_stopped = mid, True
                    break
            else:
                stopped = r
                node_stopped = r["node_stopped"]
                break
        good = lo
    confirmed = None
    if good is not None and not stopped and not node_stopped and not args.no_confirm:
        r = round_.step(good, "confirm", fresh=failed is not None)
        steps.append(r)
        confirmed = r["status"] == "ok"
        stopped = r if r["status"] == "invalid" else None
    last_fail = next((s for s in reversed(steps) if s["status"] == "fail"), None)
    best = next((s for s in reversed(steps) if s["status"] == "ok" and s["value"] == good), None)
    return {"approved": good if confirmed or node_stopped else None, "confirmed": confirmed, "good": good, "distribution": best["distribution"] if best else None, "node_stopped": node_stopped or any(x["node_stopped"] for x in steps), "first_failure": failed,
            "stopped_by": last_fail["stop_reason"] if last_fail else None, "invalid": stopped["stop_reason"] if stopped else None,
            "ceiling_reached": failed is None and stopped is None and good is not None}


# ---- the swap ------------------------------------------------------------------------------------------

def swap_command(args, rate, run_dir):
    """cluster-swap-run through load-env, so that node B starts from the image of the load environment."""
    return [f"{ROOT}/scripts/load-env", "swap", "--trigger", args.trigger, "--rate", str(rate), "--workers", str(args.swap_workers),
            "--warmup", str(args.swap_warmup), "--overlap", str(args.swap_overlap), "--settle", str(args.swap_settle), "--out", run_dir]


def exit_status(measure, summary):
    """1 when the measure has no trustworthy verdict (a step INVALID), and when the swap, a single check, did not pass; else 0."""
    return 1 if summary.get("invalid") or (measure == "swap" and summary.get("status") != "ok") else 0


def swap(round_, args, info):
    rate = args.rate
    if not rate:
        found = result_file(args, round_.scenario, "http-wasm-jobs", "summary")
        rate = json.load(open(found)).get("approved") if os.path.exists(found) else None
    if not rate:
        sys.exit("swap needs swap.rate: no approved http-wasm-jobs step in " + args.out)
    check_deadline(args)
    round_.index += 1
    round_.attempts[rate] = 1
    done = reuse(args, round_.base(rate, "swap") + ".json")
    if done:
        say(f"swap at {rate} req/s: {done['status']}, done before (config_hash {done['config_hash'][:8]})")
        return {"approved": rate if done["status"] == "ok" else None, "confirmed": None, "stopped_by": done["stop_reason"],
                "invalid": None, "status": done["status"]}
    quiet, load = wait_quiet(args, info)
    if not quiet:  # the swap is judged on its own checks, but it does not start on a busy host
        reason = busy_reason(load, args)
        say(reason)
        return {"approved": None, "confirmed": None, "stopped_by": reason, "invalid": reason, "status": "invalid"}
    sampler = Sampler(info, args.sample_s)
    sampler.start()
    began = time.time()
    home = round_.case_dir()
    os.makedirs(home, exist_ok=True)
    run_dir = os.path.join(home, f"swap-{int(began)}")
    command = swap_command(args, rate, run_dir)
    process = subprocess.Popen(command, stdout=open(f"{home}/swap-{int(began)}.log", "w"), stderr=subprocess.STDOUT)
    sampler.pids = [process.pid]
    try:
        process.wait(args.swap_timeout)
    finally:
        if process.poll() is None:
            process.terminate()
            process.wait(60)
    samples = sampler.finish()
    result_path = os.path.join(run_dir, "result.json")
    result = json.load(open(result_path)) if os.path.exists(result_path) else {}
    errors = result.get("errors", {})
    other = {k: n for k, n in errors.items() if not (k.startswith("503 ") and "without" not in k) and k != "0 connection_refused"}
    phases = result.get("phases", {})
    p99_peak = max((p["p99"] for p in phases.values() if p.get("p99") is not None), default=None)
    duration = result.get("duration_s") or 1
    reasons = []
    if result.get("lost"):
        reasons.append(f"lost {result['lost']}")
    if result.get("duplicated"):
        reasons.append(f"duplicated {result['duplicated']}")
    if other:
        reasons.append(f"errors other than 503: {other}")
    if not result or (process.returncode and not reasons):
        reasons.append(f"cluster-swap-run exited {process.returncode}")
    usage = summarize(samples, 0, info["memory_limit_bytes"]) if all(s.get("node") is not None for s in samples) else {"host": {}, "cpu": {}, "memory": {}, "fds": {}, "swap_usage": {}}
    record = {"schema": SCHEMA, "scenario": round_.scenario, "measure": "swap", "unit": "req/s", "phase": "swap", "step": 1, "value": rate,
              "duration_s": duration, "store_latency_ms": info["store_latency_ms"], "store_backing": info.get("store_backing", "tmpfs"), "command": args.command, "planned": round(rate * duration),
              "achieved": result.get("sent"), "achieved_rate": round(result.get("sent", 0) / duration, 1),
              "achieved_ratio": round(result.get("sent", 0) / (rate * duration), 3), "latency_ms": {"p50": (result.get("latency_ms") or {}).get("p50"),
              "p95": None, "p99": (result.get("latency_ms") or {}).get("p99"), "p99_peak": p99_peak,
              "max": max((p["max"] for p in phases.values() if p.get("max") is not None), default=None)},
              "statuses": errors, "status_503": {"with_retry_after": sum(n for k, n in errors.items() if k.startswith("503 ") and "without" not in k),
              "without_retry_after": sum(n for k, n in errors.items() if "without Retry-After" in k)},
              "swap": {"a_exit_s": result.get("a_exit_s"), "b_rotation_s": result.get("b_rotation_s"), "last_503_s": result.get("last_503_s"),
                       "lost": result.get("lost"), "duplicated": result.get("duplicated"), "acked": result.get("acked"), "refused": result.get("refused"),
                       "unknown": result.get("unknown"), "phases": phases, "a_exit_code": result.get("a_exit_code")},
              "cpu": usage["cpu"], "memory": usage["memory"], "fds": usage["fds"], "s3": {}, "host": usage["host"], "swap_usage": usage["swap_usage"], "limits": {},
              "valid": bool(result), "status": "fail" if reasons else "ok", "stop_reason": "; ".join(reasons) or None, "started_at": began}
    record["store"] = store_summary(samples, info.get("store_tmpfs_bytes"), info.get("store_backing", "tmpfs"))
    swapped = judge_swap(usage, args.max_generator_swap_mb, args.max_host_swap_growth_mb) if usage["swap_usage"] else None
    full = judge_store(record["store"], args.max_store_tmpfs_pct, args.max_store_disk_pct)
    if swapped or full:
        record.update(valid=False, status="invalid", stop_reason=swapped or full)
    if not result:
        record["status"] = "invalid"
    record["config_hash"] = getattr(args, "config_hash", None)
    write_json(round_.base(rate, "swap") + ".json", record)
    say(f"swap at {rate} req/s: {record['status']}" + (f" ({record['stop_reason']})" if record["stop_reason"] else "")
        + f"; swap {record['swap']['a_exit_s']} s, p99 peak {p99_peak} ms")
    return {"approved": rate if record["status"] == "ok" else None, "confirmed": None, "stopped_by": record["stop_reason"],
            "invalid": record["stop_reason"] if record["status"] == "invalid" else None, "status": record["status"]}


# ---- the scale measure ---------------------------------------------------------------------------------

JOIN_SCHEMA = "atanor-load-join-1"


class LabError(Exception):
    """The lab could not be brought to the wanted number of nodes: an INVALID result of the scale measure, not of the product."""


def parse_ceilings(text):
    """{(load, nodes): ceiling} from "http-native:1=400,cells:2=9000" (the `scale.ceilings` of the config)."""
    found = {}
    for item in filter(None, (text or "").split(",")):
        key, _, value = item.partition("=")
        load, _, nodes = key.partition(":")
        found[(load, int(nodes))] = int(float(value))
    return found


def fresh_cluster(nodes):
    """A new store and `nodes` nodes behind the balancer with empty data (load-env reset) and its info; LabError when it fails."""
    os.environ["ATANOR_LOAD_NODES"] = str(nodes)
    try:
        say(f"resetting the lab: {nodes} node{'s' if nodes > 1 else ''} and the store")
        load_env("reset")
        info = json.loads(load_env("info"))
        load_env("check-swap")
    except subprocess.CalledProcessError as error:
        raise LabError(f"the lab did not start with {nodes} nodes: {(error.stderr or '').strip()[-300:]}") from error
    if len(info.get("nodes") or []) != nodes:
        raise LabError(f"the lab runs {len(info.get('nodes') or [])} nodes, not {nodes}")
    return info


def scale_config(args, load, nodes, previous, given):
    """The ramp of one load on `nodes` nodes behind the balancer; the ramp's summary with the load and the nodes. `previous`: the ceiling on
    one node fewer, where a larger configuration starts; `given`: the ceilings of an earlier round (the steps are fractions of them)."""
    a = copy.copy(args)
    a.measure, a.steps = load, args.steps if nodes == 1 else None
    for name, value in (getattr(args, "load_judging", None) or {}).get(load, {}).items():
        setattr(a, name, value)
    a.start, a.max, a.factor = args.start or RAMPS[load][0], args.max or RAMPS[load][1], args.factor
    plan = (getattr(args, "load_plans", None) or {}).get(load)
    if plan:  # a config round: the ramp of the load as the config plans it for the scenario
        a.step_s, a.refine, a.no_confirm, a.start, a.max, a.factor = plan["duration_s"], plan["refine"], not plan["confirm"], plan["start"], plan["max"], plan["factor"]
        a.steps = ",".join(str(v) for v in load_config.plan_values(plan)) if nodes == 1 and plan["kind"] != "bisect" else None
    if given:
        if (load, nodes) not in given:
            return {"load": load, "nodes": nodes, "approved": None, "good": None, "invalid": None, "skipped": f"no ceiling for {load} on {nodes} nodes in --ceilings"}
        a.steps =",".join(str(v) for v in steps_of(given[(load, nodes)], [float(f) for f in args.factors.split(",")]))
    elif nodes > 1 and previous and not a.steps:
        a.start, a.factor = previous, args.scale_factor  # the ceiling can hardly be below the one of fewer nodes
    try:
        info = fresh_cluster(nodes)
    except LabError as error:
        return {"load": load, "nodes": nodes, "approved": None, "good": None, "invalid": str(error)}
    round_ = Round(a, info, stem=f"scale-{load}-n{nodes}")
    say(f"scale: {load} on {nodes} node{'s' if nodes > 1 else ''}")
    summary = ramp(round_, a)
    return {"load": load, "nodes": nodes, **summary}


def ceiling_of(config):
    """The ceiling a configuration reached: the approved value, else (no confirmation: kind ceiling) the best step that passed."""
    return config.get("approved") if config.get("approved") is not None else config.get("good")


def node_runtimes(info, timeout=5):
    """{node name: (its /runtime, None) or (None, why it did not answer)} for every node of the cluster."""
    found = {}
    for node in info.get("nodes") or []:
        runtime, error = admin_get({"admin": f"http://{node['ip']}:4001"}, "/runtime", timeout)
        found[node["name"]] = (runtime, error) if runtime is None or isinstance(runtime, dict) else (None, "answer is not an object")
    return found


def rebalance_state(reads):
    """What each node's /runtime says under `rebalance` (the rebalance feature's state), from `node_runtimes`; None for a node that does not say."""
    return {name: runtime.get("rebalance") if runtime else None for name, (runtime, _) in reads.items()}


def moved_total(state):
    """Cells a node's rebalance has moved so far (`total.moved`, else `moved` of the plan); None when its state does not say."""
    if not isinstance(state, dict):
        return None
    total = state.get("total")
    for value in (total.get("moved") if isinstance(total, dict) else None, state.get("moved")):
        if isinstance(value, int):
            return value
    return None


class SpreadPoller(threading.Thread):
    """Reads the balancer's per-node requests, the admin API's cells per node and each node's rebalance state every `period` seconds until
    stopped; a node whose /runtime did not answer is named, with the error, in the sample's `runtime_errors`."""

    def __init__(self, info, period):
        super().__init__(daemon=True)
        self.info, self.period, self.stop_flag, self.samples = info, period, threading.Event(), []

    def run(self):
        while not self.stop_flag.is_set():
            try:
                reads = node_runtimes(self.info, 2)
                self.samples.append({"t": time.time(), **spread_sample(self.info), "rebalance": rebalance_state(reads),
                                     "wakes": {n: (r or {}).get("wakes") for n, (r, _) in reads.items()}, "wake_refused": {n: wake_refusals(r) for n, (r, _) in reads.items()},
                                     "runtime_errors": {n: error for n, (_, error) in reads.items() if error}})
            except Exception as error:  # a reading is lost, not the join
                say(f"spread sample failed: {error}")
            self.stop_flag.wait(self.period)

    def finish(self):
        self.stop_flag.set()
        self.join()


def counter_delta(window):
    """The growth of the backend's counters (requests, 5xx answers, connection and response errors, retries, redispatches) over the samples."""
    seen = [s["backend"] for s in window if s.get("backend")]
    return {k: seen[-1][k] - seen[0][k] for k in seen[0] if k in seen[-1]} if len(seen) > 1 else None


def window_series(window, t0):
    """One entry per reading of a window: its time from `t0`, the backend 5xx answers and the cells moved since the previous reading
    (null for the first and for what a reading did not say), each node's moves so far (5xx can be matched with moves) and `runtime_errors`,
    the nodes whose /runtime did not answer in that reading, with the error."""
    out, previous = [], None
    for s in window:
        five = (s.get("backend") or {}).get("hrsp_5xx")
        moved = {n: moved_total(r) for n, r in (s.get("rebalance") or {}).items()}
        known = [v for v in moved.values() if v is not None]
        before = [v for v in (previous or {}).get("moved", {}).values() if v is not None]
        out.append({"t": round(s["t"] - t0, 1), "moved": moved,
                    "new_5xx": five - previous["five"] if previous and five is not None and previous["five"] is not None else None,
                    "moved_new": sum(known) - sum(before) if previous and known and before else None,
                    "runtime_errors": s.get("runtime_errors") or {}})
        previous = {"five": five, "moved": moved}
    return out


def runtime_failures(window):
    """{node: {"readings": how many readings of the window its /runtime did not answer, "error": the last error}}; {} when all answered."""
    found = {}
    for s in window:
        for node, error in (s.get("runtime_errors") or {}).items():
            found[node] = {"readings": found.get(node, {}).get("readings", 0) + 1, "error": error}
    return found


def join_cold_starts(samples):
    """{node: cold_start(...)} over every reading of the join: a node's cold start is counted once, from its first reading, not once per window."""
    names = sorted({n for s in samples for n in s.get("wakes") or {}})
    return {n: cold_start([(s["t"], (s.get("wakes") or {}).get(n), (s.get("wake_refused") or {}).get(n)) for s in samples]) for n in names}


def window_split(window, series, colds, t0):
    """`(wake refusals, backend 5xx)` of a window, each `{cold_start, steady}` or None when not known: the refusals counted between its first and
    last reading of each node, those up to the node's cold start end being the cold ones; the 5xx of its readings up to the latest end."""
    cold = steady = 0
    known = False
    for n, c in colds.items():
        points = [(s["t"], v) for s in window if isinstance(v := (s.get("wake_refused") or {}).get(n), int)]
        if not c or len(points) < 2:
            continue
        inside = [v for t, v in points if t <= c["end_t"]]
        part = inside[-1] - points[0][1] if inside else 0
        known, cold, steady = True, cold + part, steady + points[-1][1] - points[0][1] - part
    ends = [c["end_t"] for c in colds.values() if c]
    fives = [(e["t"], e["new_5xx"]) for e in series if e["new_5xx"] is not None]
    end = round(max(ends) - t0, 1) if ends else None
    five = None if end is None or not fives else {"cold_start": sum(v for t, v in fives if t <= end), "steady": sum(v for t, v in fives if t > end)}
    return {"cold_start": cold, "steady": steady} if known else None, five


def join_windows(poller, events, args, rate):
    """One entry per window: before the first join (1 node), then from each node's start to the next one's (the last to the end of the
    load). The spread time of a join is the seconds from `node-N` start (`join_start`) to the first of `hold` consecutive samples where every
    node has its 1/N share within `tol`, for the requests of each interval and for the cells awake; null when it never held in the window.
    `cells_in_band_s` is the first reading with the cells within the tolerance, held or not; `samples` has the 5xx and the moves of each reading."""
    samples = poller.samples
    if not samples:
        return []
    bounds = [samples[0]["t"]] + [e["join_t"] for e in events] + [samples[-1]["t"] + 1e-6]
    tol, hold = args.spread_tol_pct / 100, args.spread_hold
    min_requests, min_cells = max(20, int(0.25 * rate * args.join_sample_s)), args.spread_min_cells
    colds, out = join_cold_starts(samples), []
    for i, (start, end) in enumerate(zip(bounds, bounds[1:])):
        nodes, event = i + 1, events[i - 1] if i else None
        names = [f"node-{n}" for n in range(1, nodes + 1)]
        window = [s for s in samples if start <= s["t"] < end]
        entry = {"nodes": nodes, "start_s": round(start - samples[0]["t"], 1), "end_s": round(min(end, samples[-1]["t"]) - samples[0]["t"], 1), "backend": counter_delta(window),
                 "requests_spread_s": None, "requests_spread_since_ready_s": None, "cells_spread_s": None, "cells_spread_since_ready_s": None,
                 "cells_in_band_s": None, "request_share_end": None, "cells_share_end": None, "ready_s": None if event is None else event["ready_s"],
                 "rebalance": None if event is None else event.get("rebalance"), "rebalance_observed": None if event is None else event.get("rebalance_observed"),
                 "runtime_failures": runtime_failures(window), "samples": window_series(window, samples[0]["t"])}
        entry["wake_refusals"], entry["backend_5xx"] = window_split(window, entry["samples"], colds, samples[0]["t"])
        if event is not None:
            first_in_band = spread_time([(s["t"], s["cells"]) for s in window if s.get("cells")], names, tol, 1, min_cells)
            entry["cells_in_band_s"] = None if first_in_band is None else round(first_in_band - start, 1)
            points = interval_points([(s["t"], s.get("requests")) for s in window], names)
            cells = [(s["t"], s["cells"]) for s in window if s.get("cells")]
            for key, at in (("requests", spread_time(points, names, tol, hold, min_requests)), ("cells", spread_time(cells, names, tol, hold, min_cells))):
                if at is not None:
                    entry[f"{key}_spread_s"] = round(at - start, 1)
                    entry[f"{key}_spread_since_ready_s"] = round(max(at - start - event["ready_s"], 0), 1)
            tail = points[-hold:]
            entry["request_share_end"] = shares({n: sum(c[n] for _, c in tail) for n in names}, names) if tail else None
            entry["cells_share_end"] = shares(cells[-1][1], names) if cells else None
        out.append(entry)
    return out


def join_host_load(samples, events, sample_s):
    """(mean net host load, mean busy cores) of the join, leaving out the intervals in which a node was starting: the sampler cannot count its CPU as the lab's own before it is ready."""
    excluded = [(e["join_t"], e["ready_t"] + 2 * sample_s) for e in events]
    loads = [n for a, b in zip(samples, samples[1:]) if not any(b["t"] > s and a["t"] < e for s, e in excluded) for n in [net_load(a, b)] if n]
    mean = lambda values: round(sum(values) / len(values), 2) if values else None
    return mean([n[1] for n in loads]), mean([n[0] for n in loads])


def join_base(args, scenario, rate):
    """The join's file without its extension: OUT/SCENARIO/scale/join/step-RATE."""
    return os.path.join(args.out, scenario, "scale", "join", f"step-{number_text(rate)}")


def join(args, rate, nodes_max):
    """Starts one node under the load at `rate`, then adds node 2 up to `nodes_max`, one per --join-observe-s, and measures when the load spreads."""
    check_deadline(args)
    done = reuse(args, join_base(args, args.scenario, rate) + ".json")
    if done:
        say(f"scale join at {rate} req/s: {done['status']}, done before (config_hash {done['config_hash'][:8]})")
        return done
    record = {"schema": JOIN_SCHEMA, "measure": "scale", "phase": "join", "unit": "req/s", "rate": rate, "nodes_max": nodes_max, "command": args.command, "config_hash": getattr(args, "config_hash", None),
              "tolerance_pct": args.spread_tol_pct, "hold_samples": args.spread_hold, "sample_s": args.join_sample_s, "windows": [], "wake_refusals": None, "generator": None,
              "host": {}, "valid": True, "status": "ok", "stop_reason": None, "notes": [], "diagnostics": [], "started_at": time.time()}
    try:
        info = fresh_cluster(1)
    except LabError as error:
        return {**record, "valid": False, "status": "invalid", "stop_reason": str(error)}
    record.update(scenario=info["scenario"], store_latency_ms=info["store_latency_ms"], store_backing=info.get("store_backing", "tmpfs"))
    available = host_sample()["available_gb"]
    if available < args.min_available_gb:
        return {**record, "valid": False, "status": "invalid", "stop_reason": "host memory", "host": {"available_gb_min": round(available, 1)}}
    quiet, load = wait_quiet(args, info)
    if not quiet:
        return {**record, "valid": False, "status": "invalid", "stop_reason": busy_reason(load, args), "host": {"net_load_last": load}}
    jargs = copy.copy(args)
    jargs.measure, jargs.no_warmup = "http-native", True  # the join measures the overload from the first request
    jargs.step_s = args.join_warmup_s + (nodes_max - 1) * (args.join_observe_s + args.join_node_wait_s) + args.join_observe_s
    round_ = Round(jargs, info, stem="scale-join")
    sampler, poller = Sampler(info, args.sample_s), SpreadPoller(info, args.join_sample_s)
    sampler.samples.append(sampler.take())
    sampler.start()
    poller.start()
    outcome, events, failure = {}, [], None
    base = join_base(args, info["scenario"], rate)
    os.makedirs(os.path.dirname(base), exist_ok=True)

    def window_end(nodes):
        """The /runtime of every node at the end of the window of `nodes` nodes, kept in `base.window-N.runtime.json`; the reads."""
        reads = node_runtimes(info, 3)
        write_json(f"{base}.window-{nodes}.runtime.json", {n: runtime if runtime is not None else {"error": error} for n, (runtime, error) in reads.items()})
        return reads

    def drive():
        try:
            outcome["documents"] = round_.run_generators(rate, sampler)
        except Exception as error:  # the generator broke: the join is void
            outcome["error"] = str(error)

    load_thread = threading.Thread(target=drive, daemon=True)
    load_thread.start()
    load_thread.join(args.join_warmup_s)
    for nodes in range(2, nodes_max + 1):
        if not load_thread.is_alive():
            failure = f"the load ended before node-{nodes} started"
            break
        reads = window_end(nodes - 1)  # the window of the nodes so far ends when the next one starts
        if events:
            events[-1]["rebalance"] = rebalance_state(reads)
        began = time.time()
        try:
            subprocess.run([f"{HERE}/load-env", "add-node", str(nodes)], check=True, capture_output=True, text=True, timeout=args.join_node_timeout_s)
            info.update(json.loads(load_env("info")))
        except (subprocess.SubprocessError, OSError, ValueError) as error:
            failure = f"node-{nodes} did not join: {(getattr(error, 'stderr', None) or str(error)).strip()[-300:]}"
            break
        sampler.refresh()
        events.append({"nodes": nodes, "join_t": began, "ready_t": time.time(), "ready_s": round(time.time() - began, 1)})
        load_thread.join(max(began + args.join_observe_s - time.time(), 0))
        events[-1]["rebalance_observed"] = rebalance_state(node_runtimes(info))  # mid-plan: the plan may run on
    load_thread.join()
    reads = window_end(events[-1]["nodes"] if events else 1)  # the last window ends with the load
    record["disk_budget_bytes"] = {n: ((runtime or {}).get("admission") or {}).get("disk_budget_bytes") for n, (runtime, _) in reads.items()}
    note = budget_note(record["disk_budget_bytes"])
    if note:
        record["notes"].append(note)
    if events:
        events[-1]["rebalance"] = rebalance_state(reads)
    samples = sampler.finish()
    poller.finish()
    record["diagnostics"] = save_join_diagnostics(base, info)
    documents = outcome.get("documents")
    if documents:
        merged = merge(documents)
        errors = {k: n for k, n in merged["statuses"].items() if k not in OK_STATUSES}
        record["generator"] = {"sent": merged["sent"], "completed": merged["completed"], "statuses": merged["statuses"], "errors": errors,
                               "status_503": merged["statuses"].get("503 retry-after", 0) + merged["statuses"].get("503 no retry-after", 0),
                               "statuses_503_by_reason": merged["reasons_503"]}
    record["windows"] = join_windows(poller, events, args, rate)
    record["wake_refusals"] = cold_start_summary(join_cold_starts(poller.samples), poller.samples[0]["t"]) if poller.samples else None
    mean, busy = join_host_load(samples, events, args.sample_s)
    record["host"] = {"net_load_mean": mean, "busy_cores_mean": busy, "available_gb_min": round(min(s["host"]["available_gb"] for s in samples), 1)}
    if events and all(v is None for e in events for v in (e.get("rebalance") or {}).values()):
        record["notes"].append("no node reports a rebalance state in /runtime")
    contaminated = judge_host(mean, args.host_load_max) or judge_busy(busy, args.max_busy_share)
    reason = contaminated or failure or (f"generator: {outcome['error']}" if outcome.get("error") else None)
    if reason:
        record.update(valid=False, status="invalid", stop_reason=reason)
    path = f"{base}.json"
    write_json(path, record)
    spread = [(w["nodes"], w["requests_spread_s"], w["cells_spread_s"]) for w in record["windows"] if w["nodes"] > 1]
    say(f"scale join at {rate} req/s: {record['status']}" + (f" ({reason})" if reason else "") + f"; spread (nodes, requests s, cells s): {spread} -> {os.path.basename(path)}")
    return record


def scale(args):
    """The scale measure: each load on 1 to --max-nodes nodes, the gain over one node, and the join step. The summary."""
    loads = [l for l in args.loads.split(",") if l]
    if not loads or any(l not in SCALE_LOADS for l in loads):
        sys.exit(f"--loads takes {', '.join(SCALE_LOADS)}")
    given = parse_ceilings(args.ceilings)
    fit, configs, invalids = args.max_nodes, [], []
    for load in loads:
        previous = None
        for nodes in range(1, fit + 1):
            config = scale_config(args, load, nodes, previous, given)
            configs.append(config)
            if config.get("invalid"):  # the lab, not the node, broke at this size: no larger one is measured
                invalids.append({"load": load, "nodes": nodes, "reason": config["invalid"]})
                fit = nodes - 1
                break
            previous = ceiling_of(config) or previous
        if not fit:
            break
    ceilings = {load: {c["nodes"]: ceiling_of(c) for c in configs if c["load"] == load and ceiling_of(c) is not None} for load in loads}
    gains = {load: gain(c) for load, c in ceilings.items()}
    base = next((ceilings[l][1] for l in sorted(loads, key=lambda l: l != "http-native") if l.startswith("http") and 1 in ceilings[l]), None)
    rate = args.join_rate or (round(base * args.join_factor) if base else None)
    joined = None
    if args.no_join:
        note = "join skipped (--no-join)"
    elif fit < 2:
        note = f"join skipped: {fit} node fits"
    elif not rate:
        note = "join skipped: no 1-node http ceiling and no --join-rate"
    else:
        joined, note = join(args, rate, fit), None
        if joined["status"] == "invalid":
            invalids.append({"load": "join", "nodes": fit, "reason": joined["stop_reason"]})
    advice = None
    if invalids and fit < args.max_nodes:
        advice = f"the lab did not hold {args.max_nodes} nodes: rerun with --max-nodes {fit}" if fit else "not even one node ran without an INVALID step: the host is over its limit"
    return {"approved": None, "confirmed": None, "stopped_by": None, "invalid": invalids[0]["reason"] if invalids else None, "invalids": invalids,
            "max_nodes": args.max_nodes, "largest_fit": fit, "advice": advice, "cpu_cores_host": CORES, "ceilings": ceilings, "gain": gains,
            "configs": configs, "join": None if joined is None else {k: joined[k] for k in ("status", "stop_reason", "rate", "windows", "wake_refusals", "generator")}, "join_note": note}


def judging_args(j):
    """The arguments the judging rules `j` set. A criterion that is off gets a limit nothing reaches."""
    off = float("inf")
    limit = lambda name, key, none=off: j[name][key] if j[name]["enabled"] else none
    stall = j["store_stall"]
    return {
        "p99_ms": limit("p99", "max_ms"), "max_refused_pct": limit("refused", "max_pct"), "memory_pct": limit("memory", "max_pct"), "fd_pct": limit("fds", "max_pct"),
        "delivery": limit("delivery", "min_ratio", 0.0), "judge_errors": j["errors"]["enabled"], "stall_repeats": j["stall_repeats"],
        "host_load_max": limit("host_load", "max"), "quiet_window": limit("host_load", "quiet_window_s", 0.0), "quiet_max_wait": j["host_load"]["quiet_max_wait_s"],
        "max_busy_share": limit("host_busy", "max_share"), "max_generator_swap_mb": limit("generator_swap", "max_mb"),
        "max_host_swap_growth_mb": limit("host_swap", "max_growth_mb"), "max_store_disk_pct": limit("store_fill", "max_disk_pct"),
        "max_store_tmpfs_pct": limit("store_fill", "max_tmpfs_pct"), "max_lag_ms": limit("generator_lag", "max_ms"),
        "max_throttle_jump_ms": limit("throttle", "max_jump_ms"), "max_store_stall_ms": limit("store_stall", "min_ms", 0.0),
        "store_stall_requests": stall["min_requests"], "store_fail_on_repeat": stall["fail_on_repeat"],
        "min_available_gb": limit("host_memory", "min_available_gib", 0.0),
    }


def config_defaults(config, measure, scenario, path):
    """The defaults of the arguments of `measure` in `scenario` from a round config."""
    g, w, sw = config["generator"], config["workload"], config["swap"]
    scale = load_config.scale_of(config, scenario)
    join, spread = config["scale"]["join"], config["scale"]["spread"]
    found = {
        "out": load_config.output_dir(config, ROOT), "command": f"mise run load -- --config {path}",
        "step_s": 0.0, "factor": 2.0, "start": None, "max": None, "steps": None, "refine": 0, "no_confirm": False,  # the ramp measures set their own below
        "config_hash": load_config.case_hash(config, scenario, measure), "step_timeout": config["round"]["step_timeout_s"],
        **judging_args(load_config.judging_of(config, measure)),
        # [scale.judging.LOAD]: the rules of one load of the scale, over the measure's
        "load_judging": {load: judging_args(load_config.judging_of(config, measure, load)) for load in config["scale"]["judging"]},
        "sample_s": g["sample_s"], "timeout": g["timeout_s"], "gen_grace": g["grace_s"], "rate_per_proc": g["rate_per_proc"], "conns_per_rate": g["conns_per_rate"],
        "write_ratio": w["write_ratio"], "cells": w["cells"], "no_warmup": not w["warmup"], "cell_period": w["cell_period_s"], "cells_conns": w["cells_conns"],
        "open_rate": w["open_rate"], "ws_interval": w["ws_interval_s"], "worker": w["worker"],
        "rate": sw["rate"] or None, "trigger": sw["trigger"], "swap_workers": sw["workers"], "swap_warmup": sw["warmup_s"], "swap_overlap": sw["overlap_s"],
        "swap_settle": sw["settle_s"], "swap_timeout": sw["timeout_s"],
        "max_nodes": config["scale"]["max_nodes"], "loads": ",".join(config["scale"]["loads"]), "scale_factor": config["scale"]["factor"],
        "ceilings": ",".join(f"{k}={v}" for k, v in scale["ceilings"].items()), "factors": ",".join(f"{f:g}" for f in scale["ceiling_factors"]),
        "no_join": not join["enabled"], "join_rate": join["rate"] or None, "join_factor": join["factor"], "join_warmup_s": join["warmup_s"],
        "join_observe_s": join["observe_s"], "join_node_wait_s": join["node_wait_s"], "join_node_timeout_s": join["node_timeout_s"], "join_sample_s": join["sample_s"],
        "spread_tol_pct": spread["tol_pct"], "spread_hold": spread["hold"], "spread_min_cells": spread["min_cells"],
        "load_plans": {load: load_config.plan(config, load, scenario) for load in config["scale"]["loads"]},
    }
    if measure in load_config.RAMP_MEASURES:
        p = load_config.plan(config, measure, scenario)
        found.update(step_s=p["duration_s"], factor=p["factor"], start=p["start"], max=p["max"], refine=p["refine"], no_confirm=not p["confirm"],
                     steps=",".join(str(v) for v in load_config.plan_values(p)) if p["kind"] != "bisect" else None)
    return found


def main():
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("measure", choices=list(UNITS))
    add = parser.add_argument
    add("--config", required=True, help="the round config (TOML, scripts/load_config.py): every setting of the measure comes from it")
    add("--scenario", help="the scenario to run (default: the first of round.scenarios)")
    add("--skip-done", action=argparse.BooleanOptionalAction, default=True, help="reuse a step whose file has the same config_hash and is not INVALID (default)")
    add("--deadline", type=float, help="epoch seconds at which the round stops (round.timeout_s)")
    given = parser.parse_args()
    config = load_config.load_config(given.config)
    scenario = given.scenario or config["round"]["scenarios"][0]
    args = argparse.Namespace(**{**config_defaults(config, given.measure, scenario, given.config), **vars(given), "scenario": scenario})
    # Internal plumbing: load-env and load-common read the lab's settings from the config through these.
    os.environ.update(ATANOR_LOAD_CONFIG=os.path.abspath(args.config), ATANOR_LOAD_SCENARIO=scenario, ATANOR_LOAD_MEASURE=args.measure,
                      ATANOR_LOAD_HTTP_MAX_CONNECTIONS=load_config.env_lines(config, scenario, args.measure)["ATANOR_LOAD_HTTP_MAX_CONNECTIONS"])
    try:
        execute(args)
    except RoundStop as stop:
        say(f"STOP: {stop}")
        sys.exit(3)


def execute(args):
    """Runs the measure of `args` and exits with its status."""
    os.makedirs(args.out, exist_ok=True)
    if args.measure == "scale":
        if not 1 <= args.max_nodes <= 10:
            sys.exit("--max-nodes takes 1 to 10")
        caps_sum, warning = cpu_caps(args.max_nodes, json.loads(load_env("limits")), CORES)
        if warning:
            say(f"warning: {warning}")
        scenario = args.scenario
        say(f"scale on scenario {scenario}, up to {args.max_nodes} nodes, results in {args.out}")
        summary = scale(args)
        summary.update(scenario=scenario, measure="scale", command=args.command, cpu_caps_sum=caps_sum, host_cores=CORES, cpu_caps_warning=warning,
                       config_hash=getattr(args, "config_hash", None))
        write_json(result_file(args, scenario, "scale", "summary"), summary)
        say(f"summary: {json.dumps(summary)}")
        sys.exit(exit_status("scale", summary))
    try:
        load_env("check-swap")
    except subprocess.CalledProcessError as error:
        sys.exit(f"refusing to run, a measured container may swap:\n{error.stderr.strip()}")
    info = json.loads(load_env("info"))
    if args.measure == "ws":
        reading = fds(info["node"]["id"])
        problem = ws_cap_problem(max(ramp_values(args), default=0), http_max_connections(), reading[1] if reading else None)
        if problem:
            sys.exit(f"refusing to run, {problem}")
    round_ = Round(args, info)
    say(f"{args.measure} on scenario {info['scenario']}, {args.step_s:g} s per step, results in {args.out}")
    # Idle reference before any load: the fixed cost.
    idle = Sampler(info, 1)
    first = idle.take()
    write_json(result_file(args, info["scenario"], args.measure, "baseline"),
               {"scenario": info["scenario"], "measure": args.measure, "service_mb": round((first["node"]["memory_current"] - first["node"].get("inactive_file", 0)) / 1048576, 1),
                "tmpfs_mb": round(first["node"]["shmem"] / 1048576, 1), "fds": first["fds"][0] if first["fds"] else None})
    summary = swap(round_, args, info) if args.measure == "swap" else ramp(round_, args)
    summary.update(scenario=info["scenario"], measure=args.measure, command=args.command, config_hash=getattr(args, "config_hash", None))
    write_json(result_file(args, info["scenario"], args.measure, "summary"), summary)
    say(f"summary: {json.dumps(summary)}")
    sys.exit(exit_status(args.measure, summary))


if __name__ == "__main__":
    main()
