#!/usr/bin/env bash
# Check out the Alambique release tag named in alambique.ref into cluster/.build/alambique, the named
# build context of the node image. The source is $ALAMBIQUE_SOURCE (a URL or a local checkout),
# by default the public repository. Safe to rerun.
set -euo pipefail
source "$(dirname "$0")/cluster-common"

ref=$(<"$repo/alambique.ref")
dest=$cluster_dir/.build/alambique
source_repo=${ALAMBIQUE_SOURCE:-https://github.com/This-Is-NPC/alambique.git}

if [[ ! -d $dest/.git ]]; then
  mkdir -p "$(dirname "$dest")"
  git clone --quiet --no-checkout "$source_repo" "$dest"
fi
if ! git -C "$dest" cat-file -e "refs/tags/$ref^{commit}" 2>/dev/null; then
  git -C "$dest" fetch --quiet --tags "$source_repo"
fi
commit=$(git -C "$dest" rev-parse "refs/tags/$ref^{commit}")
git -C "$dest" checkout --quiet --detach --force "$commit"
# `mix deps.get` in the image clones this directory, and a clone brings only the objects of branches.
git -C "$dest" update-ref refs/heads/context "$commit"
git -C "$dest" clean --quiet -fdx
echo "alambique $ref ($commit) in cluster/.build/alambique"
