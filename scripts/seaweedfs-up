#!/usr/bin/env bash
# Start (or reuse) the disposable SeaweedFS container and wait for S3.
set -euo pipefail

name=atanor-seaweedfs
port=18343

if [ -z "$(docker ps -q -f "name=^${name}$")" ]; then
  docker rm -f "$name" >/dev/null 2>&1 || true
  docker run -d --name "$name" \
    -p "127.0.0.1:${port}:8333" \
    -e AWS_ACCESS_KEY_ID=atanor \
    -e AWS_SECRET_ACCESS_KEY=atanor-secret \
    chrislusf/seaweedfs:4.48 \
    mini -dir=/data -ip=127.0.0.1 -ip.bind=0.0.0.0 -s3.port=8333 -admin.ui=false >/dev/null
fi

# Any HTTP answer (even 403) means the S3 gateway is listening.
for _ in $(seq 1 120); do
  if curl -s -o /dev/null "http://127.0.0.1:${port}/"; then
    echo "SeaweedFS ready on 127.0.0.1:${port}"
    exit 0
  fi
  sleep 0.5
done
echo "SeaweedFS did not become ready" >&2
docker logs --tail 30 "$name" >&2
exit 1
