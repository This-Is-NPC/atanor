#!/usr/bin/env bash
# The fast checks of the pre-push hook: warnings as errors, formatting and the README markers. The
# rest of the gate (docs links, tests, coverage) runs in CI on the pull request.
set -euo pipefail
cd "$(dirname "$0")/.."

scripts/check-compile
echo "== formatting"
scripts/format-check
echo "== README markers"
scripts/readme-check
