#!/usr/bin/env bash
# The exploration round of the load tests: for the scenario ATANOR_LOAD_SCENARIO (A), every ramp measure runs only the
# steps around the ceiling of a previous round, then the swap runs once at the http-wasm-jobs ceiling. It looks for
# defects of the product or the harness, not for numbers (docs/how-to-run-the-load-tests.md, "The exploration round").
#
#   load-explore --from DIR [options] [-- load-run options]
#
#   --from DIR        results of the previous round: the `approved` value of each SCENARIO_MEASURE.summary.json is the ceiling
#   --ceiling M=N     ceiling N for measure M, instead of the one in DIR (repeatable)
#   --measures LIST   comma separated (default: http-native,http-wasm,http-wasm-jobs,ws,cells,swap)
#   --factors LIST    steps as fractions of the ceiling (default: 0.75,1,1.25,1.5)
#   --step-s S        seconds per step (default: 75)
#   --out DIR         results directory (default: load/results/explore-STAMP-SCENARIO)
#   --dry-run         print the commands and run nothing
#
# Each measure starts on a fresh node and store (load-env reset); `mise run load:up` once before builds the images.
# A measure that exits 1 (INVALID) does not stop the others; the exit status is 1 when any did.
set -euo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")/.."

from="" out="" step_s=75 factors="0.75,1,1.25,1.5" dry=0
measures="http-native,http-wasm,http-wasm-jobs,ws,cells,swap"
declare -A ceiling=()
while (($#)); do
  case $1 in
    --from) from=$2; shift 2 ;;
    --ceiling) [[ $2 == *=* ]] || { echo "--ceiling takes MEASURE=VALUE" >&2; exit 2; }; ceiling[${2%%=*}]=${2#*=}; shift 2 ;;
    --measures) measures=$2; shift 2 ;;
    --factors) factors=$2; shift 2 ;;
    --step-s) step_s=$2; shift 2 ;;
    --out) out=$2; shift 2 ;;
    --dry-run) dry=1; shift ;;
    --) shift; break ;;
    *) echo "unknown option: $1" >&2; exit 2 ;;
  esac
done
extra=("$@")
scenario=${ATANOR_LOAD_SCENARIO:-A}
out=${out:-load/results/explore-$(date +%Y%m%d-%H%M%S)-$scenario}

# The ceiling of a measure: --ceiling, else the approved value of the previous round's summary.
ceiling_of() {
  local value=${ceiling[$1]:-}
  if [[ -z $value && -n $from ]]; then
    local file=$from/${scenario}_$1.summary.json
    [[ -f $file ]] || { echo "no summary $file and no --ceiling $1=N" >&2; return 1; }
    value=$(jq -r '.approved // empty' "$file")
  fi
  [[ $value =~ ^[0-9]+(\.[0-9]+)?$ ]] || { echo "no ceiling for $1 (approved is null in the summary: pass --ceiling $1=N)" >&2; return 1; }
  echo "$value"
}

# The steps: each factor times the ceiling, rounded, at least 1, repeated values dropped.
steps_of() {
  awk -v c="$1" -v f="$factors" 'BEGIN { n = split(f, a, ","); for (i = 1; i <= n; i++) { v = int(c * a[i] + 0.5); if (v < 1) v = 1; if (v != last) printf "%s%d", (out++ ? "," : ""), v; last = v } }'
}

run() {
  if ((dry)); then printf '%s\n' "$*"; else "$@"; fi
}

declare -A plan=()
IFS=, read -r -a list <<<"$measures"
for m in "${list[@]}"; do   # every ceiling is read before anything starts
  if [[ $m == swap ]]; then plan[swap]=$(ceiling_of http-wasm-jobs); else c=$(ceiling_of "$m"); plan[$m]=$(steps_of "$c"); fi
done

status=0
export ATANOR_LOAD_OUT=$out
for m in "${list[@]}"; do
  if [[ $m == swap ]]; then args=(--rate "${plan[swap]}"); else args=(--steps "${plan[$m]}" --step-s "$step_s" --refine 0 --no-confirm); fi
  run scripts/load-env reset
  run scripts/load-run "$m" "${args[@]}" "${extra[@]}" || { echo "load-explore: $m exited $? (a finding)" >&2; status=1; }
done
exit $status
