#!/usr/bin/env bash
# The environment of the load tests: [--config FILE [--scenario S]] up | latency | deploy | rtt | check-swap | info | add-node | swap | reset | down.
# The settings are those of the round config (ATANOR_LOAD_CONFIG, or --config FILE); docs/how-to-run-the-load-tests.md. Safe to rerun;
# touches only the project atanor-cluster and the container atanor-load-tc, by id or exact name.
#
#   up       the scenario's lab: build, start its nodes (cgroup limits, data in tmpfs) with the store (store.backing: a host
#            directory with nodatacow by default, tmpfs, or the host's disk; store.latency_ms added per trip), deploy the native, the plain WASM and the scoreboard worker
#   latency  (re)apply the added store latency, and print the round trip from the node to the store
#   deploy   deploy the native worker (cluster/load), the plain WASM worker (examples/load-plain) and the scoreboard (WASM) to the node
#   rtt      print the round trip from the node to the store in ms (median of three); empty when unknown
#   check-swap [ID...]  refuse (exit 1) a container that may swap; default: the running nodes, store and lb
#   info     print the containers (every running node too), addresses, the balancer's stats URL and cgroup pids as JSON
#   limits   print the CPU limits of one node, the store and the balancer as JSON
#   add-node N  start node-N next to the running ones and wait until it is in the balancer's rotation
#   swap [ARGS]  scripts/cluster-swap-run ARGS with the nodes' image (node B starts from the load image)
#   reset    down, then up: a new node and a new store with empty data (the next step starts from nothing)
#   down     remove the containers, network and volumes
set -euo pipefail
rest=()
while (($#)); do   # --config FILE and --scenario S, wherever they are (`mise run load:up -- --config FILE` appends them)
  case $1 in
    --config | --scenario)
      [[ $# -ge 2 ]] || { echo "$1 takes a value" >&2; exit 2; }
      if [[ $1 == --config ]]; then export ATANOR_LOAD_CONFIG=$2; else export ATANOR_LOAD_SCENARIO=$2; fi
      shift 2 ;;
    *) rest+=("$1"); shift ;;
  esac
done
set -- ${rest[@]+"${rest[@]}"}
source "$(dirname "$0")/load-common"

TC=atanor-load-tc
node_id() { running_node; }

# Median of the round trips from the node to the store's S3 port, in ms (three tries). Each try is two requests of one curl run: the
# second reuses the connection, so it costs one trip, as the node's requests do, and not the connect plus the trip. Prints nothing
# when the node or the curl fails: the round trip is then unknown, and the callers decide.
store_rtt() {
  local node=${1:-} i t times=()
  [[ -n $node ]] || return 0
  for i in 1 2 3; do
    # One -o per URL: a single -o covers only the first, and the second body would print before the time.
    t=$(docker exec "$node" curl -s -o /dev/null -o /dev/null -w '%{time_total}\n' http://store:8333/ http://store:8333/ 2>/dev/null | tail -n 1) || continue
    [[ -n $t ]] || continue
    times+=("$t")
  done
  [[ ${#times[@]} -gt 0 ]] || return 0
  printf '%s\n' "${times[@]}" | sort -n | sed -n "$(((${#times[@]} + 1) / 2))p" | awk '{printf "%.1f", $1 * 1000}'
}

# Whether the store's latency is above 0 (it may be fractional in a round config).
added_latency() { awk -v m="$LOAD_STORE_LATENCY_MS" 'BEGIN { exit !(m > 0) }'; }

# Run `tc qdisc ARGS` in the store container's network namespace. A failure (no qdisc to delete) is
# ignored: the round-trip check in latency() judges the result.
tc_store() {
  local store=$1; shift
  docker run --rm --name "$TC" --net "container:$store" --cap-add NET_ADMIN --user root --entrypoint tc \
    "$ATANOR_CLUSTER_IMAGE" qdisc "$@" >/dev/null 2>&1 || true
}

# netem on the store's side of its network: every answer it sends waits LATENCY ms, so each trip to
# the store costs that much more. The qdisc lives in the store container's network namespace;
# the node image brings tc, and a throwaway container joins that namespace with NET_ADMIN.
latency() {
  local store node before after
  store=$(cluster_container store) node=$(node_id)
  docker rm -f "$TC" >/dev/null 2>&1 || true
  # Clear the qdisc of an earlier run first, so "before" is the bare round trip and a rerun passes.
  tc_store "$store" del dev eth0 root
  before=$(store_rtt "$node")
  ! added_latency || tc_store "$store" add dev eth0 root netem delay "${LOAD_STORE_LATENCY_MS}ms"
  after=$(store_rtt "$node")
  [[ -n $before && -n $after ]] || { echo "the store round trip could not be measured (before: '${before}', after: '${after}')" >&2; exit 1; }
  echo "store round trip from the node, on a reused connection: ${before} ms -> ${after} ms (added latency ${LOAD_STORE_LATENCY_MS} ms)"
  if added_latency; then
    awk -v b="$before" -v a="$after" -v m="$LOAD_STORE_LATENCY_MS" 'BEGIN { exit !(a - b >= m * 0.8) }' \
      || { echo "the added latency is not visible" >&2; exit 1; }
  fi
}

# Running containers of the measured services: the nodes, the store and the balancer (not the one-shot bucket).
measured_ids() {
  docker ps --filter "label=$label" --filter status=running --format '{{.ID}} {{.Label "com.docker.compose.service"}}' |
    awk '$2 ~ /^(store|lb|node-[0-9]+)$/ { print $1 }'
}

# A measured container must not swap: its memory limit has to equal its memory+swap limit, and the
# cgroup's memory.swap.max (cgroup v2, when readable) has to be 0. Otherwise the memory numbers are void.
check_swap() {
  local ids=("$@") id memory swap pid max bad=0
  [[ ${#ids[@]} -gt 0 ]] || mapfile -t ids < <(measured_ids)
  [[ ${#ids[@]} -gt 0 ]] || { echo "no container to check" >&2; return 1; }
  for id in "${ids[@]}"; do
    read -r memory swap pid < <(docker inspect -f '{{.HostConfig.Memory}} {{.HostConfig.MemorySwap}} {{.State.Pid}}' "$id")
    if [[ $memory -le 0 || $swap -ne $memory ]]; then
      echo "$(container_name "$id") may swap: Memory=$memory MemorySwap=$swap (they must be equal and set); set memswap_limit equal to mem_limit" >&2; bad=1
    elif max=$(cat "/sys/fs/cgroup$(sed -n 's/^0:://p' "/proc/$pid/cgroup" 2>/dev/null)/memory.swap.max" 2>/dev/null) && [[ $max != 0 ]]; then
      echo "$(container_name "$id") may swap: memory.swap.max=$max (must be 0)" >&2; bad=1
    fi
  done
  return $bad
}

deploy() {
  # The image holds the command and the compiled module (the package holds its MD5), so only the manifest is mounted.
  atanor_cli "$(admin_token)" "$repo/cluster/load" deploy /w --ebin /opt/atanor/lib/atanor_load-0.1.0/ebin --activate
  atanor_cli "$(admin_token)" "$repo/examples/load-plain" deploy /w --activate
  "$repo/scripts/cluster-deploy-example"
}

# The running nodes as a JSON array sorted by name: id, name (node-N), address and pid of each.
nodes_json() {
  local id items=()
  for id in $(docker ps -q --filter "label=$label" --filter status=running --filter "name=^/?$CLUSTER-node-[0-9]+$"); do
    items+=("$(jq -n --arg id "$id" --arg name "$(container_name "$id")" --arg ip "$(container_ip "$id")" --arg pid "$(docker inspect -f '{{.State.Pid}}' "$id")" \
      '{id: $id, name: ($name | sub("^atanor-cluster-"; "")), ip: $ip, pid: ($pid | tonumber)}')")
  done
  printf '%s\n' "${items[@]}" | jq -s 'sort_by(.name)'
}

# add_node N: start node-N next to the running ones (the scale measure's join step) and wait until it is healthy and in
# the balancer's rotation together with the others.
add_node() {
  local n=${1:-} timeout_s=${ATANOR_CLUSTER_UP_TIMEOUT:-300} deadline up
  [[ $n =~ ^([2-9]|10)$ ]] || { echo "add-node takes the number of the node to start, 2 to 10" >&2; exit 2; }
  export ATANOR_CLUSTER_RELEASE=${ATANOR_CLUSTER_RELEASE:-$(cluster_release_id)}
  ATANOR_CLUSTER_STOP_GRACE=$(stop_grace)s || exit 1
  export ATANOR_CLUSTER_STOP_GRACE
  compose up -d --no-deps --no-recreate "node-$n"
  deadline=$((SECONDS + timeout_s))
  while :; do
    up=$(curl -s -m 2 "$(published_url 8404)/stats;csv" | awk -F, '$1 == "atanor_http" && $2 ~ /^node/ && $18 == "UP"' | wc -l || true)
    [[ $(docker inspect -f '{{.State.Health.Status}}' "$(cluster_container "node-$n")") == healthy && $up -ge $n ]] && break
    (( SECONDS < deadline )) || { echo "node-$n is not ready after ${timeout_s}s ($up servers up in the balancer)" >&2; exit 1; }
    sleep 1
  done
  echo "node-$n ready, $up nodes in rotation"
}

# Whether the C attribute is in effect on the nocow store's directory (true or false); empty for another backing.
store_nocow() { [[ $LOAD_STORE_BACKING != nocow ]] || "$repo/scripts/load-store-dir" status "$LOAD_STORE_NOCOW_DIR"; }

info() {
  local node store lb
  node=$(node_id) store=$(cluster_container store) lb=$(cluster_container lb)
  jq -n --arg scenario "$LOAD_SCENARIO" --arg latency "$LOAD_STORE_LATENCY_MS" --arg memory "$LOAD_MEMORY_BYTES" --arg storetmpfs "$store_tmpfs_bytes" --arg backing "$LOAD_STORE_BACKING" --arg nocow "$(store_nocow)" \
    --arg node "$node" --arg nodeip "$(container_ip "$node")" --arg nodepid "$(docker inspect -f '{{.State.Pid}}' "$node")" \
    --arg store "$store" --arg storeip "$(container_ip "$store")" --arg storepid "$(docker inspect -f '{{.State.Pid}}' "$store")" \
    --arg lb "$lb" --arg lbpid "$(docker inspect -f '{{.State.Pid}}' "$lb")" \
    --arg http "$(published_url 4000)" --arg admin "$(published_url 4001)" --arg stats "$(published_url 8404)/stats;csv" --argjson nodes "$(nodes_json)" \
    '{scenario: $scenario, memory_limit_bytes: ($memory | tonumber), store_latency_ms: ($latency | tonumber), store_tmpfs_bytes: ($storetmpfs | tonumber), store_backing: $backing, store_nocow: (if $nocow == "" then null else $nocow == "true" end),
      node: {id: $node, ip: $nodeip, pid: ($nodepid | tonumber)}, nodes: $nodes, stats: $stats,
      store: {id: $store, ip: $storeip, pid: ($storepid | tonumber)},
      lb: {id: $lb, pid: ($lbpid | tonumber)}, http: $http, admin: $admin}'
}

bring_up() {
  [[ $LOAD_STORE_BACKING != nocow ]] || "$repo/scripts/load-store-dir" prepare "$LOAD_STORE_NOCOW_DIR"
  # The nodes run the derived image of cluster/load: the product release with the native worker in its
  # code, and the tools of the harness target (curl, tc, iptables, ps).
  docker build -q -f "$repo/cluster/load/Dockerfile" \
    --build-arg EXTRA_PACKAGES="curl iproute2 iptables procps" \
    --build-arg RELEASE_ID="${ATANOR_CLUSTER_RELEASE:-$(cluster_release_id)}" \
    --build-arg CARGO_BUILD_JOBS="${ATANOR_CLUSTER_BUILD_JOBS:-6}" \
    -t "$ATANOR_CLUSTER_IMAGE" "$repo"
  "$repo/scripts/cluster-up"
  latency
  deploy
}

tear_down() {
  docker rm -f "$TC" >/dev/null 2>&1 || true
  "$repo/scripts/cluster-down"
  [[ $LOAD_STORE_BACKING != nocow ]] || "$repo/scripts/load-store-dir" clean "$LOAD_STORE_NOCOW_DIR"
}

case ${1:-} in
  up) bring_up ;;
  reset)
    tear_down
    bring_up ;;
  swap) shift; exec "$repo/scripts/cluster-swap-run" "$@" ;;
  latency) latency ;;
  deploy) deploy ;;
  add-node) shift; add_node "$@" ;;
  rtt) store_rtt "$(node_id)"; echo ;;
  check-swap) shift; check_swap "$@" ;;
  info) info ;;
  limits) jq -n --arg n "$LOAD_CPUS" --arg s "$ATANOR_CLUSTER_STORE_CPUS" --arg l "$ATANOR_CLUSTER_LB_CPUS" \
            '{node_cpus: ($n | tonumber), store_cpus: ($s | tonumber), lb_cpus: ($l | tonumber)}' ;;
  down) tear_down ;;
  *) sed -n '2,17p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//' >&2; exit 2 ;;
esac
