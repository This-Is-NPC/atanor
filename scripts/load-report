#!/usr/bin/env python3
"""Write the report of a load-test results directory as Markdown: load-report DIR [--out FILE]

Reads every step JSON (schema atanor-load-step-1), the baselines and the summaries that scripts/load-run
wrote in DIR and prints, per scenario and measure: the steps, the cost per unit at the approved step and
the criterion that stopped the ramp. The file (default DIR/report.md) is written atomically.
"""
import argparse
import glob
import json
import os
import re
import sys


def result_files(directory):
    """The result files of a directory: the layout of `mise run load` (`SCENARIO/MEASURE[/VARIANT]/step-VALUE[-N].json`, `summary.json`,
    `baseline.json`) and, for old results, the flat layout (`SCENARIO_MEASURE_NN-PHASE-VALUE.json`, `*.summary.json`, `*.baseline.json`, all in DIR)."""
    flat = glob.glob(os.path.join(directory, "*.json"))
    nested = [p for depth in (3, 4) for p in glob.glob(os.path.join(directory, *["*"] * (depth - 1), "*.json"))
              if re.fullmatch(r"step-[^/]*\.json|summary\.json|baseline\.json", os.path.basename(p))]
    return sorted(flat) + sorted(nested)


def load(directory):
    steps, baselines, summaries, joins = [], {}, {}, []
    for path in result_files(directory):
        with open(path) as file:
            document = json.load(file)
        name = os.path.basename(path)
        if not isinstance(document, dict):
            continue
        if document.get("schema") == "atanor-load-join-1":
            joins.append(document)
        elif name.endswith("baseline.json"):
            baselines[(document["scenario"], document["measure"])] = document
        elif name.endswith("summary.json"):
            summaries[(document["scenario"], document["measure"])] = document
        elif document.get("schema") == "atanor-load-step-1":
            steps.append(document)
    steps.sort(key=lambda s: s.get("step") or 0)  # the nested layout names files by value, not by order
    return steps, baselines, summaries, joins


def num(value, digits=1):
    return "-" if value is None else (f"{value:,.{digits}f}" if isinstance(value, float) else f"{value:,}")


def table(rows, header):
    lines = ["| " + " | ".join(header) + " |", "|" + "|".join("---" for _ in header) + "|"]
    lines += ["| " + " | ".join(str(c) for c in row) + " |" for row in rows]
    return "\n".join(lines)


def step_rows(steps):
    rows = []
    for s in steps:
        lat, mem, cpu = s["latency_ms"], s.get("memory", {}), s.get("cpu", {})
        rows.append([s["step"], s["phase"], f"{s['value']:g}", f"{num(s['planned'], 0)} / {num(s['achieved'], 0)}", num(s.get("useful_rate")), num(lat["p50"]), num(lat["p95"]), num(lat["p99"]), num(lat["max"]),
                     f"{s['status_503']['with_retry_after']} / {s['status_503']['without_retry_after']}", num(cpu.get("node_cores"), 2),
                     f"{num(mem.get('service_mb'))} / {num(mem.get('tmpfs_mb'))} / {num(mem.get('peak_mb'))}", num(mem.get("current_max_mb")),
                     num((s.get("runtime") or {}).get("oom_kill"), 0), num(s.get("fds", {}).get("count"), 0),
                     f"{num(s.get('s3', {}).get('bytes'), 0)} / {num(s.get('s3', {}).get('trips'), 0)}",
                     f"{num(s.get('host', {}).get('net_load_mean'), 1)} ({num(s.get('host', {}).get('loadavg1'), 1)})",
                     num(s.get("swap_usage", {}).get("generator_growth_mb"), 1), num(s.get("host", {}).get("swap_max_mb"), 0),
                     s["status"].upper() + ("" if s["valid"] else " (invalid)") + (f": {s['stop_reason']}" if s["stop_reason"] else "")])
    return rows


HEADER = ["step", "phase", "value", "planned / achieved", "useful rate (non-503 per s)", "p50 ms", "p95 ms", "p99 ms", "max ms", "503 with / without Retry-After", "CPU cores",
          "MB service / tmpfs / peak", "MB cgroup max (with tmpfs)", "oom kills", "fds", "S3 bytes / trips", "net host load (loadavg)", "generator swap growth MB", "host swap max MB", "status"]


def cost(measure, steps, baseline, summary):
    """The cost per unit at the approved value, as (label, value) pairs."""
    approved = summary.get("approved") if summary else None
    best = next((s for s in reversed(steps) if s["value"] == approved and s["status"] == "ok"), None)
    if not best:
        return []
    mem, cpu, fds, s3 = best["memory"], best["cpu"], best["fds"], best.get("s3", {})
    base = (baseline or {}).get("service_mb")
    out = [("approved step", f"{approved:g} {best['unit']}")]
    if measure.startswith("http"):
        rate, cores = best.get("achieved_rate"), cpu.get("node_cores")
        out += [("useful rate (non-503 answers per s)", num(best.get("useful_rate"))), ("req/s per vCPU", num(rate / cores) if cores else "-"), ("fixed MB (idle, before the load)", num(base)),
                ("marginal MB per req/s", num((mem["service_mb"] - base) / rate, 3) if base is not None and rate else "-")]
    elif measure == "ws":
        n = best["achieved"]
        out += [("fixed MB (idle)", num(base)), ("MB per connection", num((mem["service_mb"] - base) / n, 4) if base is not None and n else "-"),
                ("fd per connection", num((fds["count"] - baseline["fds"]) / n, 3) if baseline and baseline.get("fds") and fds.get("count") and n else "-")]
    elif measure == "cells":
        n = best["value"]
        out += [("fixed MB (idle)", num(base)), ("MB per hot cell", num((mem["service_mb"] - base) / n, 4) if base is not None and n else "-"),
                ("cells awake (admin API)", num(best.get("cells_awake"), 0))]
    if s3:
        out += [("S3 trips per request" if measure != "ws" else "S3 trips in the step", num(s3.get("trips_per_request") if measure != "ws" else s3.get("trips"), 2)),
                ("S3 bytes per request" if measure != "ws" else "S3 bytes in the step", num(s3.get("bytes_per_request") if measure != "ws" else s3.get("bytes"), 0))]
    out.append(("tmpfs data MB (counted apart)", num(mem.get("tmpfs_mb"))))
    return out


def admission_rows(steps, summary):
    """Admission refusals by reason and the store tmpfs or disk use at the approved step and at the first failing one."""
    approved = summary.get("approved") if summary else None
    chosen = [("approved", next((s for s in reversed(steps) if s["value"] == approved and s["status"] == "ok"), None)),
              ("first failing", next((s for s in steps if s["status"] == "fail"), None))]
    rows = []
    for label, s in chosen:
        if not s:
            continue
        a, store = s.get("admission") or {}, s.get("store") or {}
        refused = a.get("refused") or {}
        rows.append([label, f"{s['value']:g}", f"{num(refused.get('memory'), 0)} / {num(refused.get('in_flight'), 0)} / {num(refused.get('disk'), 0)}",
                     " / ".join(num(refused.get(k), 0) for k in CALL_REFUSALS),
                     "yes" if a.get("refusing_seen") else "no", num(a.get("in_flight_max"), 0), num(store.get("disk_max_pct") if store.get("backing") == "disk" else store.get("tmpfs_max_pct")), num(store.get("s3_errors"), 0),
                     " / ".join(num((s.get("refusals") or {}).get(k), 0) for k in ("answers_503", "attributed", "unattributed")), num(a.get("disk_used_max_pct_of_budget"))])
    return rows


CALL_REFUSALS = ("wake_gate", "awake_limit", "busy", "disk_full", "queue_timeout", "worker_queue", "nested_calls")
ADMISSION_HEADER = ["step", "value", "refused: memory / in-flight / disk",
                    "refused after admission: wake gate / awake limit / busy / disk full / queue timeout / worker queue / nested calls", "refusing seen", "in-flight max", "store tmpfs / disk max %", "store S3 5xx",
                    "503 answers / counted by the node / unattributed", "node disk use max % of its budget"]


def swap_section(steps):
    s = steps[-1]
    w = s["swap"]
    rows = [["planned / achieved requests", f"{num(s['planned'], 0)} / {num(s['achieved'], 0)}"], ["swap duration (drain of A to exit)", f"{num(w['a_exit_s'])} s"],
            ["B in rotation after start", f"{num(w['b_rotation_s'])} s"], ["last 503 after the drain began", f"{num(w['last_503_s'])} s"],
            ["p99 peak over the phases", f"{num(s['latency_ms']['p99_peak'])} ms"], ["max", f"{num(s['latency_ms']['max'])} ms"],
            ["acknowledged / refused / unknown", f"{w['acked']} / {w['refused']} / {w['unknown']}"], ["LOST / DUPLICATED", f"{w['lost']} / {w['duplicated']}"],
            ["answers", ", ".join(f"{k} x{n}" for k, n in s["statuses"].items()) or "none"], ["verdict", s["status"].upper() + (f": {s['stop_reason']}" if s["stop_reason"] else "")]]
    return table(rows, ["swap", "value"])


def per_node(counts, share):
    """"requests (share%)" of each node, in node order; "-" when unknown."""
    if not counts:
        return "-"
    return " / ".join(f"{num(counts[n])} ({100 * (share or {}).get(n, 0):.0f}%)" if share else num(counts[n]) for n in sorted(counts))


def scale_section(steps, summary, joins):
    """The gain per node, the spread of the load over the nodes at each ceiling, the steps of each configuration and the join step."""
    out = []
    configs = (summary or {}).get("configs") or []
    gains = (summary or {}).get("gain") or {}
    rows = []
    for c in configs:
        g = (gains.get(c["load"]) or {}).get(str(c["nodes"])) or {}
        stop = c.get("invalid") or c.get("skipped") or c.get("stopped_by") or ("ceiling reached without a failure" if c.get("ceiling_reached") else "-")
        rows.append([c["load"], c["nodes"], num(g.get("ceiling") if g else (c.get("approved") if c.get("approved") is not None else c.get("good")), 0),
                     "-" if not g else f"{g['gain']:.2f}x", f"{c['nodes']}x", "-" if not g else f"{100 * g['efficiency']:.0f}%",
                     "yes" if c.get("approved") is not None else "no", stop])
    out += ["Gain per node (the ceiling of each configuration over the ceiling of 1 node; ideal: N times; `ceiling` is the approved value, or the best step that passed when the round has no confirmation):", "",
            table(rows, ["load", "nodes", "ceiling", "gain over 1 node", "ideal", "efficiency", "confirmed", "ramp stopped by"]), ""]
    rows = []
    for c in configs:
        d = c.get("distribution")
        if d:
            rows.append([c["load"], c["nodes"], per_node(d.get("requests"), d.get("request_share")), num(d.get("request_deviation"), 2),
                         per_node(d.get("cells_awake"), d.get("cells_share")), num(d.get("cells_deviation"), 2)])
    if rows:
        out += ["Requests the balancer sent to each node, and cells awake on each, at the best step (deviation: the largest |share x N - 1|; 0 is an equal split):", "",
                table(rows, ["load", "nodes", "requests per node (share)", "deviation", "cells awake per node (share)", "deviation"]), ""]
    for load in sorted({s["load"] for s in steps}):
        for nodes in sorted({s["nodes"] for s in steps if s["load"] == load}):
            out += [f"#### {load} on {nodes} node{'s' if nodes > 1 else ''}", "", table(step_rows([s for s in steps if s["load"] == load and s["nodes"] == nodes]), HEADER), ""]
    for j in joins:
        g = j.get("generator") or {}
        rows = []
        for w in j.get("windows") or []:
            b = w.get("backend") or {}
            rows.append([w["nodes"], f"{num(w['start_s'])} - {num(w['end_s'])}", num(w.get("ready_s")), num(w.get("requests_spread_s")), num(w.get("cells_spread_s")),
                         f"{num(b.get('stot'), 0)} / {num(b.get('hrsp_5xx'), 0)} / {num(b.get('econ'), 0)} / {num(b.get('eresp'), 0)}",
                         "-" if not w.get("rebalance") else ", ".join(f"{n}: {json.dumps(v)}" for n, v in w["rebalance"].items())])
        out += [f"#### Join at {num(j.get('rate'), 0)} req/s: {j['status'].upper()}" + (f" ({j['stop_reason']})" if j.get("stop_reason") else ""), "",
                f"Spread: every node within {j.get('tolerance_pct'):g}% of 1/N for {j.get('hold_samples')} readings {j.get('sample_s'):g} s apart; seconds counted from the start of the node. `null` (-): it never held in the window, or the field is missing.", "",
                table(rows, ["nodes", "window s", "node ready after s", "requests spread s", "cells spread s", "requests / 5xx / conn errors / response errors (balancer)", "rebalance state (/runtime)"]), "",
                f"Generator: sent {num(g.get('sent'), 0)}, completed {num(g.get('completed'), 0)}, 503 {num(g.get('status_503'), 0)}, errors {', '.join(f'{k} x{n}' for k, n in (g.get('errors') or {}).items()) or 'none'}.", ""]
        out += [f"Note: {n}" for n in j.get("notes") or []] + [""] * bool(j.get("notes"))
    return out


def versions_line(steps):
    """`Node versions: node-1 atanor 0.7.0 / alambique 0.14.0, ...` from the first step that has them (`per_node` of a cluster step, else `runtime`); None when no node reported them."""
    for s in steps:
        nodes = {n: p.get("versions") for n, p in (s.get("per_node") or {}).items()} or {"node": (s.get("runtime") or {}).get("versions")}
        nodes = {n: v for n, v in nodes.items() if v}
        if nodes:
            return "Node versions: " + ", ".join(f"{n} atanor {v.get('atanor')} / alambique {v.get('alambique')}" for n, v in sorted(nodes.items())) + "."
    return None


def report(directory):
    steps, baselines, summaries, joins = load(directory)
    if not steps:
        sys.exit(f"no step results in {directory}")
    out = [f"# Load test report", "", f"Results directory: `{directory}`. Generated by `scripts/load-report` from the step JSON files.", ""]
    for scenario in sorted({s["scenario"] for s in steps}):
        limits = next((s["limits"] for s in steps if s["scenario"] == scenario and s["limits"].get("memory_mb")), {})
        latency = next(s["store_latency_ms"] for s in steps if s["scenario"] == scenario)
        backing = next(s.get("store_backing", "tmpfs") for s in steps if s["scenario"] == scenario)
        out += [f"## Scenario {scenario}", "", f"Node limits: {num(limits.get('cpus'), 1)} CPU and {num(limits.get('memory_mb'), 0)} MB (scenario memory; the cgroup limit adds the tmpfs); store {'on disk' if backing == 'disk' else 'in tmpfs'} with {latency} ms added per trip.", ""]
        for measure in ("http-native", "http-wasm", "http-wasm-jobs", "ws", "cells", "swap", "scale"):
            mine = [s for s in steps if s["scenario"] == scenario and s["measure"] == measure]
            if not mine:
                continue
            summary, baseline = summaries.get((scenario, measure)), baselines.get((scenario, measure))
            out += [f"### {measure} ({mine[0]['unit']})", ""]
            out += [line, ""] if (line := versions_line(mine)) else []
            if measure == "scale":
                out += scale_section(mine, summary, [j for j in joins if j["scenario"] == scenario])
                if summary and summary.get("advice"):
                    out += [f"**INVALID: {summary['invalid']}.** {summary['advice']}.", ""]
            elif measure == "swap":
                out += [swap_section(mine), ""]
            else:
                out += [table(step_rows(mine), HEADER), ""]
                pairs = cost(measure, mine, baseline, summary)
                out += [table(pairs, ["cost per unit", "value"]), ""] if pairs else ["No approved step: the first step already failed or was invalid.", ""]
                rows = admission_rows(mine, summary)
                out += [table(rows, ADMISSION_HEADER), ""] if rows else []
            if summary and measure != "scale":
                stop =summary.get("stopped_by") or summary.get("invalid") or ("ceiling reached without a failure" if summary.get("ceiling_reached") else "none")
                out += [f"Ramp stopped by: **{stop}**" + (f" (invalid: {summary['invalid']})" if summary.get("invalid") and summary.get("stopped_by") else "")
                        + ("; the round ended there: the node stopped" if summary.get("node_stopped") else "")
                        + (f"; confirmation repeat: {'passed' if summary.get('confirmed') else 'failed'}" if summary.get("confirmed") is not None else ""), ""]
            command = summary["command"] if summary else mine[0]["command"]
            out += ["Reproduce:", "", "```sh", command if command.startswith("mise run load -- ") else f"# run by a task that no longer exists: {command}", "```", ""]
    return "\n".join(out)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("directory")
    parser.add_argument("--out")
    args = parser.parse_args()
    text = report(args.directory)
    path = args.out or os.path.join(args.directory, "report.md")
    with open(path + ".tmp", "w") as file:
        file.write(text + "\n")
    os.replace(path + ".tmp", path)
    print(text)


main()
