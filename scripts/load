#!/usr/bin/env python3
"""The load test: run a round from a config file, here or on a remote host.

  load --config FILE [--skip-done | --no-skip-done] [--dry-run]     run the round on this machine
  load --config FILE --remote [--skip-done | --no-skip-done]        check the clone on host.ssh, then start the round there, detached
  load --config FILE --status                                       is the remote round alive, and the end of its log
  load --config FILE --fetch                                        copy the remote results directory to the local output dir

The file is validated first (scripts/load_config.py; every problem is listed and nothing starts). The round runs `round.cases` in order,
or each scenario of `round.scenarios` with its `round.measures` (a measure with `run_on` only on those scenarios). Per scenario it starts
the lab (`load:up`, with the scenario's settings; a measure with its own `[measures.M.store]` gets its own), runs each measure with
scripts/load-run on a fresh node and store, writes the report (`load:report`) and removes the lab at the end (`load:down`).

Results: OUT/SCENARIO/MEASURE[/VARIANT]/step-VALUE[-REPETITION].json and summary.json, and the resolved config as OUT/config.toml.
--skip-done (the default) does not run again a step whose file has the same config_hash and is not INVALID, and reuses its result; a case
whose steps and summary are all done is reused without starting a lab. A step file of another config refuses the round. --no-skip-done
runs every step and overwrites the files. --dry-run prints the plan and exits without starting anything.

--remote needs host.ssh and host.repo, and output.name or output.dir (the same results directory is found again by --status and --fetch).
It copies nothing: it refuses when the clone on the host has local changes or is not at the local HEAD commit, then starts the round
under `timeout host.timeout_s`, writing round.pid and round.log in the results directory on the host. Nothing remote happens without
--remote, --status or --fetch. --out DIR sets the results directory (the host side of --remote).

Exit status: 0 when every measure recorded a verdict; 1 when a measure ended INVALID or the round was stopped (round.timeout_s); 2 when
the config is refused or a remote check fails.
"""
import argparse
import glob
import json
import os
import re
import shlex
import shutil
import subprocess
import sys
import time

HERE = os.path.dirname(os.path.abspath(__file__))
ROOT = os.path.dirname(HERE)
sys.path.insert(0, HERE)
sys.dont_write_bytecode = True  # no scripts/__pycache__
import load_config  # noqa: E402

SECRETS = re.compile(r"token|secret|key|credential|password", re.IGNORECASE)


def describe(config, scenario, measure):
    """What a case runs: its kind, the values of its first pass, the most steps it can run and the seconds a step of it takes."""
    if measure in load_config.RAMP_MEASURES:
        p = load_config.plan(config, measure, scenario)
        values = load_config.plan_values(p)
        extra = p["refine"] + (1 if p["confirm"] else 0)
        return {"kind": p["kind"], "values": values, "max_steps": len(values) + extra, "extra": f"{p['refine']} refine, {'1' if p['confirm'] else 'no'} confirm" + (", store reset before each step" if p["reset_each_step"] else ""),
                "step_s": p["duration_s"], "unit": load_config.UNITS[measure]}
    if measure == "swap":
        swap = config["swap"]
        return {"kind": "swap", "values": [swap["rate"]] if swap["rate"] else [], "max_steps": 1, "extra": "", "unit": load_config.UNITS[measure],
                "step_s": swap["warmup_s"] + swap["overlap_s"] + swap["settle_s"]}
    scale = load_config.scale_of(config, scenario)
    configs = len(scale["loads"]) * scale["max_nodes"]
    return {"kind": "scale", "values": [], "max_steps": None, "extra": f"{', '.join(scale['loads'])} on 1 to {scale['max_nodes']} nodes ({configs} configurations)"
            + (", then the join" if config["scale"]["join"]["enabled"] and scale["max_nodes"] > 1 else ""), "step_s": None, "unit": load_config.UNITS[measure]}


def build_plan(config, out):
    """One entry per case, in the order they run: where it writes, its hash and its lab (`env`; `own_lab`: its store differs from its scenario's)."""
    plan = []
    for scenario, measure in load_config.case_list(config):
        env = load_config.env_lines(config, scenario, measure)
        plan.append({"scenario": scenario, "measure": measure, "name": f"{scenario}/{measure}", "dir": os.path.join(out, scenario, measure),
                     "hash": load_config.case_hash(config, scenario, measure), "env": env,
                     "own_lab": lab_of(env) != lab_of(load_config.env_lines(config, scenario)),
                     **describe(config, scenario, measure)})
    return plan


def lab_of(env):
    """The settings that make a lab: the lines of `env_lines` but the number of nodes, which the scale measure sets itself."""
    return tuple(sorted((k, v) for k, v in env.items() if k != "ATANOR_LOAD_NODES"))


def step_files(case):
    return sorted(glob.glob(os.path.join(case["dir"], "step-*.json")) + glob.glob(os.path.join(case["dir"], "*", "step-*.json")))


def read_json(path):
    try:
        with open(path) as file:
            document = json.load(file)
    except (OSError, ValueError):
        return None
    return document if isinstance(document, dict) else None


def conflicts(plan):
    """The step files of a case's directory made by another config: their `config_hash` is not the case's."""
    return [path for case in plan for path in step_files(case) if (read_json(path) or {}).get("config_hash") != case["hash"]]


def case_done(case):
    """Whether a case needs no lab: its summary and every step file carry the case's hash and none is INVALID."""
    summary = read_json(os.path.join(case["dir"], "summary.json"))
    if not summary or summary.get("config_hash") != case["hash"] or summary.get("invalid"):
        return False
    files = step_files(case)
    steps = [read_json(p) or {} for p in files]
    return bool(files) and all(s.get("config_hash") == case["hash"] and s.get("status") != "invalid" and s.get("valid") is not False for s in steps)


def show(plan, config, out, path, skip_done):
    timeout = config["round"]["timeout_s"]
    print(f"Round {path}: {len(plan)} cases, results in {out}")
    print(f"  skip-done {'on' if skip_done else 'off'}; each generator process is killed after {config['round']['step_timeout_s']:g} s (round.step_timeout_s); "
          + (f"the round stops after {timeout:g} s (round.timeout_s)" if timeout else "no round timeout"))
    if config["host"]["ssh"]:
        print("  note: host.ssh is set, but this run is local; --remote runs it on the host")
    for i, case in enumerate(plan, 1):
        values = f"{case['kind']}, values {', '.join(str(v) for v in case['values'])}" if case["values"] else case["kind"]
        steps = "" if case["max_steps"] is None else f"; at most {case['max_steps']} steps ({case['extra']})" if case["extra"] else f"; {case['max_steps']} step"
        per = "" if case["step_s"] is None else f", {case['step_s']:g} s each"
        print(f"{i:3}. {case['name']:<18} {values} {case['unit']}{steps}{per}" + ("" if case["max_steps"] is not None else f"; {case['extra']}"))
        print(f"       lab    scenario {case['scenario']}" + ("; its own load:up (store of the measure differs)" if case["own_lab"] else ""))
        print(f"       output {os.path.relpath(case['dir'], out)}/")
        print(f"       hash   {case['hash']}")


class Round:
    """The lab and the processes of a round, run through `run` (a stub in the tests)."""

    def __init__(self, config, plan, out, config_path, args):
        self.config, self.plan, self.out, self.config_path, self.args = config, plan, out, config_path, args
        timeout = config["round"]["timeout_s"]
        self.deadline = time.time() + timeout if timeout else None
        self.lab, self.dirty, self.results = None, False, []

    def env(self, case):
        # Internal plumbing: the children read the round's settings from the config, through these.
        return {**os.environ, "ATANOR_LOAD_CONFIG": self.config_path, "ATANOR_LOAD_SCENARIO": case["scenario"], "ATANOR_LOAD_MEASURE": case["measure"]}

    def run(self, argv, env):
        print("+ " + " ".join(argv), flush=True)
        return subprocess.run(argv, env=env).returncode

    def prepare(self, case):
        """The lab of the case: started for the first one, replaced when its settings change, else made fresh (reset) after a measure."""
        key = (case["scenario"], lab_of(case["env"]))
        env = self.env(case)
        if self.lab is None:
            status = self.run(["mise", "run", "load:up"], env)
        elif self.lab != key:
            self.run(["mise", "run", "load:down"], env)
            status = self.run(["mise", "run", "load:up"], env)
        elif self.dirty and case["measure"] != "scale":  # the scale measure starts its own nodes
            status = self.run([f"{HERE}/load-env", "reset"], env)
        else:
            status = 0
        self.lab, self.dirty = key, False
        return status

    def report(self):
        if self.results:
            self.run([f"{HERE}/load-report", self.out], {**os.environ})

    def execute(self):
        """Runs the cases in order; the exit status of the round."""
        previous, status = None, 0
        try:
            for case in self.plan:
                if self.deadline and time.time() > self.deadline:
                    print(f"STOP: round.timeout_s passed; {case['name']} and the cases after it did not run", flush=True)
                    return 1
                if previous and previous != case["scenario"]:
                    self.report()
                previous = case["scenario"]
                if self.args.skip_done and case_done(case):
                    print(f"{case['name']}: done before (config_hash {case['hash'][:8]}), no lab started", flush=True)
                    self.results.append((case["name"], 0))
                    continue
                if self.prepare(case):
                    print(f"STOP: the lab of {case['name']} did not start", flush=True)
                    return 1
                argv = [f"{HERE}/load-run", case["measure"], "--config", self.config_path, "--scenario", case["scenario"],
                        "--skip-done" if self.args.skip_done else "--no-skip-done"] + (["--deadline", str(self.deadline)] if self.deadline else [])
                code = self.run(argv, self.env(case))
                self.dirty = True
                self.results.append((case["name"], code))
                if code == 3:
                    print(f"STOP: round.timeout_s passed during {case['name']}; what is done stays for --skip-done", flush=True)
                    return 1
                if code not in (0, 1):
                    print(f"STOP: {case['name']} exited {code}", flush=True)
                    return 1
                status = status or code
            return status
        finally:
            self.report()
            if self.lab is not None:
                self.run(["mise", "run", "load:down"], self.env(self.plan[0]))


# ---- the remote host ---------------------------------------------------------------------------------------

def ssh(host, script):
    """(exit status, output) of `script` run on `host`."""
    done = subprocess.run(["ssh", host, script], capture_output=True, text=True)
    return done.returncode, done.stdout + done.stderr


def remote_paths(config, args):
    """(host, repo, results dir on the host) of a remote command; a string with the problem when the config cannot be used."""
    host = config["host"]
    if not host["ssh"] or not host["repo"]:
        return "host.ssh and host.repo must be set for --remote, --status and --fetch"
    if not (config["output"]["name"] or config["output"]["dir"] or args.out):
        return "set output.name (or output.dir): --status and --fetch must find the same results directory"
    given = args.out or host["results"] or config["output"]["dir"] or os.path.join(host["repo"], "load", "results", config["output"]["name"])
    return host["ssh"], host["repo"], given


def remote_start(config, args):
    found = remote_paths(config, args)
    if isinstance(found, str):
        print(found, file=sys.stderr)
        return 2
    host, repo, out = found
    config_file = args.config
    local = subprocess.run(["git", "rev-parse", "HEAD"], cwd=ROOT, capture_output=True, text=True).stdout.strip()
    pid = shlex.quote(f"{out}/round.pid")
    check = (f"cd {shlex.quote(repo)} && git fetch --quiet && git status --porcelain && echo HEAD=$(git rev-parse HEAD) "
             f"&& (test -f {shlex.quote(config_file)} && echo CONFIG=ok || echo CONFIG=missing) "
             f"&& (test -f {pid} && kill -0 $(cat {pid}) 2>/dev/null && echo RUNNING=yes || echo RUNNING=no)")
    status, text = ssh(host, check)
    lines = text.splitlines()
    commit = next((line[5:] for line in lines if line.startswith("HEAD=")), None)
    if status or commit is None:
        print(f"cannot check the clone on {host}:{repo}:\n{text.strip()}", file=sys.stderr)
        return 2
    changes = [line for line in lines if line and not re.match(r"(HEAD|CONFIG|RUNNING)=", line)]
    print(f"local commit  {local}\nremote commit {commit}")
    if changes:
        print(f"refusing: the clone on {host} has local changes:\n" + "\n".join(f"  {line}" for line in changes[:10]), file=sys.stderr)
        return 2
    if commit != local:
        print(f"refusing: the clone on {host} is not at the local commit (update it, or push and fetch the branch there)", file=sys.stderr)
        return 2
    if "CONFIG=ok" not in lines:
        print(f"refusing: {config_file} is not in the clone on {host} (the config must be committed)", file=sys.stderr)
        return 2
    if "RUNNING=yes" in lines:
        print(f"refusing: a round is already running on {host} ({out}/round.pid)", file=sys.stderr)
        return 2
    inner = (f"echo $$ > {pid}; exec timeout --kill-after=60 {config['host']['timeout_s']:g} mise run load -- --config {shlex.quote(config_file)} "
             f"--out {shlex.quote(out)} {'--skip-done' if args.skip_done else '--no-skip-done'}")
    start = (f"mkdir -p {shlex.quote(out)} && cd {shlex.quote(repo)} && "
             f"setsid nohup sh -c {shlex.quote(inner)} > {shlex.quote(out + '/round.log')} 2>&1 < /dev/null & sleep 1; echo started")
    status, text = ssh(host, start)
    if status:
        print(f"the round did not start on {host}:\n{text.strip()}", file=sys.stderr)
        return 2
    print(f"round started on {host}, results in {out}; the round is killed after {config['host']['timeout_s']:g} s (host.timeout_s)")
    print(f"  follow it:    mise run load -- --config {config_file} --status")
    print(f"  copy results: mise run load -- --config {config_file} --fetch")
    return 0


def remote_status(config, args):
    found = remote_paths(config, args)
    if isinstance(found, str):
        print(found, file=sys.stderr)
        return 2
    host, _, out = found
    pid, log = shlex.quote(f"{out}/round.pid"), shlex.quote(f"{out}/round.log")
    script = (f"if test -f {pid} && kill -0 $(cat {pid}) 2>/dev/null; then echo \"round: running (pid $(cat {pid}))\"; else echo 'round: not running'; fi; "
              f"tail -n 20 {log} 2>/dev/null")
    status, text = ssh(host, script)
    if status:
        print(f"cannot read the status on {host}:\n{text.strip()}", file=sys.stderr)
        return 2
    print("\n".join(line for line in text.splitlines() if not SECRETS.search(line)))
    return 0


def remote_fetch(config, args):
    found = remote_paths(config, args)
    if isinstance(found, str):
        print(found, file=sys.stderr)
        return 2
    host, _, remote = found
    local = load_config.output_dir(config, ROOT)
    os.makedirs(local, exist_ok=True)
    argv = ["rsync", "-a", f"{host}:{remote}/", f"{local}/"] if shutil.which("rsync") else ["scp", "-r", f"{host}:{remote}/.", f"{local}/"]
    print("+ " + " ".join(argv), flush=True)
    status = subprocess.run(argv).returncode
    print(f"results of {host}:{remote} copied to {local}" if not status else f"the copy failed ({argv[0]} exited {status})")
    return 0 if not status else 2


def main(argv=None):
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("--config", required=True, metavar="FILE", help="the round config (see load/rounds/example.toml)")
    parser.add_argument("--skip-done", action=argparse.BooleanOptionalAction, default=True,
                        help="do not run again a step whose file has the same config_hash and is not INVALID (default)")
    parser.add_argument("--dry-run", action="store_true", help="print the plan and exit without starting anything")
    where = parser.add_mutually_exclusive_group()
    where.add_argument("--remote", action="store_true", help="start the round on host.ssh, detached, after checking its clone")
    where.add_argument("--status", action="store_true", help="whether the remote round is alive, and the end of its log")
    where.add_argument("--fetch", action="store_true", help="copy the remote results directory to the local output dir")
    parser.add_argument("--out", metavar="DIR", help="results directory instead of output.dir and output.name (the host side of --remote)")
    args = parser.parse_args(argv)
    try:
        config = load_config.load_config(args.config)
    except load_config.ConfigError as error:
        print(error, file=sys.stderr)
        return 2
    for flag, action in (("remote", remote_start), ("status", remote_status), ("fetch", remote_fetch)):
        if getattr(args, flag):
            return action(config, args)
    out = os.path.abspath(args.out) if args.out else load_config.output_dir(config, ROOT)
    plan = build_plan(config, out)
    if args.skip_done and (other := conflicts(plan)):
        print(f"refusing the round: {len(other)} step files in {out} were made by another config (their config_hash differs from the case's):", file=sys.stderr)
        print("".join(f"  {os.path.relpath(p, out)}\n" for p in other[:10]) + ("  ...\n" if len(other) > 10 else "")
              + "use another output.dir or output.name, or --no-skip-done to run them again and overwrite them", file=sys.stderr)
        return 2
    if args.dry_run:
        show(plan, config, out, args.config, args.skip_done)
        return 0
    os.makedirs(out, exist_ok=True)
    config_path = os.path.join(out, "config.toml")
    resolved = {**config, "output": {**config["output"], "dir": out}}
    with open(f"{config_path}.tmp", "w") as file:
        file.write(load_config.dump_toml(resolved))
    os.replace(f"{config_path}.tmp", config_path)
    show(plan, config, out, config_path, args.skip_done)
    sys.stdout.flush()
    return Round(config, plan, out, config_path, args).execute()


if __name__ == "__main__":
    sys.exit(main())
