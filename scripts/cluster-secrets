#!/usr/bin/env bash
# Generate the cluster's secrets in cluster/secrets (git-ignored): the Erlang cookie, the admin
# and dashboard tokens (each at least 32 bytes, as a node on a non-loopback address needs) and
# the S3 keys. Existing files are kept, so a running cluster keeps its secrets. Safe to rerun.
set -euo pipefail
source "$(dirname "$0")/cluster-common"

# The directory is private to this user; the files are readable by the container users, which
# reach them through Compose's bind mounts.
mkdir -p "$secrets_dir"
chmod 700 "$secrets_dir"
for name in cookie admin_token dashboard_token s3_access_key s3_secret_key; do
  file=$secrets_dir/$name
  if [[ ! -s $file ]]; then
    case $name in s3_access_key) bytes=12 ;; *) bytes=32 ;; esac
    # No newline: the files are read verbatim. Letters and digits only: a cookie that starts with
    # '-' is read by the VM as an option.
    openssl rand -base64 "$bytes" | tr -d '\n=' | tr '+/' 'xy' >"$file"
    echo "generated cluster/secrets/$name"
  fi
  chmod 644 "$file"
done
