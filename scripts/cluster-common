# Shared helpers of the cluster scripts; sourced, not run.
# Every object the cluster creates belongs to the Compose project atanor-cluster, and nothing
# else is touched: containers are found by that project's label and acted on by id.

CLUSTER=atanor-cluster
repo=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
cluster_dir=$repo/cluster
secrets_dir=$cluster_dir/secrets
label="com.docker.compose.project=$CLUSTER"

# ATANOR_CLUSTER_TMPFS=1 adds compose.tmpfs.yml: the data of the store and the nodes lives in memory.
# Set it the same way for every command, or `compose up` recreates the containers with the other layout.
compose_files=(-f "$cluster_dir/compose.yml")
[[ ${ATANOR_CLUSTER_TMPFS:-0} != 1 ]] || compose_files+=(-f "$cluster_dir/compose.tmpfs.yml")
compose() { docker compose -p "$CLUSTER" "${compose_files[@]}" "$@"; }

# cluster_ids [SERVICE]: ids of the project's containers (all states), optionally of one service.
# The service "node" means the node services node-1 to node-10.
cluster_ids() {
  local filters=(--filter "label=$label")
  case ${1:-} in
    "") ;;
    node) filters+=(--filter "name=^/?$CLUSTER-node-[0-9]+$") ;;
    *) filters+=(--filter "label=com.docker.compose.service=$1") ;;
  esac
  docker ps -aq "${filters[@]}"
}

# cluster_container TARGET: the id of node-N (or N), store, lb or bucket.
cluster_container() {
  local target=$1 id
  [[ $target =~ ^[0-9]+$ ]] && target=node-$target
  case $target in
    node-[0-9]*) id=$(docker ps -aq --filter "label=$label" --filter "name=^/?$CLUSTER-$target$") ;;
    store | lb | bucket) id=$(docker ps -aq --filter "label=$label" --filter "label=com.docker.compose.service=$target") ;;
    *) echo "unknown target '$target': use node-N, store or lb" >&2; return 1 ;;
  esac
  [[ -n $id ]] || { echo "no container for '$target' in project $CLUSTER" >&2; return 1; }
  echo "$id" | head -n 1
}

# running_node: the id of a running node (after a swap that is node-2, not node-1).
running_node() { docker ps -q --filter "label=$label" --filter "name=^/?$CLUSTER-node-[0-9]+$" | head -n 1; }

# atanor_cli TOKEN DIR ARGS...: the `atanor` command of the node's own image, the product path
# (docker run IMAGE deploy ...), in the node's network namespace, so the admin URL is its loopback.
# DIR (or "") is mounted read-only at /w. The token reaches the command through its environment.
atanor_cli() {
  local token=$1 dir=$2 node mount=()
  shift 2
  node=$(running_node)
  [[ -n $node ]] || { echo "no running node in project $CLUSTER" >&2; return 1; }
  [[ -z $dir ]] || mount=(-v "$dir:/w:ro")
  ATANOR_TOKEN=$token docker run --rm --network "container:$node" "${mount[@]}" \
    -e ATANOR_URL=http://127.0.0.1:4001 -e ATANOR_TOKEN \
    "$(docker inspect -f '{{.Config.Image}}' "$node")" "$@"
}

container_name() { docker inspect -f '{{.Name}}' "$1" | sed 's|^/||'; }
container_ip() { docker inspect -f '{{range .NetworkSettings.Networks}}{{.IPAddress}}{{end}}' "$1"; }

# published_url PORT_IN_CONTAINER: the host URL of a published port of the load balancer.
published_url() { echo "http://$(compose port lb "$1")"; }
admin_token() { cat "$secrets_dir/admin_token"; }
# admin_get PATH [CURL OPTIONS...]: a GET on the admin API through the load balancer.
admin_get() {
  local path=$1; shift
  curl -s -m 5 -H "authorization: Bearer $(admin_token)" "$@" "$(published_url 4001)$path"
}

# cluster_release_id: the release id of the image, the commit; a dirty tree says so.
cluster_release_id() {
  local id
  id=$(git -C "$repo" rev-parse --short=12 HEAD)
  [[ -z $(git -C "$repo" status --porcelain -- lib native mix.exs mix.lock daemon Dockerfile cluster) ]] || id+=-dirty
  echo "$id"
}

# stop_grace: seconds `docker stop` waits for a node, printed. A node drains for up to stop.shutdown_ms
# (ATANOR_CLUSTER_SHUTDOWN_MS, else ATANOR_SHUTDOWN_MS, else 75000), so the default is that plus 15 s.
# ATANOR_CLUSTER_STOP_GRACE (compose syntax: 90s, 2m) overrides it; one at or below the drain is refused,
# because SIGKILL would cut the drain.
stop_grace() {
  local drain=$(( ${ATANOR_CLUSTER_SHUTDOWN_MS:-${ATANOR_SHUTDOWN_MS:-75000}} / 1000 )) grace=${ATANOR_CLUSTER_STOP_GRACE:-}
  if [[ -n $grace ]]; then
    case $grace in
      *m) grace=$(( ${grace%m} * 60 )) ;;
      *s) grace=${grace%s} ;;
    esac
    [[ $grace =~ ^[0-9]+$ ]] || { echo "ATANOR_CLUSTER_STOP_GRACE must be seconds, like 90s or 2m" >&2; return 1; }
    (( grace > drain )) || { echo "ATANOR_CLUSTER_STOP_GRACE (${grace}s) must exceed stop.shutdown_ms (${drain}s)" >&2; return 1; }
    echo "$grace"
  else
    echo $(( drain + 15 ))
  fi
}
