#!/usr/bin/env bash
# Build the scoreboard example (examples/scoreboard) into examples/scoreboard/scoreboard.wasm.
# Safe to rerun.
set -euo pipefail

root="$(cd "$(dirname "$0")/.." && pwd)"
app="$root/examples/scoreboard"

"$root/scripts/wasm-guest-deps" "$app/guest"
cd "$app/guest"
cargo build --release --quiet --target wasm32-wasip2
cp target/wasm32-wasip2/release/scoreboard_guest.wasm "$app/scoreboard.wasm"
echo "built examples/scoreboard/scoreboard.wasm ($(wc -c <"$app/scoreboard.wasm") bytes)"
