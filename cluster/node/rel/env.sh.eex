#!/bin/sh
# Node identity comes from the environment set by the image's entrypoint.
export RELEASE_DISTRIBUTION=sname
export RELEASE_NODE="atanor@${ATANOR_NODE_HOST}"
# Distribution on a fixed port range, so a firewall rule can name it; net_ticktime is how long a
# silent peer goes unnoticed (Erlang default 60 s).
export ERL_AFLAGS="-kernel inet_dist_listen_min 9100 inet_dist_listen_max 9110 net_ticktime ${ATANOR_NODE_NET_TICKTIME:-60}"
