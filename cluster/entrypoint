#!/bin/sh
# Read the secrets Compose mounted in /run/secrets into the environment of the release, then
# start it. The values never appear in the container's configuration or the process arguments.
set -eu

# The node name is the container hostname set by Compose (node-1), which a restart keeps even
# when the address changes.
ATANOR_NODE_HOST=$(hostname)
RELEASE_COOKIE=$(cat /run/secrets/cookie)
ATANOR_NODE_ADMIN_TOKEN=$(cat /run/secrets/admin_token)
ATANOR_NODE_DASHBOARD_TOKEN=$(cat /run/secrets/dashboard_token)
ATANOR_NODE_S3_ACCESS_KEY=$(cat /run/secrets/s3_access_key)
ATANOR_NODE_S3_SECRET_KEY=$(cat /run/secrets/s3_secret_key)
export ATANOR_NODE_HOST RELEASE_COOKIE ATANOR_NODE_ADMIN_TOKEN ATANOR_NODE_DASHBOARD_TOKEN \
  ATANOR_NODE_S3_ACCESS_KEY ATANOR_NODE_S3_SECRET_KEY

exec /opt/atanor/bin/atanor_node start
