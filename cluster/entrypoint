#!/bin/sh
# Start the release. The secrets Compose mounted in /run/secrets are named by the *_FILE variables of
# the container (docs/configuration.md): the values never appear in its configuration, in `docker
# inspect` or in the process arguments.
set -eu

# The node is atanor@<hostname>.cluster: the hostname set by Compose (node-1) with the network alias
# of compose.yml, which a restart keeps even when the address changes. Long names need a dot.
ATANOR_ADVERTISE=$(hostname).cluster
export ATANOR_ADVERTISE

exec /opt/atanor/bin/atanor_node start
