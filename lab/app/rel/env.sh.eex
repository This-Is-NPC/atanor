#!/bin/sh
# Node identity comes from the environment of the service (/etc/atanor-lab.env).
export RELEASE_DISTRIBUTION=name
export RELEASE_NODE="atanor@${ATANOR_LAB_IP}"
export RELEASE_COOKIE="${ATANOR_LAB_COOKIE}"
# Distribution on a fixed port range; net_ticktime is how long a silent peer goes unnoticed (Erlang default 60 s).
export ERL_AFLAGS="-kernel inet_dist_listen_min 9100 inet_dist_listen_max 9110 net_ticktime ${ATANOR_LAB_NET_TICKTIME:-60}"
