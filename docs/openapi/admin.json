{
  "openapi": "3.1.0",
  "info": {
    "title": "Atanor admin API: deploys, tokens, audit and drain",
    "version": "0.1.0",
    "description": "The endpoints of the admin API that deployers, operators and the `atanor` command use (docs/how-to-use-the-admin-api.md, design 10.2.1). The read-only cluster endpoints are described in the how-to. test/atanor/openapi_test.exs keeps this file in step with the code."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:4001",
      "description": "The admin listener (option `admin:` of `Atanor`)"
    }
  ],
  "security": [
    {
      "bearer": []
    }
  ],
  "paths": {
    "/heads": {
      "get": {
        "operationId": "listHeads",
        "summary": "List the heads of the workers the token may read",
        "description": "Needs the scope `any valid token; only workers with `worker:<name>:read` are listed`.",
        "security": [
          {
            "bearer": []
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HeadsPage"
                },
                "example": {
                  "workers": [
                    {
                      "worker": "hello",
                      "active": "2b1294c007ec8b2ff45a97a1bc75243cceffa24737338966eb728cbb15bd6f78",
                      "previous": [],
                      "revision": 1,
                      "updated_at": "2026-11-01T20:36:34.791360Z"
                    }
                  ]
                }
              }
            },
            "description": "The heads."
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "503": {
            "$ref": "#/components/responses/Unavailable"
          }
        }
      }
    },
    "/workers/{worker}/packages": {
      "post": {
        "operationId": "uploadPackage",
        "summary": "Upload a package, optionally activating it",
        "description": "Needs the scope `worker:<worker>:deploy (and worker:<worker>:activate with activate=true)`.",
        "security": [
          {
            "bearer": []
          }
        ],
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PackageUploaded"
                },
                "example": {
                  "worker": "hello",
                  "package_id": "2b1294c007ec8b2ff45a97a1bc75243cceffa24737338966eb728cbb15bd6f78",
                  "kind": "native",
                  "size": 331,
                  "head": null
                }
              }
            },
            "description": "Stored. The node recomputed the hash, parsed the package and checked the manifest."
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "409": {
            "description": "With `activate=true`: `partitions_changed` (the namespace is recorded with another number of partitions, or none; the body names `namespace`, `recorded` and `declared`), `namespace_has_data` (the namespace has cells and cannot become partitioned), `namespace_owned` (another worker owns a namespace the package declares), `namespace_conflict`, `route_taken`, `listener_taken`, `migrations_lowered` (the body's `subject` names the namespace, route or listener) or `conflict`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "partitions_changed",
                  "namespace": "events",
                  "recorded": 6,
                  "declared": 12
                }
              }
            }
          },
          "413": {
            "description": "More bytes than the node's `admin` option `max_package_bytes` (default 67108864).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TooLarge"
                },
                "example": {
                  "error": "package_too_large",
                  "max_bytes": 67108864
                }
              }
            }
          },
          "422": {
            "description": "`hash_mismatch`, `invalid_package` (not a package, an invalid manifest, a manifest over the `package` option's `max_manifest_bytes` or a component over `max_component_bytes`), `package_of_other_worker`, `module_not_loaded` (a native package names a module this node does not have), or, with `activate=true`, what the operator's policy refuses: `host_not_allowed`, `listener_not_allowed`, `listener_not_configured`, `namespace_not_allowed`, `http_not_allowed` or `module_not_allowed` (`subject` names the host, listener, namespace or module).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "hash_mismatch"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "503": {
            "$ref": "#/components/responses/Unavailable"
          }
        },
        "parameters": [
          {
            "name": "worker",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[a-z0-9_-]+$"
            }
          },
          {
            "name": "activate",
            "in": "query",
            "schema": {
              "type": "boolean",
              "default": false
            }
          },
          {
            "name": "x-package-sha256",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "description": "The SHA-256 of the body, which is also the package id."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/octet-stream": {
              "schema": {
                "type": "string",
                "format": "binary"
              }
            }
          }
        }
      }
    },
    "/workers/{worker}/activate": {
      "post": {
        "operationId": "activatePackage",
        "summary": "Make an uploaded package the active one",
        "description": "Needs the scope `worker:<worker>:activate`.",
        "security": [
          {
            "bearer": []
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Head"
                },
                "example": {
                  "worker": "hello",
                  "active": "2b1294c007ec8b2ff45a97a1bc75243cceffa24737338966eb728cbb15bd6f78",
                  "previous": [],
                  "revision": 1,
                  "updated_at": "2026-11-01T20:36:34.791360Z"
                }
              }
            },
            "description": "The new head."
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "description": "`conflict`: other changes moved the head meanwhile; try again. Also `partitions_changed`, `namespace_has_data`, `namespace_owned` and the other refusals of an upload with `activate=true`; the policy refusals are 422.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "conflict"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "503": {
            "$ref": "#/components/responses/Unavailable"
          },
          "422": {
            "description": "The operator's policy refuses the package: `host_not_allowed`, `listener_not_allowed`, `listener_not_configured`, `namespace_not_allowed`, `http_not_allowed` or `module_not_allowed`; `subject` names what was refused.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "namespace_not_allowed",
                  "subject": "ledger"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "worker",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[a-z0-9_-]+$"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ActivateRequest"
              }
            }
          }
        }
      }
    },
