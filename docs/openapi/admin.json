    "/drain": {
      "post": {
        "operationId": "drainNode",
        "summary": "Hand this node's cells back",
        "description": "Needs the scope `cluster:admin`. Runs on the node that answers. The node reports `draining` on `/health/ready` and `/health/serving`, hibernates every cell it holds and releases each lease, then answers; it stops itself afterwards unless its option `stop: [exit: false]` is set (status 1 when `errors` is not empty). The answer waits for the whole drain, which `stop.shutdown_ms` (75 000 ms by default) bounds. A second call joins the drain or returns its result.",
        "security": [
          {
            "bearer": []
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Drain"
                },
                "example": {
                  "state": "drained",
                  "node": "atanor@node-a",
                  "hibernated": 42,
                  "duration_ms": 381,
                  "errors": []
                }
              }
            },
            "description": "The drain ended."
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "503": {
            "$ref": "#/components/responses/Unavailable"
          }
        }
      },
      "get": {
        "operationId": "drainStatus",
        "summary": "Read the state of this node's drain",
        "description": "Needs the scope `cluster:admin`.",
        "security": [
          {
            "bearer": []
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Drain"
                },
                "example": {
                  "state": "idle",
                  "node": "atanor@node-a",
                  "errors": []
                }
              }
            },
            "description": "The state."
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "503": {
            "$ref": "#/components/responses/Unavailable"
          }
        }
      }
    }
  },
