#!/bin/sh
# Read before the VM boots, so it holds what the VM needs to start: the node name, the cookie and the
# distribution flags. The names are in Atanor.Daemon.boot_variables/0 and docs/configuration.md.
# The release's generated cookie (releases/COOKIE) is never used: it would differ per build.
fail() { echo "atanor: $*" >&2; exit 1; }

# `eval` starts no node and no distribution: the CLI (bin/atanor-entrypoint) runs through it, with no
# advertise address and no cookie.
if [ "${RELEASE_COMMAND:-}" = eval ]; then return 0; fi

[ -n "${ATANOR_ADVERTISE:-}" ] || fail "ATANOR_ADVERTISE is required: the host or IP other nodes reach this one at"

if [ -n "${RELEASE_COOKIE:-}" ] && [ -n "${ATANOR_COOKIE_FILE:-}" ]; then
  fail "RELEASE_COOKIE and ATANOR_COOKIE_FILE are both set: give one"
elif [ -n "${ATANOR_COOKIE_FILE:-}" ]; then
  RELEASE_COOKIE=$(cat "$ATANOR_COOKIE_FILE") || fail "cannot read ATANOR_COOKIE_FILE $ATANOR_COOKIE_FILE"
  export RELEASE_COOKIE
fi
[ -n "${RELEASE_COOKIE:-}" ] || fail "no cookie: set RELEASE_COOKIE or ATANOR_COOKIE_FILE"
# The VM would read a cookie that starts with a dash as an option, and fall back to a random one.
case $RELEASE_COOKIE in -*) fail "the cookie must not start with '-'" ;; esac

export RELEASE_DISTRIBUTION=name
export RELEASE_NODE="atanor@${ATANOR_ADVERTISE}"
# Distribution on a fixed port range, so a firewall rule can name it; net_ticktime is how long a
# silent peer goes unnoticed (Erlang default 60 s).
export ERL_AFLAGS="-kernel inet_dist_listen_min 9100 inet_dist_listen_max 9110 net_ticktime ${ATANOR_NET_TICKTIME:-60}"
