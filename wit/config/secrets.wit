package atanor:config@0.1.0;

/// Secrets named in the manifest's `bindings.secrets`, with values supplied
/// by the operator.
interface secrets {
  variant error {
    /// The name is not in the manifest.
    not-granted(string),
    /// The operator supplied no value.
    missing(string),
  }

  get: func(name: string) -> result<string, error>;
}
